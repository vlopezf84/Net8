...
@"...\{4:\r?\n?([0-9A-Za-z \'\(\)\{\}\+\,\-\.\/\:\?\r\n]*):20:(?<trade_id>[0-9]{1,20})\r?\n?([...]*):30T:(?<value_date>...)
