        /// <summary>
        /// Ejecuta la operacion convierteTexto_a_Multivalor_SinCortar_Local.
        /// </summary>
        public string convierteTexto_a_Multivalor_SinCortar_Local(
            string texto,
            int MW_SeparadorMultivalorLength,
            ref int TotalLineas,
            bool Prefix = false)
        {
            string strCadena = string.Empty;
            List<string> retorno = new List<string>();
            string palabra;
            string contenedor;

            texto = texto.Trim();

            while (texto.StartsWith("-", StringComparison.Ordinal))
            {
                texto = texto.Substring(1);
                texto = texto.Trim();
            }

            if (texto.Length == 0)
                return strCadena;

            if (texto.Length <= MW_SeparadorMultivalorLength)
            {
                strCadena = Prefix ? "//" + texto : texto;
                TotalLineas = 1;
                return strCadena;
            }

            contenedor = string.Empty;
            bool blnAux = false;
            int intCont = 0;
            string[] arreglo = texto.Split(' ');

            foreach (string p in arreglo)
            {
                palabra = p;
                string palabraTemp = string.Empty;

                if (!blnAux)
                {
                    if (arreglo.Length > intCont + 1)
                    {
                        if (arreglo[intCont + 1].ToString().StartsWith("-", StringComparison.Ordinal))
                        {
                            palabraTemp = arreglo[intCont];
                            blnAux = false;
                        }
                        else
                            palabraTemp = arreglo[intCont];
                    }
                    else
                        palabraTemp = arreglo[intCont];

                    if (palabraTemp.Length >= MW_SeparadorMultivalorLength)
                    {
                        if (contenedor.Length > 0)
                        {
                            retorno.Add(contenedor);
                            contenedor = string.Empty;
                        }

                        do
                        {
                            string trozo = palabraTemp.Substring(0, MW_SeparadorMultivalorLength);
                            retorno.Add(trozo);
                            palabraTemp = palabraTemp.Remove(0, MW_SeparadorMultivalorLength);
                        }
                        while (palabraTemp.Length >= MW_SeparadorMultivalorLength);
                    }

                    if (palabraTemp.Length > 0)
                    {
                        if (contenedor.Length + palabraTemp.Length + 1 > MW_SeparadorMultivalorLength)
                        {
                            retorno.Add(contenedor);
                            contenedor = palabraTemp;
                        }
                        else
                        {
                            if (contenedor == string.Empty)
                                contenedor = palabraTemp;
                            else
                                contenedor = contenedor + " " + palabraTemp;
                        }
                    }
                }
                else
                    blnAux = false;

                intCont++;
            }

            if (contenedor.Length > 0)
                retorno.Add(contenedor);

            foreach (string elemento in retorno)
            {
                if (Prefix)
                    strCadena += "//" + elemento + "|";
                else
                    strCadena += elemento + "|";
            }

            strCadena = strCadena.Substring(0, strCadena.Length - 1);
            TotalLineas = retorno.Count;
            return strCadena;
        }

        /// <summary>
        /// Ejecuta la operacion regresaNLineasDeMultivalor.
        /// </summary>
        public string regresaNLineasDeMultivalor(string texto, int LineasDeRegreso, ref string LineasSobrantes)
        {
            string strCadena = string.Empty;
            string strCadenaSobra = string.Empty;
            string[] sMultiValues = texto.Split('|');

            for (int i = 0; i <= sMultiValues.Length - 1; i++)
            {
                if (i <= LineasDeRegreso - 1)
                    strCadena += sMultiValues[i] + "|";
                else
                    strCadenaSobra += sMultiValues[i] + "|";
            }

            strCadena = strCadena.Substring(0, strCadena.Length - 1);
            LineasSobrantes = strCadenaSobra != string.Empty
                ? strCadenaSobra.Substring(0, strCadenaSobra.Length - 1)
                : string.Empty;

            return strCadena;
        }

