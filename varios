        /// <summary>
        /// Ejecuta la operacion CleanText.
        /// </summary>
        public string CleanText(string texto)
        {
            Dictionary<char, char> replacements = new Dictionary<char, char>
            {
                { '!', ' ' },
                { (char)34, '|' },
                { '#', ' ' },
                { '%', ' ' },
                { '&', ' ' },
                { '(', ' ' },
                { ')', ' ' },
                { '*', ' ' },
                { ',', '?' },
                { '/', '^' },
                { ':', ' ' },
                { ';', ' ' },
                { '@', ' ' },
                { '[', ' ' },
                { '\\', ' ' },
                { ']', ' ' },
                { '_', ' ' },
                { '{', ' ' },
                { '}', ' ' },
                { '~', ' ' },
                { '<', ' ' },
                { '=', ' ' },
                { '>', ' ' },
                { '¬', ' ' },
                { '°', ' ' },
                { '`', ' ' },
                { 'Á', 'A' },
                { 'á', 'A' },
                { 'É', 'E' },
                { 'é', 'E' },
                { 'Í', 'I' },
                { 'í', 'I' },
                { 'Ñ', ' ' },
                { 'Ó', 'O' },
                { 'ó', 'O' },
                { 'Ú', 'U' },
                { 'ú', 'U' },
                { 'Ü', 'U' }
            };

            string pattern = string.Join("|", replacements.Keys.Select(c => Regex.Escape(c.ToString())));
            return Regex.Replace(texto, pattern, m => replacements[m.Value[0]].ToString());
        }

        /// <summary>
        /// Ejecuta la operacion NormalizarPrimerCaracter.
        /// </summary>
        private string NormalizarPrimerCaracter(string valor)
        {
            if (string.IsNullOrEmpty(valor))
                return valor;

            if (valor.Length == 1)
                return valor == "-" ? valor : " ";

            if (valor[0] == '-')
                return " " + valor.Substring(1);

            return valor;
        }

        /// <summary>
        /// Ejecuta la operacion LimitaCaracteres.
        /// </summary>
        private string LimitaCaracteres(string valor, int longitud)
        {
            string cadena65Caracteres = string.Empty;

            if (valor.Length > longitud)
                cadena65Caracteres = valor.Substring(0, longitud);
            else if (valor.Length <= longitud)
                cadena65Caracteres = valor;

            return cadena65Caracteres;
        }

        /// <summary>
        /// Ejecuta la operacion extraeNodosXMLIgnorandoConfiguracionXMLPreserve.
        /// </summary>
        private List<string> extraeNodosXMLIgnorandoConfiguracionXMLPreserve(string variablesXML, string nombre)
        {
            List<string> result = new List<string>();
            XmlDocument loXML_Doc;
            string error;

            if (!XmlHelper.TryParseXmlSeguro(variablesXML, out loXML_Doc, out error))
            {
                Config.EscribirLog("ERROR|FXI.extraeNodosXMLIgnorandoConfiguracionXMLPreserve|XML invÃ¡lido: " + error);
                return result;
            }

            try
            {
                if (loXML_Doc.InnerXml != string.Empty)
                {
                    XmlNodeList loXML_Nodes = loXML_Doc.GetElementsByTagName(nombre);
                    if (loXML_Nodes.Count > 0)
                    {
                        foreach (XmlNode loXML_Node in loXML_Nodes[0].ChildNodes)
                        {
                            if (loXML_Node.NodeType != XmlNodeType.SignificantWhitespace)
                                result.Add(loXML_Node.InnerText);
                        }
                    }
                }

                return result;
            }
            catch (Exception lexErrorXML)
            {
                throw new Exception("Error al obtener  nodos del XML:" + lexErrorXML.Message);
            }
        }

        /// <summary>
        /// Ejecuta la operacion FormatearCadena35.
        /// </summary>
        public string FormatearCadena35(string input, int maxLineas)
        {
            if (string.IsNullOrEmpty(input))
                return input;

            if (maxLineas <= 0)
                return string.Empty;

            List<string> resultado = new List<string>();
            int index = 0;
            bool esPrimeraLinea = true;

            while (index < input.Length && resultado.Count < maxLineas)
            {
                int longitud;

                if (esPrimeraLinea)
                    longitud = Math.Min(35, input.Length - index);
                else
                    longitud = Math.Min(33, input.Length - index);

                string bloque = input.Substring(index, longitud);

                if (!esPrimeraLinea)
                    bloque = "//" + bloque;

                resultado.Add(bloque);
                esPrimeraLinea = false;
                index += longitud;
            }

            return string.Join("|", resultado);
        }

