    /// </summary>
    public class SPEIComun
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly ISpeiComunTomiDao _speiComunTomiDao;
        private readonly Func<string, ISpeiComunSpeiDao> _speiComunSpeiDao;

        /// <summary>
        /// Inicializa una nueva instancia de la clase SPEIComun.
        /// </summary>
        public SPEIComun(
            ConfiguracionServicio configuracion,
            ISpeiComunTomiDao speiComunTomiDao,
            Func<string, ISpeiComunSpeiDao> speiComunSpeiDao)
        {
            _configuracion = configuracion;
            _speiComunTomiDao = speiComunTomiDao;
            _speiComunSpeiDao = speiComunSpeiDao;
        }

        /// <summary>
        /// Ejecuta la operacion ObtenerSpeiDao.
        /// </summary>
        private ISpeiComunSpeiDao ObtenerSpeiDao()
        {
            return _speiComunSpeiDao(_configuracion.ParametrosSistema["SPEI_SERVIDOR_PRINCIPAL"]);
        }

        /// <summary>
        /// Ejecuta la operacion SPEI_REGISTRO.
        /// </summary>
        public async Task<bool> SPEI_REGISTRO(
            string tabla,
            string folio,
            string folioT24,
            bool flgNomina = false,
            short tipoPago = 1,
            string referencia_emisor = "",
            string numeric_reference = "")
        {
            object[] laValoresFormato = new object[16];
            string[] laLlaveValor;
            bool lbPorIntentar;
            int liIdx;
            string lsCadena_Regreso;
            string lsClave_SPEI;
            string lsFechaOper_SPEI;
            string lsFolio_SPEI;
            string lsDebit_their_ref;
            decimal tmpNumeric;

            try
            {
                lbPorIntentar = false;
                lsCadena_Regreso = string.Empty;
                lsDebit_their_ref = string.Empty;

                SpeiOperacionRegistroDto operacion = await _speiComunTomiDao.ObtenerOperacionRegistro(tabla, folio);

                if (operacion != null)
                {
                    lbPorIntentar = true;

                    laValoresFormato[0] = DameTexto(operacion.nf_banco_benef);
                    laLlaveValor = Convert.ToString(laValoresFormato[0]).Split('-');
                    laValoresFormato[1] = laLlaveValor[0].Trim();
                    laValoresFormato[2] = operacion.importe;
                    laValoresFormato[3] = flgNomina ? folioT24 + "-" + folio : folioT24;
