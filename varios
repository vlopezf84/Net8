using Aplicacion.Enums;
using Aplicacion.Interfaces.Operaciones.ENT_TEF;
using Aplicacion.Modelos;
using AplicacionT24.DTOs.Operaciones.ENT_TEF;
using MUFG_T24.Comunes;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Modelos;
using MUFG_T24.Repositorios;
using System;
using System.Threading.Tasks;
using static MUFG_T24.Comunes.Comunes;

namespace Aplicacion.Servicios.Operaciones
{
    /// <summary>
    /// Representa la funcionalidad de ENT_TEF.
    /// </summary>
    public class ENT_TEF
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IENTTEFTomiDao _entTefTomiDao;
        private readonly IENTTEFVistasT24Dao _entTefVistasT24Dao;
        private readonly ConexionT24Mw _vwT24;

        private MW_Tipo_operacion mwTipoOperacion;

        private const string tipoOperacion = "ENT_TEF";
        private string folioUnico = "";

        /// <summary>
        /// Constructor.
        /// </summary>
        public ENT_TEF(
            ConfiguracionServicio configuracion,
            IControlServicio controlServicio,
            IENTTEFTomiDao entTefTomiDao,
            IENTTEFVistasT24Dao entTefVistasT24Dao,
            ConexionT24Mw vwT24)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _entTefTomiDao = entTefTomiDao;
            _entTefVistasT24Dao = entTefVistasT24Dao;
            _vwT24 = vwT24;
        }

        /// <summary>
        /// Procesa la operación ENT_TEF.
        /// </summary>
        public async Task<bool> ProcesaOperacion(string folio)
        {
            decimal importeTomi = 0m;
            string fechaEjecucion = _configuracion.FechaSistema;
            string moneda = _vwT24.MonedaDefaultMN;
            string cuentaDebito = "";
            string cuentaCredito = "";
            string tipo = "";
            string folioT24 = "";
            bool esIgualEnT24 = false;

            // Verifica la última operación no realizada...
            _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

            if (string.Equals(_configuracion.AliasProceso, "", StringComparison.Ordinal))
                return false;

            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia proceso folio={folio}.");

            // Obtiene los datos de la familia de la operación...
            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacion);

            // Obtiene datos de la operación...
            EntTefOperacionDto datosOperacion = await _entTefTomiDao.ObtenerOperacionPorFolio(
                mwTipoOperacion.tabla_trabajo,
                folio);

            if (datosOperacion != null)
            {
                importeTomi = datosOperacion.Importe;
                cuentaDebito = _vwT24.T24_TEF_Acct;

                if (datosOperacion.MotivoDevolucion > 0)
                {
                    tipo = "D";
                    cuentaCredito = DameTexto(datosOperacion.CuentaOrdenante);
                }
                else
                {
                    cuentaCredito = DameTexto(datosOperacion.CuentaReceptor);
                }

                if (cuentaCredito.Length == 20)
                    cuentaCredito = cuentaCredito.Substring(2, 18);

                cuentaCredito = _vwT24.DameCuentaMufg(DameTexto(cuentaCredito));
                folioUnico = DameTexto(datosOperacion.NfFolioUnico);
            }

            // Valida fecha de ejecución...
            if (string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) < 0)
                throw new Exception($"Se desea realizar una operación al {fechaEjecucion} cuando la fecha del sistema es {_configuracion.FechaSistema}.");

            // Actualiza datos del maestro...
            await _entTefTomiDao.ActualizarDatosPlanTrabajoMaestro(
                folio,
                fechaEjecucion,
                moneda,
                importeTomi);

            // Fecha futura...
            bool fechaFutura = string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) > 0;

            if (fechaFutura)
            {
                await _entTefTomiDao.ActualizarEstatusFechaFutura(folio);
            }
            else
            {
                // DATOS_GRAL
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.DatosGral, StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Actualizando los datos del plan de trabajo maestro (estatus, etc).");

                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    await _entTefTomiDao.ActualizarEstatusT24(folio);

                    bool procesado = true;

                    if (procesado)
                    {
                        await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                        _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });
                    }
                    else
                    {
                        throw new Exception($"Error en procesamiento de registro DATOS_GRAL con folio: {folio}");
                    }
                }

                // T24_REGISTRO
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.T24Registro, StringComparison.Ordinal))
                {
                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar el registro de la operación en T24.");

                    bool procesado = await T24_REGISTRO(folio, tipo);

                    if (procesado)
                    {
                        Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se insertó correctamente el folio en base de TOMI.");
                    }
                    else
                    {
                        throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio}");
                    }

                    return false;

                    // Ya no llegaría a esta sección del código de T24_REGISTRO,
                    // ya que la actualización de terminación de tarea la realiza el TRG de la operación procesada.
                }

                // CONCILIAR
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.Conciliar, StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A conciliar operaciones (por estatus) entre TOMI y T24.");

                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    // Busca la operación en T24...
                    folioT24 = await _vwT24.ObtenerFolioAsignado(folioUnico);

                    if (folioT24 is null)
                        throw new Exception($"No existe folio asignado para el folio_unico='{folioUnico}'");

                    // Valida contra los datos de TOMI - T24...
                    EntTefFundsTransferDto datosT24 = await _entTefVistasT24Dao.ObtenerFundsTransferPorCurId(folioT24);

                    if (datosT24 != null)
                    {
                        decimal importeT24 = datosT24.DebitAmount;

                        string cuentaCreditoT24 = _vwT24.DameCuentaMufg(DameTexto(datosT24.CreditAcctNo));

                        if (string.Equals(folioT24, datosT24.CurId, StringComparison.Ordinal) &&
                            string.Equals(folioUnico, datosT24.SatelSysRef, StringComparison.Ordinal) &&
                            importeTomi == importeT24 &&
                            string.Equals(moneda, datosT24.DebitCurrency, StringComparison.Ordinal) &&
                            string.Equals(_vwT24.T24_TEF_Acct, datosT24.DebitAcctNo, StringComparison.Ordinal) &&
                            string.Equals(cuentaCredito, cuentaCreditoT24, StringComparison.Ordinal))
                        {
                            esIgualEnT24 = true;
                        }
                    }

                    if (!esIgualEnT24)
                        throw new Exception("Los datos de conciliación entre TOMI y T24 son diferentes");

                    await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    _configuracion.AliasProceso = "";
                }
            }

            return true;
        }

        /// <summary>
        /// Registra la operación ENT_TEF en Middleware T24.
        /// </summary>
        private async Task<bool> T24_REGISTRO(string folio, string tipo)
        {
            try
            {
                bool encontradoTomi = false;
                string instructions = "";

                MwT24TrxMaestro trxMaster = null;
                MwT24TrxDetalle trxDetail = null;

                _configuracion.UltimaExcepcion = null;

                // Busca la operación en TOMI...
                EntTefRegistroT24Dto datosRegistro = await _entTefTomiDao.ObtenerOperacionConpPorFolio(
                    mwTipoOperacion.tabla_trabajo,
                    folio);

                if (datosRegistro != null)
                {
                    encontradoTomi = true;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                        instructions = $"DEVOLUCION TEF a CUENTA/CLABE: {DameTexto(datosRegistro.CuentaOrdenante)}";
                    else
                        instructions = $"TEF RECIBIDO a CUENTA/CLABE: {DameTexto(datosRegistro.CuentaReceptor)}";

                    if (!string.Equals(DameTexto(datosRegistro.NombreOrdenante), "", StringComparison.Ordinal))
                        instructions += $" ORDENANTE: {DameTexto(datosRegistro.NombreOrdenante)}";

                    if (!string.Equals(DameTexto(datosRegistro.NfBancoBenef), "", StringComparison.Ordinal))
                        instructions += $" BANCO ORDENANTE: {DameTexto(datosRegistro.NfBancoBenef)}";

                    if (!string.Equals(DameTexto(datosRegistro.NombreReceptor), "", StringComparison.Ordinal))
                        instructions += $" BENEFICIARIO: {DameTexto(datosRegistro.NombreReceptor)}";

                    if (!string.Equals(DameTexto(datosRegistro.ClaveRastreo), "", StringComparison.Ordinal))
                        instructions += $" CLAVE DE RASTREO: {DameTexto(datosRegistro.ClaveRastreo).Trim()}";

                    if (!string.Equals(DameTexto(datosRegistro.RefLeyendaOrdenante), "", StringComparison.Ordinal))
                        instructions += $" CONCEPTO: {DameTexto(datosRegistro.RefLeyendaOrdenante).Trim()}";

                    if (!string.Equals(DameTexto(datosRegistro.RefNumOrdenante), "", StringComparison.Ordinal))
                        instructions += $" NUMERO DE REFERENCIA: {DameTexto(datosRegistro.RefNumOrdenante).Trim()}";

                    trxMaster = new MwT24TrxMaestro();

                    string theirRef = string.Empty;
                    string t24DebitTheirRef = DameTexto(datosRegistro.T24DebitTheirRef).Trim();

                    if (t24DebitTheirRef.Length <= 16)
                        theirRef = t24DebitTheirRef;
                    else
                        theirRef = t24DebitTheirRef.Substring(0, 16);

                    Config.EscribirLog($"INFO|{tipoOperacion}.t24_debit_their_ref={theirRef}");

                    trxMaster.STrxOperationSpecificType = tipoOperacion;
                    trxMaster.STrxOperationSubType = "COM_ENVIO";
                    trxMaster.STrxOperationFolio = folio;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                    {
                        trxMaster.STrxOperationSubType = "DEVOLUCION";
                        trxMaster.STrxOperationAcct = ObtenerCuentaOperacion(DameTexto(datosRegistro.CuentaOrdenante));
                    }
                    else
                    {
                        trxMaster.STrxOperationAcct = ObtenerCuentaOperacion(DameTexto(datosRegistro.CuentaReceptor));
                    }

                    trxDetail = new MwT24TrxDetalle();

                    trxDetail.SBeneficiary = TextoTEF(DameTexto(datosRegistro.NombreReceptor));
                    trxDetail.SDebit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SDebit_amount = string.Format("{0:0.##}", datosRegistro.Importe);
                    trxDetail.SDebit_their_ref = TextoBESS(theirRef);
                    trxDetail.SCredit_their_ref = folio;
                    trxDetail.SDebit_acct_no = _vwT24.T24_TEF_Acct;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                    {
                        trxDetail.SOrdering_cust = string.Equals(DameTexto(datosRegistro.NombreReceptor), "", StringComparison.Ordinal)
                            ? "ND"
                            : Mid(
                                _vwT24.ConvierteTextoAMultivalor(
                                    DameTexto(TextoTEF(DameTexto(datosRegistro.NombreReceptor))).TrimEnd(),
                                    35).ToUpper(),
                                1,
                                140);

                        trxDetail.SCredit_acct_no = ObtenerCuentaCredito(
                            DameTexto(datosRegistro.CuentaOrdenante),
                            DameTexto(datosRegistro.T24CreditAcctNo));
                    }
                    else
                    {
                        trxDetail.SOrdering_cust = string.Equals(DameTexto(datosRegistro.NombreOrdenante), "", StringComparison.Ordinal)
                            ? "ND"
                            : Mid(
                                _vwT24.ConvierteTextoAMultivalor(
                                    DameTexto(TextoTEF(DameTexto(datosRegistro.NombreOrdenante))).TrimEnd(),
                                    35).ToUpper(),
                                1,
                                140);

                        trxDetail.SCredit_acct_no = ObtenerCuentaCredito(
                            DameTexto(datosRegistro.CuentaReceptor),
                            DameTexto(datosRegistro.T24CreditAcctNo));
                    }

                    trxDetail.SCredit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SInstructions = instructions;
                    trxDetail.SSatelSysRef = folioUnico;
                    trxDetail.SFolio_tomi = folioUnico;
                    trxDetail.SProfit_centre_cust = datosRegistro.T24CustomerCode;
                    trxDetail.SPayment_details = _vwT24.ConvierteTextoAMultivalor(
                        TextoSPEI(datosRegistro.T24PaymentDetails),
                        35);
                }

                if (!encontradoTomi)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                return await _vwT24.RegistraTrx(
                    folioUnico,
                    MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                    mwTipoOperacion.tabla_trabajo,
                    tipoOperacion,
                    folio,
                    mwTipoOperacion.T24_Operation_ID,
                    trxDetail,
                    trxMaster
                    );
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}");
                _configuracion.UltimaExcepcion = ex;
            }

            return false;
        }
        /// <summary>
        /// Ejecuta la operacion ObtenerCuentaOperacion.
        /// </summary>
        private string ObtenerCuentaOperacion(string cuenta)
        {
            string cuentaNormalizada = DameTexto(Convert.ToInt64(cuenta));

            switch (cuentaNormalizada.Length)
            {
                case 7:
                    return cuentaNormalizada;

                case 12:
                    return MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaNormalizada, 6);

                case 18:
                case 20:
                    return _vwT24.DameCuentaMufg(
                        MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(
                            cuentaNormalizada,
                            cuentaNormalizada.Length - 17,
                            18));
            }

            return "";
        }

        /// <summary>
        /// Ejecuta la operacion ObtenerCuentaCredito.
        /// </summary>
        private string ObtenerCuentaCredito(string cuenta, string t24CreditAcctNo)
        {
            string cuentaNormalizada = DameTexto(Convert.ToInt64(cuenta));

            switch (cuentaNormalizada.Length)
            {
                case 7:
                    return cuentaNormalizada;

                case 12:
                    return MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaNormalizada, 6);

                case 18:
                    return _vwT24.DameCuentaMufg(
                        MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(
                            cuentaNormalizada,
                            cuentaNormalizada.Length - 17,
                            18));

                default:
                    return _vwT24.DameCuentaMufg(t24CreditAcctNo);
            }
        }

    }
