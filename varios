            }

            beneficiary.Name = DameTexto(datosBeneficiario.T24BenCustName);
            beneficiary.StreetName = DameTexto(datosBeneficiario.StreetBen);
            beneficiary.BuildingNumber = DameTexto(datosBeneficiario.BuildingNumberBen);
            beneficiary.ZipCode = DameTexto(datosBeneficiario.PostCodeBen);
            beneficiary.CountrySubDivision = DameTexto(datosBeneficiario.ColonyBen);
