        /// <summary>
        /// Ejecuta la operacion obtieneMensajeError.
        /// </summary>
        private string obtieneMensajeError(string[] arrayError)
        {
            string messageGeneralError = string.Empty;

            if (arrayError.Length > 0)
            {
                for (short cnt = 0; cnt <= arrayError.Length - 1; cnt++)
                {
                    messageGeneralError += arrayError[cnt];
                    if (cnt != arrayError.Length - 1)
                        messageGeneralError += "|";
                }
            }

            return messageGeneralError;
        }

        /// <summary>
        /// Ejecuta la operacion LimpiarCamposDetail.
        /// </summary>
        private void LimpiarCamposDetail(MwT24TrxDetalle clsTrxDetail)
        {
            Type type = clsTrxDetail.GetType();
            PropertyInfo[] propertiesList = type.GetProperties();

            foreach (PropertyInfo prop in propertiesList)
            {
                if (prop.PropertyType == typeof(string))
                {
                    object valorProp = prop.GetValue(clsTrxDetail, null);
                    if (valorProp != null)
                    {
                        string valor = valorProp.ToString();
                        valor = CleanText(valor);
                        prop.SetValue(clsTrxDetail, valor, null);
                    }
                }
            }

            clsTrxDetail.SInstructions = clsTrxDetail.SInstructions.Replace(":", " ");
        }

