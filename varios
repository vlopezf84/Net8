            _vwT24 = vwT24;
            _t24ClientFactory = t24ClientFactory;
        }

        /// <summary>
        /// Ejecuta la operacion ProcesaOperacion.
        /// </summary>
        public async Task<bool> ProcesaOperacion(string folio)
        {
            _correo[0] = _configuracion.ParametrosSistema["TMD_FROM_EMAIL"];
            _correo[2] = _configuracion.ParametrosSistema["TMD_TO_MAIL"];
            _correo[3] = _configuracion.ParametrosSistema["TMD_CC_EMAIL"];
            _correo[4] = _configuracion.ParametrosSistema["TMD_SUBJECT"];

            _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO()
            {
                Folio = folio,
                TipoOperacion = tipoOperacion,
                Servicio = _configuracion.NombreServicio
            });

            if (string.Equals(_configuracion.AliasProceso, "", StringComparison.Ordinal))
                return false;

            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia proceso folio={folio}.");

            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacion);
            if (mwTipoOperacion is null)
                throw new Exception($"No se encontró configuración MW para {tipoOperacion}.");

            string fechaEjecucion = string.Empty;
            decimal importeTomi = 0;
            string estatus = string.Empty;
            string usuarioConfirma = string.Empty;
            string moneda = string.Empty;
            string cuentaDeb = string.Empty;
            string forex = string.Empty;

            string fechaVencimiento = string.Empty;
            decimal tasaEcRate = 0;
            decimal tasaMargin = 0;
            string t24Cdl = string.Empty;

            bool esIgualEnT24 = false;
            string folioT24 = string.Empty;
            string datosDiferentes = string.Empty;
            string informacionEmail = string.Empty;

            DatosOperacionDto datosOperacion = await _TMDDao.ObtenerDatosOperacion(mwTipoOperacion.tabla_trabajo, folio);
            if (datosOperacion != null)
            {
                folioUnico = DameTexto(datosOperacion.nf_folio_unico);
                fechaEjecucion = DameTexto(datosOperacion.t24_value_date);
                forex = DameTexto(datosOperacion.nf_forex_relacionado);
                fechaVencimiento = DameTexto(datosOperacion.t24_fin_mat_date);
                tasaEcRate = datosOperacion.t24_interest_rate;
                tasaMargin = datosOperacion.t24_interest_spread;
                t24Cdl = DameTexto(datosOperacion.t24_customer_id);
                importeTomi = datosOperacion.t24_drawdown_net_amt;
                estatus = DameTexto(datosOperacion.nf_estatus);
                usuarioConfirma = DameTexto(datosOperacion.nf_usuario_autoriza);
                moneda = _vwT24.ValidaMoneda(DameTexto(datosOperacion.t24_currency));
                cuentaDeb = DameTexto(datosOperacion.t24_drawdown_account);
            }

            global::Aplicacion.DTOs.Operaciones.TMD.PlanTrabajoMaestroDatosDto datosPlanTrabajo = await _TMDDao.ObtenerDatosPlanTrabajoMaestro(folio, tipoOperacion);

            if (datosPlanTrabajo != null)
            {
                informacionEmail += "<p><b>Nombre del cliente: </b>" + DameTexto(datosPlanTrabajo.nombre_cliente) + "; </p>";
                informacionEmail += "<p><b>Numero de cliente: </b>" + DameTexto(datosPlanTrabajo.num_cliente) + ";</p>";
                informacionEmail += "<p><b>Folio: </b>" + folio + ";</p>";

                if (datosPlanTrabajo.importe == null)
                    informacionEmail += "<p><b>Importe: </b>;</p>";
                else
                    informacionEmail += "<p><b>Importe: </b>" + string.Format("{0:#,##0.##}", datosPlanTrabajo.importe) + ";</p>";

                informacionEmail += "<p><b>Numero de cuenta: </b>" + DameTexto(datosPlanTrabajo.num_cuenta) + ";</p> ";
            }
            else
            {
                informacionEmail =
                    "<p><b>Nombre del cliente:</b> CLIENTE_NO_ENCONTRADO;</p>" +
                    "<p><b>Numero de cliente: </b> NUMERO_CLIENTE_NO_ENCONTRADO;</p>" +
                    "<p><b>Folio: </b>" + folio + ";</p>" +
                    "<p><b>Importe: </b> IMPORTE_NO_ENCONTRADO;</p>" +
                    "<p><b>Numero de cuenta: </b>NUMERO_DE_CUENTA_NO_ENCONTRADO;</p>";
            }

            if (string.Equals(estatus, ConstantesEstatus.Recc, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se ha detectado la cancelacion de una operacion desde TOMI.");
                await _TMDDao.ActualizarCancelada(folio, tipoOperacion);
                return true;
            }

            if (!string.Equals(fechaEjecucion, _configuracion.FechaSistema, StringComparison.Ordinal))
                throw new Exception($"Se desea realizar una operacion al {fechaEjecucion} cuando la fecha del sistema es {_configuracion.FechaSistema}.");

            // DATOS_GRAL
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.DatosGral, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Actualizando los datos del plan de trabajo maestro (estatus, etc).");

                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                bool procesado = await _TMDDao.ActualizarEstatusPlanMaestro(folio, tipoOperacion, "T24");
                if (!procesado)
                    throw new Exception($"Error en procesamiento de registro DATOS_GRAL con folio: {folio}");

                await _controlServicio.TerminaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio
                });

                return true;
            }

            // T24_REGISTRO
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.T24Registro, StringComparison.Ordinal))
            {
                string messageError = string.Empty;

                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar el registro de la operacion en T24.");

                ResultadoAsync procesado = await T24_REGISTRO(folio, messageError, informacionEmail);

                messageError = procesado.Error;
                if (procesado.Resultado)
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se inserto correctamente el folio.");
                else
                    throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio} {messageError}");

                return true;
            }

            // CONCILIAR
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.Conciliar, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A conciliar operaciones (por estatus) entre TOMI y T24.");

                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                folioT24 = await _TMDDao.ObtenerTransactionIDTombin(folio) ?? string.Empty;

                FundsTransferDto datosTransferencia = await _TMDT24Dao.ObtenerDatosPrestamoVT24(folioT24);
                if (datosTransferencia != null)
                {
                    if (!string.Equals(forex, "", StringComparison.Ordinal))
                    {
                        Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion| Validacion con Forex");

                        if (folioT24 == datosTransferencia.LD_ID &&
                            folioUnico == datosTransferencia.LF_NO_FAC_NAFIN &&
                            fechaEjecucion == _configuracion.FechaSistema &&
                            fechaEjecucion == datosTransferencia.VALUE_DATE &&
                            fechaVencimiento == datosTransferencia.FIN_MAT_DATE &&
                            tasaEcRate == datosTransferencia.INTEREST_RATE &&
                            tasaMargin == datosTransferencia.INTEREST_SPREAD &&
                            t24Cdl == datosTransferencia.CUSTOMER_ID &&
                            21003 == datosTransferencia.CATEGORY &&
                            importeTomi == datosTransferencia.DRAWDOWN_NET_AMT &&
                            moneda == datosTransferencia.CURRENCY)
                        {
                            esIgualEnT24 = true;
                        }
                    }
                    else
                    {
                        Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion| Validacion sin Forex");

                        string fechaJulianaConvertida = _vwT24.CambiaJulianaAFecha(
                           _configuracion.FechaSistemaJuliana
                        );

                        if (folioT24 == datosTransferencia.LD_ID &&
                            folioUnico == datosTransferencia.LF_NO_FAC_NAFIN &&
                            fechaEjecucion == _configuracion.FechaSistema &&
                            fechaJulianaConvertida == datosTransferencia.VALUE_DATE &&
                            fechaVencimiento == datosTransferencia.FIN_MAT_DATE &&
                            tasaEcRate == datosTransferencia.INTEREST_RATE &&
                            tasaMargin == datosTransferencia.INTEREST_SPREAD &&
                            t24Cdl == datosTransferencia.CUSTOMER_ID &&
                            21003 == datosTransferencia.CATEGORY &&
                            importeTomi == datosTransferencia.DRAWDOWN_NET_AMT &&
                            moneda == datosTransferencia.CURRENCY &&
                            cuentaDeb == datosTransferencia.DRAWDOWN_ACCOUNT)
                        {
                            esIgualEnT24 = true;
                        }
                        else
                        {
                            if (folioT24 != datosTransferencia.LD_ID)
                                datosDiferentes += " LD_ID ";

                            if (folioUnico != datosTransferencia.LF_NO_FAC_NAFIN)
                                datosDiferentes += " LF_NO_FAC_NAFIN ";

                            if (fechaEjecucion != _configuracion.FechaSistema)
                                datosDiferentes += " Fecha Sistema ";

                            if (fechaJulianaConvertida != datosTransferencia.VALUE_DATE)
                                datosDiferentes += " VALUE DATE ";

                            if (fechaVencimiento != datosTransferencia.FIN_MAT_DATE)
                                datosDiferentes += " FIN_MAT_DATE ";

                            if (tasaEcRate != datosTransferencia.INTEREST_RATE)
                                datosDiferentes += " INTEREST_RATE ";

                            if (tasaMargin != datosTransferencia.INTEREST_SPREAD)
                                datosDiferentes += " INTEREST_SPREAD ";

                            if (t24Cdl != datosTransferencia.CUSTOMER_ID)
                                datosDiferentes += " CUSTOMER_ID ";

                            if (importeTomi != datosTransferencia.DRAWDOWN_NET_AMT)
                                datosDiferentes += " DRAWDOWN_NET_AMT ";

                            if (moneda != datosTransferencia.CURRENCY)
                                datosDiferentes += " CURRENCY ";

                            if (cuentaDeb != datosTransferencia.DRAWDOWN_ACCOUNT)
                                datosDiferentes += " DRAWDOWN_ACCOUNT ";

                            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion| Datos diferentes: {datosDiferentes}");
                        }
                    }
                }

                if (!esIgualEnT24)
                    throw new Exception($"Los datos de conciliacion entre TOMI y T24 son diferentes {datosDiferentes}");

                await _controlServicio.TerminaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                _configuracion.AliasProceso = string.Empty;
            }

            return true;
        }

        /// <summary>
        /// Ejecuta la operacion T24_REGISTRO.
        /// </summary>
        private async Task<ResultadoAsync> T24_REGISTRO(string folio, string messageError, string informacionEmail)
        {
            MwT24TrxMaestro trxMaster = null;
            MwT24TrxDetalle trxDetail = null;

            bool encontradoTomi = false;
            bool validadoForex = false;

            string forexRelacionado = string.Empty;
            string transaccionPendiente = string.Empty;
            string errorMensajeSql = string.Empty;
            string errorExcepcionMensajeSql = string.Empty;

            try
            {
                _configuracion.UltimaExcepcion = null;

                DatosOperacionDto datosOperacion = await _TMDDao.ObtenerDatosOperacionPorEstatus(mwTipoOperacion.tabla_trabajo, folio, _configuracion.FechaSistema);
                if (datosOperacion == null)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                encontradoTomi = true;
                forexRelacionado = DameTexto(datosOperacion.nf_forex_relacionado);

                trxMaster = new MwT24TrxMaestro()
                {
                    STrxOperationSpecificType = tipoOperacion,
                    STrxOperationSubType = "SIN_COM",
                    STrxOperationFolio = folio,
                    STrxOperationAcct = DameTexto(datosOperacion.t24_drawdown_account)
                };

                trxDetail = new MwT24TrxDetalle()
                {
                    SDrawdown_account = DameTexto(datosOperacion.t24_drawdown_account),
                    SPrin_liq_acct = DameTexto(datosOperacion.t24_drawdown_account),
                    SInt_liq_acct = DameTexto(datosOperacion.t24_drawdown_account),
                    SCurrency = _vwT24.ValidaMoneda(DameTexto(datosOperacion.t24_currency)),
                    SDrawdown_net_amt = string.Format("{0:0.##}", datosOperacion.t24_drawdown_net_amt),
                    SInterest_rate = DameTexto(datosOperacion.t24_interest_rate),
                    SInterest_spread = DameTexto(datosOperacion.t24_interest_spread),
                    SCustomer_id = DameTexto(datosOperacion.t24_customer_id),
                    SValue_date = DameTexto(datosOperacion.t24_value_date),
                    SFin_Mat_date = DameTexto(datosOperacion.t24_fin_mat_date),
                    SSatelSysRef = folioUnico
                };

                if (!encontradoTomi)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                validadoForex = true;

                if (validadoForex)
                {
                    if (!await ReenviaCorreo(folio, informacionEmail))
                        return new ResultadoAsync { Resultado = false, Error = messageError };

                    transaccionPendiente = await LDPendienteAutorizar(tipoOperacion, folio);

                    if (string.IsNullOrEmpty(transaccionPendiente))
                    {
                        Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|Se inicia el registro de la transaccion nueva.");
                        return await registraLD_T24WS(trxDetail, folio, messageError, informacionEmail);
                    }

                    Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|La transaccion estaba registrada como pendiente por autorizar.");
                    return await autorizaLD(transaccionPendiente, folio, messageError, informacionEmail, FuncOMetodos.T24_REGISTRO);
                }
                else
                {
                    errorMensajeSql = $"{tipoOperacion}.T24_REGISTRO|No se puede seguir con el proceso de registro de la operacion.";

                    Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|No se puede seguir con el proceso de registro de la operacion.");

                    await _TMDDao.ActualizarDatosPlanTrabajo(folio, tipoOperacion, errorMensajeSql);

                    CorreoHelper.EnviarCorreo(new MensajeCorreo()
                    {
                        CorreoOrigen = _correo[0],
                        NombreOrigen = _correo[1],
                        Para = _correo[2] + " ",
                        ConCopia = _correo[3],
                        CopiaOculta = null,
                        Asunto = _subjectCorreo + folio + " (1)",
                        Mensaje = "<html><body>" +
                        "<p>" + _bodyCorreo + folio + ";</p>" +
                        informacionEmail +
                        "<br/>" +
                        "<p>Detalles de la operación:</p>" +
                        "<ul><li>Error=" + errorMensajeSql + "</li></ul>" +
                        "<br/>" +
                        "<p>" + _pieDeNota + "</p>" +
                        "</body></html>"
                    });


                    await InsertaEmailError(folio, "Error en " + tipoOperacion + ".T24_REGISTRO;Error=" + errorMensajeSql);
                }
                return new ResultadoAsync { Resultado = true, Error = messageError };
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"Error|{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}");

                errorExcepcionMensajeSql = $"{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}";

                await _TMDDao.ActualizarDatosPlanTrabajo(folio, tipoOperacion, errorExcepcionMensajeSql);

                CorreoHelper.EnviarCorreo(new MensajeCorreo()
                {
                    CorreoOrigen = _correo[0],
                    NombreOrigen = _correo[1],
                    Para = _correo[2] + " ",
                    ConCopia = _correo[3],
                    CopiaOculta = null,
                    Asunto = _subjectCorreo + folio + " (1)",
                    Mensaje = "<html><body>" +
                    "<p>" + _bodyCorreo + folio + ";</p>" +
                    informacionEmail +
                    "<br/>" +
                    "<p>Detalles de operación:</p>" +
                    "<ul><li>Error=Se presenta exception: " + ex + "</li></ul>" +
                    "<br/>" +
                    "<p>" + _pieDeNota + "</p>" +
                    "</body></html>"
                });

                await InsertaEmailError(folio, "Error en " + tipoOperacion + ".T24_REGISTRO;Error=Se presenta exception: " + ex);

                _configuracion.UltimaExcepcion = ex;
                return new ResultadoAsync { Resultado = false, Error = messageError };
            }
        }

        /// <summary>
        /// Ejecuta la operacion registraLD_T24WS.
        /// </summary>
        public async Task<ResultadoAsync> registraLD_T24WS(MwT24TrxDetalle trxDetail, string folio, string messageError, string informacionEmail)
        {
            bool result = false;
            string messageOverride = string.Empty;
            string messageAutorizacion = string.Empty;
            string errorMensajeAutorizacionSql = string.Empty;

            try
            {
                wsT24.T24WebServicesImplClient req = _t24ClientFactory();
                wsT24.WSINPUTTTIMEDEPOSITSCMSRequest param = new wsT24.WSINPUTTTIMEDEPOSITSCMSRequest();
                wsT24.webRequestCommon wrc = new wsT24.webRequestCommon();
                wsT24.LDLOANSANDDEPOSITSMUFGECRATEWSType type = new wsT24.LDLOANSANDDEPOSITSMUFGECRATEWSType();
                wsT24.ofsFunction ofsFunc = new wsT24.ofsFunction();

                wrc.company = _configuracion.ParametrosSistema["WST24_MW_COMPANY"];
                wrc.password = _configuracion.ParametrosSistema["WST24_MW_PASSWORD"];
                wrc.userName = _configuracion.ParametrosSistema["WST24_MW_USERNAME"];

                param.WebRequestCommon = wrc;

                type.id = "";
                type.CUSTOMERID = trxDetail.SCustomer_id;
                type.CURRENCY = trxDetail.SCurrency;
                type.AMOUNT1 = trxDetail.SDrawdown_net_amt;
                type.VALUEDATE = trxDetail.SValue_date;
                type.FINMATDATE = trxDetail.SFin_Mat_date;
                type.DRAWDOWNACCOUNT = trxDetail.SDrawdown_account;
                type.INTERESTSPREAD = trxDetail.SInterest_spread;
                type.PRINLIQACCT = trxDetail.SDrawdown_account;
                type.INTLIQACCT = trxDetail.SDrawdown_account;
                type.CHRGLIQACCT = "";
                type.LFNOFACNAFIN = trxDetail.SSatelSysRef;

                param.LDLOANSANDDEPOSITSMUFGECRATEWSType = type;
                param.OfsFunction = ofsFunc;

                Config.EscribirLog(
                    ("INFO|registraLD_T24WS|Parametros listos para solicitud de ID en T24 por medio del servicio." +
                    "CUSTOMERID " + type.CUSTOMERID + ConstantesCaracteres.CrLf +
                    "CURRENCY " + type.CURRENCY + ConstantesCaracteres.CrLf +
                    "AMOUNT1 " + type.AMOUNT1 + ConstantesCaracteres.CrLf +
                    "VALUEDATE " + type.VALUEDATE + ConstantesCaracteres.CrLf +
                    "FINMATDATE " + type.FINMATDATE + ConstantesCaracteres.CrLf +
                    "DRAWDOWNACCOUNT " + type.DRAWDOWNACCOUNT + ConstantesCaracteres.CrLf +
                    "INTERESTSPREAD " + type.INTERESTSPREAD + ConstantesCaracteres.CrLf +
                    "PRINLIQACCT " + type.PRINLIQACCT + ConstantesCaracteres.CrLf +
                    "INTLIQACCT " + type.INTLIQACCT + ConstantesCaracteres.CrLf +
                    "LFNOFACNAFIN " + type.LFNOFACNAFIN)
                );

                wsT24.WSINPUTTTIMEDEPOSITSCMSResponse response = await req.WSINPUTTTIMEDEPOSITSCMSAsync(param);

                if (response.Status.successIndicator == wsT24.successIndicator.Success &&
                    !string.IsNullOrEmpty(response.Status.transactionId))
                {
                    if (response.LDLOANSANDDEPOSITSType.gOVERRIDE != null)
                    {
                        if (response.LDLOANSANDDEPOSITSType.gOVERRIDE.OVERRIDE.Length > 0)
                        {
                            Config.EscribirLog("INFO|registraLD_T24WS El servicio regreso respuesta exitosa pero con OVERRIDE ");

                            for (int ind = 0; ind <= response.LDLOANSANDDEPOSITSType.gOVERRIDE.OVERRIDE.Length - 1; ind++)
                            {
                                messageOverride += response.LDLOANSANDDEPOSITSType.gOVERRIDE.OVERRIDE[ind];

                                if (ind != response.LDLOANSANDDEPOSITSType.gOVERRIDE.OVERRIDE.Length - 1)
                                    messageOverride += "|";
                            }

                            messageOverride = messageOverride.Replace("'", "''");

                            Config.EscribirLog("INFO|registraLD_T24WS El mensaje devuelto del override:   " + messageOverride);

                            if (await ConfirmaOverdraft(messageOverride, tipoOperacion, folio))
                            {
                                messageError = messageOverride;

                                Config.EscribirLog("INFO|registraLD_T24WS|Se confirma error de OVERDRAFT " + messageOverride);

                                errorMensajeAutorizacionSql = "Se confirma error de OVERDRAFT " + messageOverride;

                                await _TMDDao.ActualizarDatosPlanTrabajo(folio, tipoOperacion, errorMensajeAutorizacionSql);

                                CorreoHelper.EnviarCorreo(new MensajeCorreo()
                                {
                                    CorreoOrigen = _correo[0],
                                    NombreOrigen = _correo[1],
                                    Para = _correo[2] + " ",
                                    ConCopia = _correo[3],
                                    CopiaOculta = null,
                                    Asunto = _subjectCorreo + folio + " (1)",
                                    Mensaje = "<html><body>" + "<p>" + _bodyCorreo + folio + ";</p>" + informacionEmail + "<br/>" + "<p>" + "Detalles de la operacion: " + "</p>" + "<ul>" + "<li>Error=" + errorMensajeAutorizacionSql + "</li>" + "</ul>" + "<br/>" + "<p>" + _pieDeNota + "</p>" + "</body></html>"
                                });

                                await InsertaEmailError(folio, "Error en registraLD_T24WS;Error=" + errorMensajeAutorizacionSql);
                                result = false;
                            }
                            else
                            {
                                messageError = messageOverride;

                                Config.EscribirLog("INFO|registraLD_T24WS|Se presenta error de OVERRIDE " + messageError);

                                errorMensajeAutorizacionSql = "No se realizo la operacion, se presenta error de OVERRIDE" + messageError;

                                await _TMDDao.ActualizarDatosPlanTrabajo(folio, tipoOperacion, errorMensajeAutorizacionSql);

                                CorreoHelper.EnviarCorreo(new MensajeCorreo()
                                {
                                    CorreoOrigen = _correo[0],
                                    NombreOrigen = _correo[1],
                                    Para = _correo[2] + " ",
                                    ConCopia = _correo[3],
                                    CopiaOculta = null,
