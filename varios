        /// <summary>
        /// Valida y mapea objeto a enviar para pago CIE.
        /// </summary>
        public PaymentSent validarYMapearObjetoAEnviarCIE(
            string referenceToSend,
            string conceptToSend,
            string noAgreementToSend,
            string amountToSend,
            string contractNumberToSend,
            string chargeAccountToSend)
        {
            PaymentSent objectToSend = new PaymentSent();
            objectToSend.taxableCash = new TaxableCash();
            objectToSend.sender = new Sender();
            objectToSend.sender.contract = new Contract();
            objectToSend.sender.operationType = new OperationType();
            objectToSend.sender.contract.chargingCurrency = new ChargingCurrency();

            if (DameTexto(conceptToSend).Trim().Length > 30)
                throw new Exception("La longitud de carácteres del concepto es mayor a 30.");
            else if (DameTexto(referenceToSend).Trim().Length > 50)
                throw new Exception("La longitud de carácteres de la referencia es mayor a 50.");
            else if (DameTexto(noAgreementToSend).Trim().Length > 9)
                throw new Exception("La longitud de carácteres del número de convenio es mayor a 9.");
            else if (DameTexto(contractNumberToSend).Trim().Length > 8)
                throw new Exception("La longitud de carácteres del número de contrato es mayor a 8.");
            else if (DameTexto(chargeAccountToSend).Trim().Length > 20)
                throw new Exception("La longitud de carácteres del número de cuenta de cargo es mayor a 20.");
            else if (DameTexto(amountToSend).Trim().Length > 18)
                throw new Exception("La longitud de carácteres del monto es mayor a 18 (15,2).");

            objectToSend.sender.contract.contractNumber = DameTexto(contractNumberToSend).PadLeft(8, '0');
            objectToSend.sender.chargeAccount = DameTexto(chargeAccountToSend).PadLeft(20, '0');
            objectToSend.numberAgreement = DameTexto(noAgreementToSend).PadLeft(9, '0');
            objectToSend.taxableCash.amount = Convert.ToDecimal(amountToSend);
            objectToSend.reference = referenceToSend;
            objectToSend.concept = conceptToSend;

            return objectToSend;
        }

        /// <summary>
        /// Valida y mapea objeto a enviar para generación de TSEC.
        /// </summary>
        public GenerateTSEC validarYMapearObjetoAEnviarTSEC(string contractNumberToSend, string digitalKey)
        {
            GenerateTSEC objectToSend = new GenerateTSEC();
            objectToSend.authentication = new Authentication();
            objectToSend.authentication.authenticationData.Add(new AuthenticationData());
            objectToSend.backendUserRequest = new BackendUserRequest();

            if (DameTexto(contractNumberToSend).Trim().Length > 8)
                throw new Exception("La longitud de carácteres del número de contrato es mayor a 8.");

            objectToSend.authentication.userID = DameTexto(contractNumberToSend).PadLeft(8, '0');
            objectToSend.backendUserRequest.accessCode = DameTexto(contractNumberToSend).PadLeft(8, '0');
            objectToSend.authentication.authenticationData[0].authenticationData.Add(digitalKey);

            return objectToSend;
        }

