            string folio,
            int? tipoPago,
            string tipoCuenta,
            string bancoBeneficiario,
            string cuentaBeneficiario,
            string nombreBeneficiario)
        {
            var r = await EjecutarStoredProcedureQuery<ResultadoVacioDto>(
                ConstantesServicio.UspLecturaMDActualizarDatosSpeiSpidOperacion,
                cmd =>
                {
                    cmd.Parameters.Add(basedatosConexion.CrearParametro("@TablaTrabajo", tablaTrabajo));
