        /// <summary>
        /// Ejecuta la operacion GetAgentInfo.
        /// </summary>
        public async Task<AgentDto> GetAgentInfo(string identifier, bool getAccounts = false)
        {
            AgentDto agent = new AgentDto
            {
                Accounts = new List<AgentAccountDto>(),
                Identifiers = new List<AgentIdentifierDto>()
            };

            string sanitizedIdentifier = GetSanitizedFinancialInstitutionIdentifier(identifier, IdentifierType.BIC11);
            List<long> agentIds = new List<long>();

            List<FxiFinancialInstitutionDto> instituciones = await _fxiTomiDao.ObtenerInstitucionesPorIdentificador(sanitizedIdentifier);

            foreach (FxiFinancialInstitutionDto institucion in instituciones)
            {
                agentIds.Add(institucion.Id);
                agent.Id = institucion.Id;
                agent.FoundByIdentifier = institucion.Identifier;
                agent.FoundByIdentifierType = (IdentifierType)MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(institucion.IdentifierType, "IdentifierType");
            }

            if (agent.Id < 1)
            {
                Config.EscribirLog("WARN|Shared_FXI.GetAgentInfo|No se encontro la institucion con identificador " + identifier + ".");
                throw new Exception("No se encontro la institucion con identificador " + identifier + ".");
            }

            foreach (long id in agentIds)
            {
                List<AgentIdentifierDto> identifiers = await GetAgentIdentifiers(id);

                foreach (AgentIdentifierDto idfr in identifiers)
                {
                    if (!agent.Identifiers.Contains(idfr))
                        agent.Identifiers.Add(idfr);
                }
            }

            if (!getAccounts)
                return agent;

            Config.EscribirLog("INFO|Shared_FXI.GetAgentInfo|A buscar las cuentas con la institucion con identificador " + identifier + ".");

            List<FxiAgentAccountDto> cuentas = await _fxiTomiDao.ObtenerCuentasInstitucion(agent.Id);

            foreach (FxiAgentAccountDto cuenta in cuentas)
            {
                AgentAccountDto account = new AgentAccountDto
                {
                    Id = cuenta.Id,
                    Number = cuenta.Account,
                    Currency = cuenta.CurrencyCode,
                    OwnerId = cuenta.OwnerId
                };

                agent.Accounts.Add(account);
            }

            return agent;
        }

