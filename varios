        /// <summary>
        /// Ejecuta la operacion extraeNodosXML.
        /// </summary>
        private List<string> extraeNodosXML(string variablesXML, string nombre)
        {
            List<string> result = new List<string>();
            XmlDocument loXML_Doc;
            string error;

            if (!XmlHelper.TryParseXmlSeguro(variablesXML, out loXML_Doc, out error))
            {
                Config.EscribirLog("ERROR|FXI.extraeNodosXML|XML invÃ¡lido: " + error);
                return result;
            }

            try
            {
                if (loXML_Doc.InnerXml != string.Empty)
                {
                    XmlNodeList loXML_Nodes = loXML_Doc.GetElementsByTagName(nombre);
                    if (loXML_Nodes.Count > 0)
                    {
                        foreach (XmlNode loXML_Node in loXML_Nodes[0].ChildNodes)
                            result.Add(loXML_Node.InnerText);
                    }
                }

                return result;
            }
            catch (Exception lexErrorXML)
            {
                throw new Exception("Error al obtener  nodos del XML:" + lexErrorXML.Message);
            }
        }

