                if (lsDebit_their_ref == string.Empty)
                    throw new Exception("No hay concepto de pago a registrar en SPEI");

                if (lbPorIntentar)
                {
                    if (DameTexto(laValoresFormato[14]) != string.Empty && tipoPago == 1)
                    {
                        tipoPago = 5;
                        Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Se cambia el tipo de pago SPEI de 1 a 5 por tener forex relacionado.");
