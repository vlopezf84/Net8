        /// <summary>
        /// Procesa la operación de Mercado de Dinero.
        /// </summary>
        public async Task<bool> ProcesaOperacion(string tipoOperacion, string folio)
        {
            // Verifica la última operación no realizada...
            _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

            if (string.Equals(_configuracion.AliasProceso, "", StringComparison.Ordinal))
                return false;

            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia proceso folio={folio}.");

            // Obtención de los datos de la familia de la operación...
            string sentidoMw = "";
            string tipoOperacionMw;

            if (string.Equals(tipoOperacion, "MD_T24", StringComparison.Ordinal))
            {
                sentidoMw = "S";
                tipoOperacionMw = $"{tipoOperacion}_{sentidoMw}";
            }
            else
                tipoOperacionMw = tipoOperacion;

            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacionMw);

            // Datos de la operación...
            MercadoDineroOperacionTomiDto datosOperacion = await _mercadoDineroTomiDao.ObtenerOperacionPorFolio(
                mwTipoOperacion.tabla_trabajo,
                folio);

            if (datosOperacion is null)
                throw new Exception($"No se encontraron datos de operación MercadoDinero para folio={folio}.");

            folioUnico = DameTexto(datosOperacion.NfFolioUnico);

            string fechaEjecucion = DameTexto(datosOperacion.NfFechaEjecucion);
            decimal importeTomi = datosOperacion.T24DebitAmount.GetValueOrDefault();
            string estatus = DameTexto(datosOperacion.NfEstatus);
            string usuarioConfirma = DameTexto(datosOperacion.NfUsuarioAutoriza);
            string moneda = _vwT24.ValidaMoneda(DameTexto(datosOperacion.T24DebitCurrency));
            string cuentaDebito = DameTexto(datosOperacion.T24DebitAcctNo);
            string cdl = DameTexto(datosOperacion.T24CustomerCode);

            string speiOpClave = DameTexto(datosOperacion.NfOpClaveSpei);
            string speiOpFechaOper = DameTexto(datosOperacion.NfOpFechaOperSpei);
            string speiOpFolio = DameTexto(datosOperacion.NfOpFolioSpei);

            string spidOpClave = "";
            string spidOpFechaOper = "";
            string spidOpFolio = "";

            string tipoLiquidacion = DameTexto(datosOperacion.TipoLiquidacion);
            string sentido = DameTexto(datosOperacion.Sentido);
            string family = DameTexto(datosOperacion.Family);

            string forexRelacionado = "";
            string tomiBenBanco = "";
            string tomiBenBancoCasfim = "";
            string tomiBenCuenta = DameTexto(datosOperacion.T24BenAcctNo);

            string spxxTipoPago = "";
            string spxxCasfimBene = "";
            string spxxNomBanco = "";
            string nomBeneficiario = "";
            string spxxTipoCuenta = "";
            string spxxCuentaBene = "";

            // Estatus RECC: cancelación de la operación...
            if (string.Equals(estatus, ConstantesEstatus.Recc, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se ha detectado la cancelación de una operación desde TOMI.");

                await _mercadoDineroTomiDao.CancelarOperacionPorFolio(
                    folio,
                    tipoOperacion);

                return true;
            }

            // Recrea el tipo de operación según sentido obtenido desde TOMI...
            if (string.Equals(tipoOperacion, "MD_T24", StringComparison.Ordinal))
                tipoOperacionMw = $"{tipoOperacion}_{sentido}";
            else
                tipoOperacionMw = tipoOperacion;

            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacionMw);

            // Lectura de datos complementarios para SPEI/SPID...
            if (string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal) ||
                string.Equals(tipoLiquidacion, "SPID", StringComparison.Ordinal))
            {
                MercadoDineroComplementoLiquidacionDto complemento =
                    await _mercadoDineroTomiDao.ObtenerComplementoLiquidacion(tipoLiquidacion, cdl);

                if (complemento is null)
                    throw new Exception($"No se encontró información para el tipo_liquidacion='{tipoLiquidacion}', CDL='{cdl}'.");

                spxxTipoPago = DameTexto(complemento.SpxxTipoPago);
                spxxCasfimBene = DameTexto(complemento.SpxxCasfimBene);
                spxxNomBanco = DameTexto(complemento.SpxxNomBanco);
                nomBeneficiario = DameTexto(complemento.NomBeneficiario);
                spxxTipoCuenta = DameTexto(complemento.SpxxTipoCuenta);
                spxxCuentaBene = DameTexto(complemento.SpxxCuentaBene);

                Config.EscribirLog(
                    $"INFO|{tipoOperacion}.procesaOperacion|La datos para registro '{tipoLiquidacion}' son: " +
                    $"tipo_pago={spxxTipoPago}, casfim_bene='{spxxCasfimBene}', Nom_banco={spxxNomBanco}, " +
                    $"Beneficiario='{nomBeneficiario}', tipo_cuenta='{spxxTipoCuenta}', Cuenta='{spxxCuentaBene}'.");

                await _mercadoDineroTomiDao.ActualizarDatosSpeiSpidOperacion(
                    mwTipoOperacion.tabla_trabajo,
                    folio,
                    complemento.SpxxTipoPago,
                    spxxTipoCuenta,
                    $"{spxxCasfimBene} - {spxxNomBanco}",
                    spxxCuentaBene,
                    nomBeneficiario);

                Config.EscribirLog(
                    $"INFO|{tipoOperacion}.procesaOperacion|Se actualiza los datos de spei|spid con: " +
                    $"nf_tipo_pago_spei={spxxTipoPago}, nf_tipo_cuenta='{spxxTipoCuenta}', " +
                    $"nf_banco_benef='{spxxCasfimBene} - {spxxNomBanco}', t24_ben_acct_no='{spxxCuentaBene}', " +
                    $"t24_ben_cust_name='{nomBeneficiario}'.");
            }

            // Legacy actual: si fechaEjecucion es distinta a FechaSistema, lanza excepción.
            if (!string.Equals(fechaEjecucion, _configuracion.FechaSistema, StringComparison.Ordinal))
                throw new Exception($"Se desea realizar una operación al {fechaEjecucion} cuando la fecha del sistema es {_configuracion.FechaSistema}.");

            bool fechaFutura = string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) > 0;

            if (fechaFutura)
            {
                await _mercadoDineroTomiDao.ActualizarEstatusFechaFutura(folio, tipoOperacion);
                return true;
            }

            // DATOS_GRAL
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.DatosGral, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Actualizando los datos del plan de trabajo maestro (estatus, etc).");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                await _mercadoDineroTomiDao.ActualizarEstatusT24(folio, tipoOperacion);
                bool resultado = true;

                if (resultado)
                {
                    await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });
                }
                else
                    throw new Exception($"Error en procesamiento de registro DATOS_GRAL con folio: {folio}");
            }

            // SPEI_REGISTRO
            if (string.Equals(_configuracion.AliasProceso, "SPEI_REGISTRO", StringComparison.Ordinal))
            {
                if (!string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal))
                    throw new Exception($"Se desea realizar el registro SPEI de la operación pero la liquidación es '{tipoLiquidacion}'");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar registro SPEI.");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                string folioT24 = await _vwT24.ObtenerFolioAsignado(folioUnico);

                if (string.IsNullOrWhiteSpace(folioT24))
                    throw new Exception($"Error al generar el folio propuesto T24 del folio {folio}");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se creo el folio propuesto en T24='{folioT24}', que será usado como clave de rastreo en SPEI.");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia la validación de la firma digital registrada en la Lectura.");

                if (!await _comunFxd.ValidaFirmaDigital(mwTipoOperacion.tabla_trabajo, folio, folioT24, false, Convert.ToInt16(spxxTipoPago)))
                    throw new Exception($"Se presentó una diferencia entre los datos ingresados y los datos a procesar. La firma no coincide .Folio : {folio}");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se confirmó que no hay alteración en la firma, continúa proceso.");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A registrar en SPEI para el tipo de pago={spxxTipoPago}.");

                bool resultado = await _speiComun.SPEI_REGISTRO(
                    mwTipoOperacion.tabla_trabajo,
                    folio,
                    folioT24,
                    false,
                    Convert.ToInt16(spxxTipoPago));

                if (!resultado)
                {
                    MercadoDineroInterfaseSpeiSpidDto interfaseDto =
                        await _mercadoDineroTomiDao.ObtenerInterfaseSpeiSpidPorFolio(
                            mwTipoOperacion.tabla_trabajo,
                            folio);

                    int interfaseSpei = -1;
                    string valor = DameTexto(interfaseDto?.NfInterfaseSpei);

                    if (string.Equals(valor, "", StringComparison.Ordinal))
                        interfaseSpei = 0;
                    else
                        interfaseSpei = Convert.ToInt32(valor);

                    switch (interfaseSpei)
                    {
                        case 0:
                            // Falta por registrar. No se hace nada para permitir reintento.
                            break;

                        case 1:
                            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|El folio en procesamiento ya se había insertado en base SPEI pero no se marcó el proceso como realizado.");
                            resultado = true;
                            break;

                        case 2:
                            throw new Exception("Error durante el registro de la operación en SPEI, se intentó registrar la operación pero marco nf_interfase_spei=2 (problemas de registro)");
                    }
                }

                if (resultado)
                {
                    await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });
                }
                else
                    throw new Exception($"Error en procesamiento de SPEI_REGISTRO con folio: {folio}");
            }

            // SPID_REGISTRO
            if (string.Equals(_configuracion.AliasProceso, "SPID_REGISTRO", StringComparison.Ordinal))
            {
                if (!string.Equals(tipoLiquidacion, "SPID", StringComparison.Ordinal))
                    throw new Exception($"Se desea realizar el registro SPID de la operación pero la liquidación es '{tipoLiquidacion}'");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar registro SPID.");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                string folioPropuesto = await _vwT24.GeneraFolioPresupuesto(
                    folioUnico,
                    MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                    tipoOperacion);

                if (string.IsNullOrWhiteSpace(folioPropuesto))
                    throw new Exception($"Error al generar el folio propuesto T24 del folio {folio}");

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se creo el folio propuesto en T24='{folioPropuesto}', que será usado como clave de rastreo en SPID.");

                bool resultado = await _spidCComun.SPID_REGISTRO(
                    mwTipoOperacion.tabla_trabajo,
                    folio,
                    folioPropuesto,
                    false,
                    Convert.ToInt16(spxxTipoPago));

                if (!resultado)
                {
                    MercadoDineroInterfaseSpeiSpidDto interfaseDto =
                        await _mercadoDineroTomiDao.ObtenerInterfaseSpeiSpidPorFolio(
                            mwTipoOperacion.tabla_trabajo,
                            folio);

                    int interfaseSpid = -1;
                    string valor = DameTexto(interfaseDto?.NfInterfaseSpei);

                    if (string.Equals(valor, "", StringComparison.Ordinal))
                        interfaseSpid = 0;
                    else
                        interfaseSpid = Convert.ToInt32(valor);

                    switch (interfaseSpid)
                    {
                        case 0:
                            // Falta por registrar. No se hace nada para permitir reintento.
                            break;

                        case 1:
                            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|El folio en procesamiento ya se había insertado en base SPID pero no se marcó el proceso como realizado.");
                            resultado = true;
                            break;

                        case 2:
                            throw new Exception("Error durante el registro de la operación en SPID, se intentó registrar la operación pero marco nf_interfase_spei=2 (problemas de registro)");
                    }
                }

                if (resultado)
                {
                    await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });
                }
                else
                    throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio}");
            }

            // T24_REGISTRO
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.T24Registro, StringComparison.Ordinal))
            {
                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar el registro de la operación en T24.");

                bool resultado = await T24_REGISTRO(tipoOperacion, folio);

                if (resultado)
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se insertó correctamente el folio en base de MW-T24 para su proceso.");
                else
                    throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio}");

                return false;
            }

            // SPEI_AUTORIZACION
            if (string.Equals(_configuracion.AliasProceso, "SPEI_AUTORIZACION", StringComparison.Ordinal))
            {
                if (!string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal))
                    throw new Exception($"Se desea realizar la autorización SPEI de la operación pero la liquidación es '{tipoLiquidacion}'");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Esperando la autorización de la operación en SPEI por trigger de T24.");

                return false;
            }

            // SPID_AUTORIZACION
            if (string.Equals(_configuracion.AliasProceso, "SPID_AUTORIZACION", StringComparison.Ordinal))
            {
                if (!string.Equals(tipoLiquidacion, "SPID", StringComparison.Ordinal))
                    throw new Exception($"Se desea realizar la autorización SPID de la operación pero la liquidación es '{tipoLiquidacion}'");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Esperando la autorización de la operación en SPID por trigger de T24.");

                return false;
            }

            // CONCILIAR
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.Conciliar, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A conciliar operaciones (por estatus) entre TOMI, T24 y SPEI.");

                await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                string folioT24 = await _vwT24.ObtenerFolioAsignado(folioUnico);

                if (folioT24 is null)
                    throw new Exception($"No existe folio asignado para el folio_unico='{folioUnico}'");

                string categoriaT24 = MW_T24_Categoria[family.ToUpper()];
                string cuentaPuente = ArmaCuentaPuente(moneda, categoriaT24);

                string cuentaT24ValDr = "";
                string cuentaT24ValCr = "";

                switch (tipoLiquidacion)
                {
                    case "T24":
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                        {
                            cuentaT24ValDr = cuentaDebito;
                            cuentaT24ValCr = cuentaPuente;
                        }
                        else
                        {
                            cuentaT24ValDr = cuentaPuente;
                            cuentaT24ValCr = cuentaDebito;
                        }
                        break;

                    case "SPEI":
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                        {
                            cuentaT24ValDr = _vwT24.T24_BanxicoAcct;
                            cuentaT24ValCr = cuentaPuente;
                        }
                        else
                        {
                            cuentaT24ValDr = cuentaPuente;
                            cuentaT24ValCr = _vwT24.T24_BanxicoAcct;
                        }
                        break;

                    case "SPID":
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                        {
                            cuentaT24ValDr = _vwT24.T24_Banxico_USD_Acct;
                            cuentaT24ValCr = cuentaPuente;
                        }
                        else
                        {
                            cuentaT24ValDr = cuentaPuente;
                            cuentaT24ValCr = _vwT24.T24_Banxico_USD_Acct;
                        }
                        break;

                    case "MT103":
                    case "MT202":
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            throw new Exception($"Los datos de conciliación entre TOMI y T24 no pueden realizarse para '{tipoLiquidacion}' con sentido de Entrada");

                        cuentaT24ValDr = cuentaPuente;
                        List<OperacionesEntidad> datosCuentaNostro = await _vwT24.ObtieneDatosCuentasNostro();
                        cuentaT24ValCr = datosCuentaNostro.Where(x => x.Moneda == moneda).FirstOrDefault().Cuenta;
                        break;

                    case "MT210":
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            throw new Exception($"Los datos de conciliación entre TOMI y T24 no pueden realizarse para '{tipoLiquidacion}' con sentido de Entrada");

                        datosCuentaNostro = await _vwT24.ObtieneDatosCuentasNostro();
                        cuentaT24ValDr = datosCuentaNostro.Where(x => x.Moneda == moneda).FirstOrDefault().Cuenta;
                        cuentaT24ValCr = cuentaPuente;
                        break;

                    default:
                        if (string.Equals(sentido, "E", StringComparison.Ordinal))
                        {
                            cuentaT24ValDr = cuentaDebito;
                            cuentaT24ValCr = cuentaPuente;
                        }
                        else
                        {
                            cuentaT24ValDr = cuentaPuente;
                            cuentaT24ValCr = cuentaDebito;
                        }
                        break;
                }

                MercadoDineroFundsTransferT24Dto datosT24 =
                    await _mercadoDineroVistasT24Dao.ObtenerFundsTransferPorCurId(folioT24);

                if (datosT24 is null)
                    throw new Exception($"No existe la transferencia en T24 para CUR_ID='{folioT24}'");

                Config.EscribirLog(
                    $"INFO|{tipoOperacion}.procesaOperacion|CUR_ID='{datosT24.CurId}', SATEL_SYS_REF='{datosT24.SatelSysRef}', " +
                    $"DEBIT_AMOUNT='{datosT24.DebitAmount}', DEBIT_CURRENCY='{datosT24.DebitCurrency}', Sentido='{sentido}', " +
                    $"DEBIT_ACCT_NO='{datosT24.DebitAcctNo}', CREDIT_ACCT_NO='{datosT24.CreditAcctNo}'.");

                decimal importeT24 = datosT24.DebitAmount;

                bool esIgualEnT24 =
                    string.Equals(folioT24, datosT24.CurId, StringComparison.Ordinal) &&
                    string.Equals(folioUnico, datosT24.SatelSysRef, StringComparison.Ordinal) &&
                    importeTomi == importeT24 &&
                    string.Equals(moneda, datosT24.DebitCurrency, StringComparison.Ordinal) &&
                    string.Equals(cuentaT24ValDr, datosT24.DebitAcctNo, StringComparison.Ordinal) &&
                    string.Equals(cuentaT24ValCr, datosT24.CreditAcctNo, StringComparison.Ordinal);

                if (!esIgualEnT24)
                    throw new Exception("Los datos de conciliación entre TOMI y T24 son diferentes");

                if (string.Equals(sentido, "S", StringComparison.Ordinal))
                {
                    if (string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal) ||
                        string.Equals(tipoLiquidacion, "SPID", StringComparison.Ordinal))
                    {
                        MercadoDineroDatosSpeiSpidTomiDto datosSpeiSpidTomi =
                            await _mercadoDineroTomiDao.ObtenerDatosSpeiSpidTomiPorFolio(
                                mwTipoOperacion.tabla_trabajo,
                                folio);

                        if (datosSpeiSpidTomi is null)
                            throw new Exception($"No se encontraron datos SPEI/SPID TOMI para folio={folio}.");

                        tomiBenBanco = DameTexto(datosSpeiSpidTomi.NfBancoBenef);

                        string[] valoresTmp = tomiBenBanco.Split('-');
                        tomiBenBancoCasfim = valoresTmp.Length > 0 ? valoresTmp[0].Trim() : "";

                        speiOpClave = DameTexto(datosSpeiSpidTomi.NfOpClaveSpei);
                        speiOpFechaOper = DameTexto(datosSpeiSpidTomi.NfOpFechaOperSpei);
                        speiOpFolio = DameTexto(datosSpeiSpidTomi.NfOpFolioSpei);

                        spidOpClave = speiOpClave;
                        spidOpFechaOper = speiOpFechaOper;
                        spidOpFolio = speiOpFolio;

                        Config.EscribirLog(
                            $"INFO|{tipoOperacion}.procesaOperacion|Datos SPEI o SPID. " +
                            $"SPEI_op_clave='{speiOpClave}', SPEI_op_fecha_oper='{speiOpFechaOper}', SPEI_op_folio='{speiOpFolio}'.");
                    }

                    if (string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal))
                    {
                        IMercadoDineroSpeiDao speiDao = _mercadoDineroSpeiDao(_configuracion.ParametrosSistema["SPEI_SERVIDOR_PRINCIPAL"]);

                        MercadoDineroSpeiInfoDto datosSpei = await speiDao.ObtenerSpeiInfo(
                            Convert.ToDecimal(speiOpClave),
                            Convert.ToDecimal(speiOpFechaOper),
                            Convert.ToDecimal(speiOpFolio));

                        if (datosSpei is null)
                            throw new Exception($"No se encontraron datos SPEI para op_clave='{speiOpClave}', op_fecha_oper='{speiOpFechaOper}', op_folio='{speiOpFolio}'.");

                        int tipoPago = datosSpei.tp_clave.GetValueOrDefault();

                        bool esIgualEnSpei;

                        if (!string.IsNullOrEmpty(forexRelacionado) || tipoPago == 6)
                        {
                            esIgualEnSpei =
                                string.Equals(datosSpei.op_fecha_oper, _configuracion.FechaSistema, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.ins_clave, tomiBenBancoCasfim, StringComparison.Ordinal) &&
                                datosSpei.op_monto.GetValueOrDefault() == importeTomi &&
                                string.Equals(datosSpei.op_cve_rastreo, folioT24, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.op_cuenta_ben, tomiBenCuenta, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.op_ref_numerica, folio, StringComparison.Ordinal);
                        }
                        else
                        {
                            esIgualEnSpei =
                                string.Equals(datosSpei.op_fecha_oper, _configuracion.FechaSistema, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.ins_clave, tomiBenBancoCasfim, StringComparison.Ordinal) &&
                                datosSpei.op_monto.GetValueOrDefault() == importeTomi &&
                                string.Equals(datosSpei.op_cve_rastreo, folioT24, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.op_cuenta_ord, string.Equals(cuentaDebito, "", StringComparison.Ordinal) ? "" : CuentaClabe(cuentaDebito), StringComparison.Ordinal) &&
                                string.Equals(datosSpei.op_cuenta_ben, tomiBenCuenta, StringComparison.Ordinal) &&
                                string.Equals(datosSpei.op_ref_numerica, folio, StringComparison.Ordinal);
                        }

                        if (!esIgualEnSpei)
                            throw new Exception("Los datos de conciliación entre TOMI y SPEI son diferentes");
                    }

                    if (string.Equals(tipoLiquidacion, "SPID", StringComparison.Ordinal))
                    {
                        MercadoDineroSpidInfoDto datosSpid = await _mercadoDineroSpidDao.ObtenerSpidInfo(
                            Convert.ToDecimal(spidOpClave),
                            Convert.ToDecimal(spidOpFechaOper),
                            Convert.ToDecimal(spidOpFolio));

                        if (datosSpid is null)
                            throw new Exception($"No se encontraron datos SPID para op_clave='{spidOpClave}', op_fecha_oper='{spidOpFechaOper}', op_folio='{spidOpFolio}'.");

                        bool esIgualEnSpid;

                        if (!string.IsNullOrEmpty(forexRelacionado))
                        {
                            esIgualEnSpid =
                                string.Equals(datosSpid.op_fecha_oper, _configuracion.FechaSistema, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.ins_clave, tomiBenBancoCasfim, StringComparison.Ordinal) &&
                                datosSpid.op_monto.GetValueOrDefault() == importeTomi &&
                                string.Equals(datosSpid.op_cve_rastreo, folioT24, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.op_cuenta_ben, tomiBenCuenta, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.op_ref_numerica, folio, StringComparison.Ordinal);
                        }
                        else
                        {
                            esIgualEnSpid =
                                string.Equals(datosSpid.op_fecha_oper, _configuracion.FechaSistema, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.ins_clave, tomiBenBancoCasfim, StringComparison.Ordinal) &&
                                datosSpid.op_monto.GetValueOrDefault() == importeTomi &&
                                string.Equals(datosSpid.op_cve_rastreo, folioT24, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.op_cuenta_ord, string.Equals(cuentaDebito, "", StringComparison.Ordinal) ? "" : CuentaClabe(cuentaDebito), StringComparison.Ordinal) &&
                                string.Equals(datosSpid.op_cuenta_ben, tomiBenCuenta, StringComparison.Ordinal) &&
                                string.Equals(datosSpid.op_ref_numerica, folio, StringComparison.Ordinal);
                        }

                        if (!esIgualEnSpid)
                            throw new Exception("Los datos de conciliación entre TOMI y SPID son diferentes");
                    }
                }

                await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                _configuracion.AliasProceso = "";
            }

            return true;
        }

        /// <summary>
        /// Registra la operación en Middleware T24.
        /// </summary>
        private async Task<bool> T24_REGISTRO(string tipoOperacion, string folio)
        {
            try
            {
                MwT24TrxMaestro trxMaster = null;
                MwT24TrxDetalle trxDetail = null;

                bool encontradoTomi = false;
                bool validadoForex = false;
                bool conError = false;
                bool generaSwEnd2EndRef = false;

                string errorDesc = "";
                string forexRelacionado = "";
                string instructions = "";
                string swEnd2EndRef = "";

                string cuenta = "";
                string cuentaDr = "";
                string cuentaCr = "";
                string ordenante = "";
                string beneficiario = "";
                string ordenanteMd = "";
                string beneficiarioMd = "";

                string tipoLiquidacion = "";
                string sentido = "";
                string moneda = "";
                string externalRef = "";
                string calypsoId = "";
                string family = "";
                string familyDesc = "";
                string categoriaT24 = "";
                string cuentaPuente = "";
                string nombreMufg = "";
                string t24OpSubtipo = "";
                string datosXml = "";
                string cifNombre = "";

                decimal monto = 0m;

                _configuracion.UltimaExcepcion = null;

                // Nombre MUFG.
                DataTable datosCliente = await _vwT24.DatosClienteVw2(_vwT24.T24_MUFG_CDL);
                if (datosCliente.Rows.Count > 0)
                    nombreMufg = datosCliente.Rows[0]["COMPANY_NAME"].ToString();

                datosCliente.Dispose();

                MercadoDineroRegistroT24TomiDto datosRegistro =
                    await _mercadoDineroTomiDao.ObtenerRegistroT24PorFolio(
                        mwTipoOperacion.tabla_trabajo,
                        folio,
                        _configuracion.FechaSistema);

                if (datosRegistro != null)
                {
                    encontradoTomi = true;
                    conError = false;
                    errorDesc = "";

                    tipoLiquidacion = DameTexto(datosRegistro.TipoLiquidacion);
                    sentido = DameTexto(datosRegistro.Sentido);
                    externalRef = DameTexto(datosRegistro.ExternalRef);
                    calypsoId = DameTexto(datosRegistro.CalypsoId);
                    family = DameTexto(datosRegistro.Family);
                    moneda = _vwT24.ValidaMoneda(DameTexto(datosRegistro.T24DebitCurrency));
                    monto = datosRegistro.T24DebitAmount.GetValueOrDefault();
                    cuenta = DameTexto(datosRegistro.T24DebitAcctNo);
                    ordenanteMd = TextoSPEI(DameTexto(datosRegistro.T24CompanyName)).ToUpper();
                    beneficiarioMd = TextoSPEI(DameTexto(datosRegistro.T24BenCustName)).ToUpper();
                    datosXml = DameTexto(datosRegistro.DatosXml);
                    cifNombre = DameTexto(datosRegistro.DesCifNombre);

                    switch (family.ToUpper())
                    {
                        case "MONEYMARKET":
                        case "BONDMMDISCOUNT":
                        case "CA":
                            familyDesc = "MERCADO DE DINERO";
                            break;

                        case "FX":
                        case "FXFORWARD":
                        case "FXNDF":
                            familyDesc = "MERCADO DE CAMBIOS";
                            break;

                        case "CASH":
                        case "LOAN":
                        case "MONEYCALL":
                            familyDesc = "PRESTAMO INTERBANCARIO";
                            break;

                        case "CANCELAR":
                            familyDesc = "CANCELAR";
                            break;

                        default:
                            familyDesc = "OPERACION DE MERCADO";
                            break;
                    }

                    instructions = $"{familyDesc} ORDEN: {(externalRef != "" ? externalRef : calypsoId)}.";

                    categoriaT24 = MW_T24_Categoria[family.ToUpper()];
                    cuentaPuente = ArmaCuentaPuente(moneda, categoriaT24);

                    switch (tipoLiquidacion)
                    {
                        case "T24":
                            if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            {
                                cuentaDr = cuenta;
                                cuentaCr = cuentaPuente;
                                t24OpSubtipo = "MD_T24_E_CHQ";
                                ordenante = ordenanteMd;
                                beneficiario = nombreMufg;
                            }
                            else
                            {
                                cuentaDr = cuentaPuente;
                                cuentaCr = cuenta;
                                t24OpSubtipo = "MD_T24_S_CHQ";
                                ordenante = nombreMufg;
                                beneficiario = ordenanteMd;
                            }
                            break;

                        case "SPEI":
                            if (!string.Equals(moneda, _vwT24.MonedaDefaultMN, StringComparison.Ordinal))
                            {
                                conError = true;
                                errorDesc = $"No se puede registrar un SPEI con moneda '{moneda}'.";
                            }

                            if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            {
                                cuentaDr = _vwT24.T24_BanxicoAcct;
                                cuentaCr = cuentaPuente;
                                t24OpSubtipo = "MD_SPEI_E";
                                ordenante = ordenanteMd;
                                beneficiario = nombreMufg;
                                instructions += " ENTRADA SPEI.";
                            }
                            else
                            {
                                cuentaDr = cuentaPuente;
                                cuentaCr = _vwT24.T24_BanxicoAcct;
                                t24OpSubtipo = "MD_SPEI_S";
                                ordenante = nombreMufg;
                                beneficiario = ordenanteMd;
                                instructions += " SALIDA SPEI.";
                            }
                            break;

                        case "SPID":
                            if (!string.Equals(moneda, monedaSpid, StringComparison.Ordinal))
                            {
                                conError = true;
                                errorDesc = $"No se puede registrar un SPID con moneda '{moneda}'.";
                            }

                            if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            {
                                cuentaDr = _vwT24.T24_Banxico_USD_Acct;
                                cuentaCr = cuentaPuente;
                                t24OpSubtipo = "MD_SPID_E";
                                ordenante = ordenanteMd;
                                beneficiario = nombreMufg;
                                instructions += " ENTRADA SPID.";
                            }
                            else
                            {
                                cuentaDr = cuentaPuente;
                                cuentaCr = _vwT24.T24_Banxico_USD_Acct;
                                t24OpSubtipo = "MD_SPID_S";
                                ordenante = nombreMufg;
                                beneficiario = ordenanteMd;
                                instructions += " SALIDA SPID.";
                            }
                            break;

                        case "MT103":
                        case "MT202":
                            if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            {
                                conError = true;
                                errorDesc = $"No hay Entradas para los mensajes {tipoLiquidacion}.";
                            }
                            else
                            {
                                List<OperacionesEntidad> datosCuentaNostro = await _vwT24.ObtieneDatosCuentasNostro();
                                cuentaCr = datosCuentaNostro.Where(x => x.Moneda == moneda).FirstOrDefault().Cuenta;
                                cuentaDr = cuentaPuente;
                                t24OpSubtipo = "MD_MT202_S";
                                ordenante = nombreMufg;
                                beneficiario = nombreMufg;
                                beneficiarioMd = nombreMufg;
                                instructions += " SALIDA MT-202.";
                            }
                            break;

                        case "MT210":
                            if (string.Equals(sentido, "E", StringComparison.Ordinal))
                            {
                                conError = true;
                                errorDesc = $"No hay Entradas para los mensajes {tipoLiquidacion}.";
                            }
                            else
                            {
                                List<OperacionesEntidad> datosCuentaNostro = await _vwT24.ObtieneDatosCuentasNostro();
                                cuentaDr = datosCuentaNostro.Where(x => x.Moneda == moneda).FirstOrDefault().Cuenta;
                                cuentaCr = cuentaPuente;
                                t24OpSubtipo = "MD_MT210_S";

                                if (!string.IsNullOrEmpty(cifNombre))
                                    ordenante = cifNombre;
                                else
                                    ordenante = MufgConstants.T24SwiftPrefix + XmlHelper.busca_valor_xml(datosXml, "order_BIC");

                                beneficiario = nombreMufg;
                                beneficiarioMd = nombreMufg;
                                instructions += " SALIDA MT-210.";

                                if (!string.Equals(cuentaDr, XmlHelper.busca_valor_xml(datosXml, "debit_acct"), StringComparison.Ordinal))
                                    throw new Exception("Los datos de la cuenta de crédito no corresponden entre Calypso y T24");
                            }
                            break;
                    }

                    trxMaster = new MwT24TrxMaestro();

                    string theirRefOriginal = DameTexto(datosRegistro.T24DebitTheirRef).Trim();
                    string theirRef = theirRefOriginal.Length <= 16
                        ? theirRefOriginal
                        : theirRefOriginal.Substring(0, 16);

                    Config.EscribirLog($"INFO|{tipoOperacion}.t24_debit_their_ref={theirRef}");

                    trxMaster.STrxOperationSpecificType = "MD";
                    trxMaster.STrxOperationSubType = t24OpSubtipo;
                    trxMaster.STrxOperationFolio = folio;
                    trxMaster.STrxOperationAcct = cuentaDr;

                    trxDetail = new MwT24TrxDetalle();

                    trxDetail.SDebit_acct_no = cuentaDr;
                    trxDetail.SDebit_currency = moneda;
                    trxDetail.SDebit_amount = string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.##}", monto);
                    trxDetail.SDebit_their_ref = TextoBESS(theirRef);
                    trxDetail.SCredit_their_ref = calypsoId;
                    trxDetail.SCredit_acct_no = cuentaCr;
                    trxDetail.SCredit_currency = moneda;

                    if (!string.Equals(tipoLiquidacion, "MT202", StringComparison.Ordinal))
                        trxDetail.SOrdering_cust = _vwT24.ConvierteTextoAMultivalor(ordenante, 35);

                    trxDetail.SBeneficiary = _vwT24.ConvierteTextoAMultivalor(beneficiario, 35);
                    trxDetail.SInstructions = instructions;
                    trxDetail.SSatelSysRef = folioUnico;
                    trxDetail.SFolio_tomi = folioUnico;

                    if (string.Equals(tipoLiquidacion, "SPEI", StringComparison.Ordinal))
                        trxDetail.SProfit_centre_cust = _vwT24.T24_MUFG_CDL;

                    if (string.Equals(tipoLiquidacion, "MT210", StringComparison.Ordinal))
                    {
                        trxDetail.SProfit_centre_cust = _vwT24.T24_MUFG_CDL;
                        trxDetail.SCommission_code = "W";
                        trxDetail.SCharge_code = "W";
                    }

                    if (string.Equals(tipoLiquidacion, "MT103", StringComparison.Ordinal) ||
                        string.Equals(tipoLiquidacion, "MT202", StringComparison.Ordinal))
                    {
                        string swfBenBic = XmlHelper.busca_valor_xml(datosXml, "ben_BIC");
                        string swfBenCta = XmlHelper.busca_valor_xml(datosXml, "ben_party");

                        if (swfBenCta.StartsWith("/", StringComparison.Ordinal))
                            swfBenCta = swfBenCta.Substring(1);

                        string swfAwBic = XmlHelper.busca_valor_xml(datosXml, "account_with_BIC");

                        trxDetail.SOrdering_bank = "T24SwiftPrefixBOTKMXMX";
                        trxDetail.SBen_bank = MufgConstants.T24SwiftPrefix + swfBenBic;
                        trxDetail.SBen_acct_no = swfBenCta;
                        trxDetail.SBen_bank_name = beneficiarioMd;

                        if (string.Equals(moneda, "USD", StringComparison.Ordinal))
                            trxDetail.SCharged_customer = "1230";
                        else if (string.Equals(moneda, "EUR", StringComparison.Ordinal))
                            trxDetail.SCharged_customer = "1328";
                        else if (string.Equals(moneda, "JPY", StringComparison.Ordinal))
                            trxDetail.SCharged_customer = "1382";

                        if (!string.IsNullOrEmpty(swfAwBic))
                            trxDetail.SAcct_with_bank = MufgConstants.T24SwiftPrefix + swfAwBic;

                        generaSwEnd2EndRef = true;
                    }
                }

                if (string.Equals(familyDesc, "CANCELAR", StringComparison.Ordinal))
                {
                    await _mercadoDineroTomiDao.ActualizarEstatusReccPorFolio(
                        mwTipoOperacion.tabla_trabajo,
                        folio);

                    Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|Se cancela operación {folio} por ser de tipo {familyDesc}");
                    return false;
                }

                if (generaSwEnd2EndRef)
                {
                    swEnd2EndRef = await _vwT24.BuscaSwEnd2EndRef(
                        string.Empty,
                        string.Empty,
                        folioUnico,
                        "MD",
                        folio,
                        string.Empty,
                        string.Empty);

                    if (string.Equals(swEnd2EndRef, "", StringComparison.Ordinal))
                    {
                        swEnd2EndRef = await _vwT24.GeneraSwEnd2EndRef(
                            string.Empty,
                            string.Empty,
                            folioUnico,
                            "MD",
                            folio,
                            string.Empty,
                            string.Empty,
                            tipoLiquidacion);

                        trxDetail.SSW_END2END_REF = swEnd2EndRef;
                    }
                }

                if (!encontradoTomi)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                if (conError)
                {
                    Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|{errorDesc}");
                    throw new Exception(errorDesc);
                }

                if (string.Equals(forexRelacionado, "", StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|Formato sin FX.");
                    validadoForex = true;
                }
                else
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|Validar Forex Relacionado - {forexRelacionado}.");

                    string divisaAdquiere = "";
                    string cuentaAdquiere = "";

                    ValidacionForexResultado forexConfirmado = await _vwT24.ValidaEstatusForex(forexRelacionado);
                        cuentaAdquiere = forexConfirmado.CuentaAdquiereCliente;
                        divisaAdquiere = forexConfirmado.DivisaAdquiereCliente;

                    if (forexConfirmado.EsValido)
                    {
                        trxDetail.SDebit_acct_no = cuentaAdquiere;

                        if (!string.Equals(trxDetail.SDebit_currency, _vwT24.ValidaMoneda(divisaAdquiere), StringComparison.Ordinal))
                            throw new Exception($"Monedas Distintas, Operación = '{trxDetail.SDebit_currency}', FOREX = '{divisaAdquiere}'");

                        trxDetail.SDebit_currency = _vwT24.ValidaMoneda(divisaAdquiere);
                        validadoForex = true;
                    }
                    else
                    {
                        Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|El FOREX {forexRelacionado} no está confirmado por el cliente o por MUFG - Tesoreria.");

                        _configuracion.UltimaExcepcion = new Exception($"El FOREX {forexRelacionado} no está confirmado por el cliente o por MUFG - Tesoreria");

                        await _controlServicio.ActualizaErrorProceso(
                            new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value, Excepcion = _configuracion.UltimaExcepcion }
                            );

                        return true;
                    }
                }

                if (validadoForex)
                {
                    return await _vwT24.RegistraTrx(
                        folioUnico,
                        MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                        mwTipoOperacion.tabla_trabajo,
                        tipoOperacion,
                        folio,
                        mwTipoOperacion.T24_Operation_ID,
                        trxDetail,
                        trxMaster
                        );
                }

                Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|No se puede seguir con el proceso de registro de la operación.");

                return false;
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}");
                _configuracion.UltimaExcepcion = ex;
            }

            return false;
        }

/// <summary>
        /// Ejecuta la operacion ArmaCuentaPuente.
        /// </summary>
        private static string ArmaCuentaPuente(string moneda, string categoria)
        {
            return $"{moneda}{categoria}0001";
        }

   
   
