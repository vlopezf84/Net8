using Aplicacion.Enums;
using Aplicacion.Interfaces.Operaciones.ENT_SPEI_2;
using Aplicacion.Modelos;
using MUFG_T24.Comunes;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Modelos;
using MUFG_T24.Repositorios;
using System;
using System.Threading.Tasks;
using static MUFG_T24.Comunes.Comunes;

namespace Aplicacion.Servicios.Operaciones
{
    /// <summary>
    /// Representa la funcionalidad de ENT_SPEI_2.
    /// </summary>
    public class ENT_SPEI_2
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IENT_SPEIDao _ENT_SPEIDao;
        private readonly IENT_SPEIT24Dao _ENT_SPEIT24Dao;
        private readonly ConexionT24Mw _vwT24;

        private MW_Tipo_operacion mwTipoOperacion;
        private const string tipoOperacion = "ENT_SPEI_2";
        private string folioUnico = "";

        /// <summary>
        /// Constructor.
        /// </summary>
        public ENT_SPEI_2(ConfiguracionServicio configuracion, IControlServicio controlServicio, IENT_SPEIDao eNT_SPEIDao, IENT_SPEIT24Dao eNT_SPEIT24Dao, ConexionT24Mw vwT24)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _ENT_SPEIDao = eNT_SPEIDao;
            _ENT_SPEIT24Dao = eNT_SPEIT24Dao;
            _vwT24 = vwT24;
        }

        /// <summary>
        /// 
        /// </summary>
        public async Task<bool> ProcesaOperacion(string folio)
        {
            //Obtiene la Ãºltima operaciÃ³n no realizada...
            _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO
            {
                Folio = folio,
                TipoOperacion = tipoOperacion,
                Servicio = _configuracion.NombreServicio,
                NombreProceso = _configuracion.NombreProceso,
                AliasProceso = _configuracion.AliasProceso,
                PId = _configuracion.Pid.Value
            });

            //Si no hay ultimo proceso...
            if (string.Equals(_configuracion.AliasProceso, "", StringComparison.Ordinal))
                return false;

            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia proceso folio={folio}.");

            //Obtiene los datos de la familia de la operaciÃ³n...
            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacion);

            string moneda = _vwT24.MonedaDefaultMN;
            string cuentaDeb = _vwT24.T24_BanxicoAcct;
            decimal importeTOMI = 0;
            string cuentaCre = "";
            string cuentaCreT24= "";
            string tipo = "";

            string fechaEjecucion = _configuracion.FechaSistema;
            if (string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) < 0)
                throw new Exception($"Se desea realizar una operaciÃ³n al {fechaEjecucion} cuando la fecha del sistema es {_configuracion.FechaSistema}.");

            //Obtiene datos de la operaciÃ³n...
            DatosOperacionDto datosOperacion = await _ENT_SPEIDao.ObtenerDatosOperacion(mwTipoOperacion.tabla_trabajo, folio);
            if (datosOperacion is null)
                throw new Exception($"No se encontraron datos de operaciÃ³n ENT_SPEI_2 para folio={folio}.");

            if (datosOperacion != null)
            {
                importeTOMI = datosOperacion?.op_monto ?? 0m;
                tipo = DameTexto(datosOperacion.tp_clave);
                cuentaDeb = _vwT24.T24_BanxicoAcct;
                cuentaCre = _vwT24.DameCuentaMufg(DameTexto(datosOperacion.op_cuenta_ben));

                if (cuentaCre.Length == 20 && cuentaCre.StartsWith("00108", StringComparison.Ordinal))
                    cuentaCre = cuentaCre.Substring(12, 7);
                else
                {
                    string creNorm = DameTexto(DameTextoComoCLng(cuentaCre));
                    switch (creNorm.Length)
                    {
                        case 7:
                            cuentaCre = creNorm;
                            break;

                        case 12:
                            cuentaCre = creNorm.Substring(5);
                            break;

                        case 18:
                            cuentaCre = _vwT24.DameCuentaMufg(creNorm.Substring(creNorm.Length - 18, 18));
                            break;

                        default:
                            cuentaCre = _vwT24.DameCuentaMufg(DameTexto(datosOperacion.t24_credit_acct_no));
                            break;
                    }
                }

                if (string.Equals(cuentaCre, "0", StringComparison.Ordinal))
                    cuentaCre = DameTexto(datosOperacion.t24_credit_acct_no);

                cuentaCreT24 = DameTexto(datosOperacion.t24_credit_acct_no);
                folioUnico = DameTexto(datosOperacion.nf_folio_unico);
            }

            //Si es devoluciÃ³n...
            if (string.Equals(tipo, "0", StringComparison.Ordinal))
                tipo = "D";

            //Actualiza los datos del plan de trabajo maestro...
            await _ENT_SPEIDao.ActualizarDatosPlanMaestro(_configuracion.FechaSistema, moneda, importeTOMI.ToString(), folio, tipoOperacion);

            bool fechaFutura = string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) > 0;
            if (fechaFutura)
            {
                await _ENT_SPEIDao.ActualizarEstatusPlanMaestro(folio, tipoOperacion, ConstantesEstatus.FechaFutura);
                return true;
            }

            //DATOS_GRAL
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.DatosGral, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Actualizando los datos del plan de trabajo maestro (estatus, etc).");

                //Actualiza los datos del plan de trabajo maestro...
                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                //actualiza el estatus del plan maestro...
                bool resultado = await _ENT_SPEIDao.ActualizarEstatusPlanMaestro(folio, tipoOperacion, "T24");
                if (resultado)
                {
                    await _controlServicio.TerminaProceso(new ProcesoDTO()
                    {
                        Folio = folio,
                        TipoOperacion = tipoOperacion,
                        Servicio = _configuracion.NombreServicio,
                        NombreProceso = _configuracion.NombreProceso,
                        AliasProceso = _configuracion.AliasProceso,
                        PId = _configuracion.Pid.Value
                    });
                    _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO()
                    {
                        Folio = folio,
                        TipoOperacion = tipoOperacion,
                        Servicio = _configuracion.NombreServicio
                    });
                }
                else
                    throw new Exception($"Error en procesamiento de registro DATOS_GRAL con folio: {folio}");
            }

            //T24_REGISTRO
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.T24Registro, StringComparison.Ordinal))
            {
                //Actualiza los datos del plan de trabajo maestro...
                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar el registro de la operaciÃ³n en T24.");

                bool procesando = await T24_REGISTRO(folio, tipo);
                if (procesando)
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se insertÃ³ correctamente el folio en base de TOMI.");
                else
                    throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio}");
                return false;
            }

            //CONCILIAR
            if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.Conciliar, StringComparison.Ordinal))
            {
                Config.EscribirLog($"INFO|{tipoOperacion}|A conciliar operaciones (por estatus) entre TOMI y T24.");

                //Actualiza los datos del plan de trabajo maestro...
                await _controlServicio.IniciaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });

                //Busca la operaciÃ³n en T24...
                string folioT24 = await _vwT24.ObtenerFolioAsignado(folioUnico);
                if (folioT24 is null)
                    throw new Exception($"No existe folio asignado para el folio_unico='{folioUnico}'");

                //Obtiene los datos de T24...
                FundsTransferDto datosTransferencia = await _ENT_SPEIT24Dao.ObtenerT24FUNDS_TRANSFER(folioT24);

                //Valida los datos de Tomi contra los de T24...
                if (datosTransferencia is null)
                    throw new Exception($"No existe la transferencia en T24 para CUR_ID='{folioT24}'");

                decimal debitAmountT24 = 0m;
                decimal.TryParse(datosTransferencia.DEBIT_AMOUNT, System.Globalization.NumberStyles.Any,
                                 System.Globalization.CultureInfo.InvariantCulture, out debitAmountT24);

                //Valida los datos de Tomi contra los de T24...
                bool esIgualEnT24 = false;
                string val = string.Empty;

                if (datosTransferencia != null)
                {
                    if (tipo == "D")
                    {
                        val = "Los datos de conciliaciÃ³n entre TOMI y T24 son diferentes - " + folioT24 + "=" + datosTransferencia.CUR_ID + " " + folioUnico + "=" + datosTransferencia.SATEL_SYS_REF + " " +
                                 moneda + "=" + datosTransferencia.DEBIT_CURRENCY + " " + importeTOMI + "=" + datosTransferencia.DEBIT_AMOUNT + " " +
                                 _vwT24.T24_BanxicoAcct + "=" + datosTransferencia.DEBIT_ACCT_NO + " " + cuentaCreT24 + "=" + datosTransferencia.CREDIT_ACCT_NO;

                        if (string.Equals(folioT24, datosTransferencia.CUR_ID, StringComparison.Ordinal) &&
                        string.Equals(folioUnico, datosTransferencia.SATEL_SYS_REF, StringComparison.Ordinal) &&
                        importeTOMI == debitAmountT24 &&
                        string.Equals(moneda, datosTransferencia.DEBIT_CURRENCY, StringComparison.Ordinal) &&
                        string.Equals(cuentaDeb, datosTransferencia.DEBIT_ACCT_NO, StringComparison.Ordinal) &&
                        string.Equals(cuentaCreT24, datosTransferencia.CREDIT_ACCT_NO, StringComparison.Ordinal))
                            esIgualEnT24 = true;
                    }
                    else
                    {
                        val = "Los datos de conciliaciÃ³n entre TOMI y T24 son diferentes - " + folioT24 + "=" + datosTransferencia.CUR_ID + " " + folioUnico + "=" + datosTransferencia.SATEL_SYS_REF + " " +
                                 moneda + "=" + datosTransferencia.DEBIT_CURRENCY + " " + importeTOMI + "=" + datosTransferencia.DEBIT_AMOUNT + " " +
                                 _vwT24.T24_BanxicoAcct + "=" + datosTransferencia.DEBIT_ACCT_NO + " " + cuentaCre + "=" + datosTransferencia.CREDIT_ACCT_NO;

                        if (string.Equals(folioT24, datosTransferencia.CUR_ID, StringComparison.Ordinal) &&
                        string.Equals(folioUnico, datosTransferencia.SATEL_SYS_REF, StringComparison.Ordinal) &&
                        importeTOMI == debitAmountT24 &&
                        string.Equals(moneda, datosTransferencia.DEBIT_CURRENCY, StringComparison.Ordinal) &&
                        string.Equals(cuentaDeb, datosTransferencia.DEBIT_ACCT_NO, StringComparison.Ordinal) &&
                        string.Equals(cuentaCre, datosTransferencia.CREDIT_ACCT_NO, StringComparison.Ordinal))
                            esIgualEnT24 = true;
                    }
                }

                if (!esIgualEnT24)
                    throw new Exception(val);

                await _ENT_SPEIDao.ActualizarFechaAutorizacion(mwTipoOperacion.tabla_trabajo, folio, _configuracion.FechaSistema);

                await _controlServicio.TerminaProceso(new ProcesoDTO()
                {
                    Folio = folio,
                    TipoOperacion = tipoOperacion,
                    Servicio = _configuracion.NombreServicio,
                    NombreProceso = _configuracion.NombreProceso,
                    AliasProceso = _configuracion.AliasProceso,
                    PId = _configuracion.Pid.Value
                });
                _configuracion.AliasProceso = "";
            }

            return true;
        }

        /// <summary>
        /// Ejecuta la operacion T24_REGISTRO.
        /// </summary>
        public async Task<bool> T24_REGISTRO(string folio, string tipo)
        {
            try
            {
                _configuracion.UltimaExcepcion = null;

                DatosOperacionDto datosTablaTrabajo = await _ENT_SPEIDao.ObtenerDatosOperacionPorEstatus(mwTipoOperacion.tabla_trabajo, folio);
                if (datosTablaTrabajo is null)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                string instrucciones = "SPEI RECIBIDO a CUENTA/CLABE: " + DameTexto(datosTablaTrabajo.op_cuenta_ben);

                if (DameTexto(datosTablaTrabajo.op_nom_ord) != "")
                    instrucciones += " ORDENANTE: " + DameTexto(datosTablaTrabajo.op_nom_ord);

                if (DameTexto(datosTablaTrabajo.nf_banco_benef) != "")
                    instrucciones += " BANCO ORDENANTE: " + DameTexto(datosTablaTrabajo.nf_banco_benef);

                if (DameTexto(datosTablaTrabajo.op_nom_ben) != "")
                    instrucciones += " BENEFICIARIO: " + DameTexto(datosTablaTrabajo.op_nom_ben);

                if (DameTexto(datosTablaTrabajo.op_cve_rastreo) != "")
                    instrucciones += " CLAVE DE RASTREO: " + DameTexto(datosTablaTrabajo.op_cve_rastreo).Trim();

                if (DameTexto(datosTablaTrabajo.op_concepto_pag2) != "")
                    instrucciones += " CONCEPTO: " + DameTexto(datosTablaTrabajo.op_concepto_pag2).Trim();

                if (DameTexto(datosTablaTrabajo.op_ref_numerica) != "")
                    instrucciones += " NUMERO DE REFERENCIA: " + DameTexto(datosTablaTrabajo.op_ref_numerica).Trim();

                MwT24TrxMaestro trxMaster = new MwT24TrxMaestro()
                {
                    STrxOperationSpecificType = tipoOperacion,
                    STrxOperationSubType = "COM_ENVIO",
                    STrxOperationFolio = folio
                };

                string trxOperationAcct = string.Empty;
                if (string.Equals(tipo, "D", StringComparison.Ordinal))
                {
                    string ordNorm = DameTexto(DameTextoComoCLng(datosTablaTrabajo.op_cuenta_ord));
                    switch (ordNorm.Length)
                    {
                        case 7:
                            trxOperationAcct = ordNorm;
                            break;
                        case 12:
                            trxOperationAcct = ordNorm.Substring(5);
                            break;
                        case 18:
                            trxOperationAcct = _vwT24.DameCuentaMufg(ordNorm.Substring(ordNorm.Length - 18, 18));
                            break;
                    }
                }
                else
                {
                    string benNorm = DameTexto(DameTextoComoCLng(datosTablaTrabajo.op_cuenta_ben));
                    switch (benNorm.Length)
                    {
                        case 7:
                            trxOperationAcct = benNorm;
                            break;
                        case 12:
                            trxOperationAcct = benNorm.Substring(5);
                            break;
                        case 18:
                            trxOperationAcct = _vwT24.DameCuentaMufg(benNorm.Substring(benNorm.Length - 18, 18));
                            break;
                    }
                }

                trxMaster.STrxOperationAcct = trxOperationAcct;

                // their_ref
                string theirRaw = DameTexto(datosTablaTrabajo.t24_debit_their_ref).Trim();
                string theirRef = theirRaw.Length <= 16 ? theirRaw : theirRaw.Substring(0, 16);

                Config.EscribirLog($"INFO|{tipoOperacion}.t24_debit_their_ref={theirRef}");

                MwT24TrxDetalle trxDetail = new MwT24TrxDetalle
                {
                    SBeneficiary = TextoSPEI(DameTexto(datosTablaTrabajo.op_nom_ben)),
                    SDebit_currency = _vwT24.MonedaDefaultMN,
                    SDebit_amount = string.Format("{0:0.##}", datosTablaTrabajo.t24_debit_amount),
                    SDebit_their_ref = TextoBESS(theirRef),
                    SCredit_their_ref = folio,
                    SDebit_acct_no = _vwT24.T24_BanxicoAcct
                };

                if (string.Equals(tipo, "D", StringComparison.Ordinal))
                {
                    trxDetail.SOrdering_cust = string.Equals(DameTexto(datosTablaTrabajo.op_nom_ben), "", StringComparison.Ordinal)
                        ? "ND"
                        : Left(_vwT24.ConvierteTextoAMultivalor(TextoSPEI(DameTexto(datosTablaTrabajo.op_nom_ben)), 35)
                               .TrimEnd()
                               .ToUpper(), 140);

                    string ordNorm = DameTexto(DameTextoComoCLng(datosTablaTrabajo.op_cuenta_ord));
                    switch (ordNorm.Length)
                    {
                        case 7:
                            trxDetail.SCredit_acct_no = ordNorm;
                            break;

                        case 12:
                            trxDetail.SCredit_acct_no = ordNorm.Substring(5);
                            break;

                        case 18:
                            trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(ordNorm.Substring(ordNorm.Length - 18, 18));
                            break;

                        default:
                            trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(DameTexto(datosTablaTrabajo.t24_credit_acct_no));
                            break;
                    }
                }
                else
                {
                    trxDetail.SOrdering_cust = string.Equals(DameTexto(datosTablaTrabajo.op_nom_ord), "", StringComparison.Ordinal)
                        ? "ND"
                        : Left(_vwT24.ConvierteTextoAMultivalor(TextoSPEI(DameTexto(datosTablaTrabajo.op_nom_ord)), 35)
                               .TrimEnd()
                               .ToUpper(), 140);

                    string benNorm = DameTexto(DameTextoComoCLng(datosTablaTrabajo.op_cuenta_ben));
                    switch (benNorm.Length)
                    {
                        case 7:
                            trxDetail.SCredit_acct_no = benNorm;
                            break;

                        case 12:
                            trxDetail.SCredit_acct_no = benNorm.Substring(5);
                            break;

                        case 18:
                            trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(benNorm.Substring(benNorm.Length - 18, 18));
                            break;

                        default:
                            trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(DameTexto(datosTablaTrabajo.t24_credit_acct_no));
                            break;
                    }
                }

                trxDetail.SCredit_currency = _vwT24.MonedaDefaultMN;
                trxDetail.SInstructions = instrucciones.TrimEnd();
                trxDetail.SSatelSysRef = folioUnico;
                trxDetail.SFolio_tomi = folioUnico;

                trxDetail.SCusRef1 = DameTexto(datosTablaTrabajo.t24_cust_ref_1);
                trxDetail.SCusRef2 = DameTexto(datosTablaTrabajo.t24_cust_ref_2);
                trxDetail.SCusRef3 = DameTexto(datosTablaTrabajo.t24_cust_ref_3);
                trxDetail.SCusRef4 = DameTexto(datosTablaTrabajo.t24_cust_ref_4);
                trxDetail.SCusRef5 = DameTexto(datosTablaTrabajo.t24_cust_ref_5);
                trxDetail.SProfit_centre_cust = DameTexto(datosTablaTrabajo.t24_customer_code);

                // Llamado a RegistraTrx (tu repo real es RegistraTrx)
                return await _vwT24.RegistraTrx(
                    folioUnico,
                    MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                    mwTipoOperacion.tabla_trabajo,
                    tipoOperacion,
                    folio,
                    mwTipoOperacion.T24_Operation_ID,
                    trxDetail,
                    trxMaster
                );
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}");
                _configuracion.UltimaExcepcion = ex;
            }
            return false;
        }

    }
}


using Aplicacion.DTOs.BBVA;
using Aplicacion.Modelos;
using MUFG_T24.Comunes;
using static MUFG_T24.Comunes.Comunes;

namespace Aplicacion.Servicios.Comunes
{
    using AplicacionT24.Interfaces.Comunes.BBVA;
    using Newtonsoft.Json;
    using System;
    using System.IO;
    using System.Net;
    using System.Net.Security;
    using System.Security.Cryptography.X509Certificates;
    using System.Text;
    using System.Threading.Tasks;


    /// <summary>
    /// Representa la funcionalidad de BBVAComun.
    /// </summary>
    public class BBVAComun
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly IBBVAComunTomiDao _bbvaTomiDao;

        /// <summary>
        /// Constructor.
        /// </summary>
        public BBVAComun(
            ConfiguracionServicio configuracion,
            IBBVAComunTomiDao bbvaTomiDao)
        {
            _configuracion = configuracion;
            _bbvaTomiDao = bbvaTomiDao;
        }

        /// <summary>
        /// Genera TSEC para consumo de servicio BBVA.
        /// </summary>
        public async Task<TSECResponse> Generate_TSEC(
            string folio,
            GenerateTSEC objectTSECToSend,
            string rutaStore,
            string passwordStore,
            string timeout)
        {
            HttpWebRequest request;
            HttpWebResponse response = null;
            StreamReader reader;
            Stream postStream = null;
            TSEC objectResponse = null;
            ErrorResponse objectErrorResponse = new ErrorResponse();
            TSECResponse objectResponseFunction = new TSECResponse();
            string jsonOriginal;
            string jsonToSend;
            string jsonResponseOriginal;
            string tsec = string.Empty;

            ServicePointManager.Expect100Continue = true;
            ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072 | SecurityProtocolType.Tls | SecurityProtocolType.Ssl3 | (SecurityProtocolType)3072;
            ServicePointManager.ServerCertificateValidationCallback = new RemoteCertificateValidationCallback(AcceptAllCertifications);

            try
            {
                X509Certificate2Collection certificates = new X509Certificate2Collection();
                certificates.Import(rutaStore, passwordStore, X509KeyStorageFlags.MachineKeySet | X509KeyStorageFlags.PersistKeySet);

                string uriGenerateTsec = _configuracion.ParametrosSistema["URI_BBVA_GENERATE_TSEC"];
                if (string.IsNullOrWhiteSpace(uriGenerateTsec) &&
                    _configuracion.ParametrosSistema != null &&
                    _configuracion.ParametrosSistema.ContainsKey("URI_BBVA_GENERATE_TSEC"))
                {
                    uriGenerateTsec = _configuracion.ParametrosSistema["URI_BBVA_GENERATE_TSEC"];
                }

                if (string.IsNullOrWhiteSpace(uriGenerateTsec))
                    throw new ArgumentNullException("La URI Generate TSEC no es válida.");

                jsonOriginal = JsonConvert.SerializeObject(objectTSECToSend);
                jsonToSend = jsonOriginal.Replace("'", "''");

                await _bbvaTomiDao.ActualizarEnvioGenerateTsec(folio, jsonToSend);

                Config.EscribirLog("INFO|BBVA.Generate_TSEC|Empieza el proceso de generación de TSEC. Se actualizo el Json_Sent y Send_Date.");

                request = WebRequest.Create(uriGenerateTsec) as HttpWebRequest;
                request.Method = "POST";
                request.ContentType = "application/json";
                request.KeepAlive = false;
                request.AllowAutoRedirect = true;
                request.Accept = "application/json";
                request.ProtocolVersion = HttpVersion.Version11;

                Config.EscribirLog($"INFO|BBVA.Generate_TSEC|Certificados importados: {certificates.Count}");
                request.ClientCertificates = certificates;

                byte[] byteData = UTF8Encoding.UTF8.GetBytes(jsonToSend);
                request.ContentLength = byteData.Length;

                try
                {
                    postStream = request.GetRequestStream();
                    postStream.Write(byteData, 0, byteData.Length);
                }
                finally
                {
                    if (postStream != null)
                        postStream.Flush();

                    if (postStream != null)
                        postStream.Close();
                }

