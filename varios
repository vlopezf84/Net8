                    lbPorIntentar = true;

                    laValoresFormato[0] = operacion.nf_banco_benef;
                    laLlaveValor = Convert.ToString(laValoresFormato[0]).Split('-');
                    laValoresFormato[1] = laLlaveValor[0].Trim().Substring(2, 3);
                    laValoresFormato[2] = operacion.t24_debit_amount;
                    laValoresFormato[3] = flgNomina ? folioT24 + "-" + folio : folioT24;
                    laValoresFormato[4] = Strings.Mid(TextoTEF(operacion.t24_company_name), 1, 40);
                    laValoresFormato[5] = 40;
                    laValoresFormato[6] = CuentaClabe(operacion.t24_debit_acct_no);
                    laValoresFormato[7] = dameRFC_TEF(operacion.nf_rfc_ordenante);
                    laValoresFormato[8] = Strings.Mid(TextoTEF(operacion.t24_ben_cust_name), 1, 40);

                    if (DameTexto(operacion.nf_tipo_cuenta) == "CUENTA DE CHEQUES(CLABE)")
                        laValoresFormato[9] = "40";
                    else if (DameTexto(operacion.nf_tipo_cuenta) == "TARJETA DE DEBITO")
                        laValoresFormato[9] = "03";
                    else if (Information.IsNumeric(DameTexto(operacion.nf_tipo_cuenta)))
                        laValoresFormato[9] = operacion.nf_tipo_cuenta;

                    laValoresFormato[10] = operacion.t24_ben_acct_no;
                    laValoresFormato[11] = dameRFC_TEF(operacion.nf_rfc_beneficiario);

                    if (Strings.Mid(DameTexto(operacion.t24_debit_their_ref), 1, 40).Trim().ToUpper() == string.Empty)
                        laValoresFormato[12] = operacion.nf_folio_unico;
                    else
                        laValoresFormato[12] = Strings.Mid(TextoTEF(operacion.t24_debit_their_ref), 1, 40);

                    laValoresFormato[13] = operacion.nf_folio;
                    laValoresFormato[14] = DameTexto(operacion.nf_forex_relacionado);
                    laValoresFormato[15] = operacion.nf_tipo_operacion;
                    laValoresFormato[16] = operacion.nf_codigo_operacion;
                    laValoresFormato[17] = operacion.nf_fecha_cargo;
                    laValoresFormato[18] = operacion.nf_fecha_aplicacion;
                }

                if (lbPorIntentar)
                {
                    for (liIdx = 1; liIdx <= 18; liIdx++)
                        Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Valor[" + liIdx + "]=" + laValoresFormato[liIdx]);

                    Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Aperturando conexión a base de datos del TEF.");

                    Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Inicia ejecución de procedimiento de registro de TEF.");

                    TefRegistroResultadoDto resultadoRegistro = await _tefComunTefDao.RegistrarTefPresentado(
                        DameTexto(laValoresFormato[1]),
                        Convert.ToDecimal(laValoresFormato[2]),
                        DameTexto(laValoresFormato[3]),
                        DameTexto(laValoresFormato[4]),
                        DameTexto(laValoresFormato[5]),
                        DameTexto(laValoresFormato[6]),
                        DameTexto(laValoresFormato[7]),
                        DameTexto(laValoresFormato[8]),
                        DameTexto(laValoresFormato[9]),
                        DameTexto(laValoresFormato[10]),
                        DameTexto(laValoresFormato[11]),
                        DameTexto(laValoresFormato[12]),
                        DameTexto(laValoresFormato[15]),
                        DameTexto(laValoresFormato[16]),
                        Convert.ToInt32(laValoresFormato[17]),
                        Convert.ToInt32(laValoresFormato[18]));

                    if (resultadoRegistro == null)
                        throw new Exception("Error en registro de TEF");

                    lsCadena_Regreso =
                        DameTexto(resultadoRegistro.Result) + "|" +
                        DameTexto(resultadoRegistro.MasterId) + "|" +
                        DameTexto(resultadoRegistro.DetailId) + "|" +
                        DameTexto(resultadoRegistro.OperationDate) + "|" +
                        DameTexto(resultadoRegistro.OperationDescription);

                    Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Cadena_Regreso=" + lsCadena_Regreso);

                    Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Cerrando conexión a base de datos del TEF.");

                    if (resultadoRegistro.Result == 0)
                    {
                        lsFolioMto_TEF = DameTexto(resultadoRegistro.MasterId);
                        lsFolioDet_TEF = DameTexto(resultadoRegistro.DetailId);
                        lsFechaOper_TEF = DameTexto(resultadoRegistro.OperationDate);

                        Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Obtención de la información del registro TEF.");

                        await _tefComunTomiDao.ActualizarOperacionRegistroExitoso(
                            tabla,
                            folio,
                            Convert.ToInt64(lsFolioMto_TEF),
                            Convert.ToInt64(lsFolioDet_TEF),
                            Convert.ToInt32(lsFechaOper_TEF));
                    }
                    else if (resultadoRegistro.Result == 1)
                    {
                        await _tefComunTomiDao.MarcarOperacionRegistroError(tabla, folio);
                        throw new Exception("Error en registro de TEF");
                    }

                    Config.EscribirLog("INFO|Comunes.TEF_REGISTRO|Se termina procesamiento de Formato: " + folio);

                    return true;
                }
                else
                {
                    Config.EscribirLog("ERROR|Comunes.TEF_REGISTRO|El registro ya se intento registrar pero marco nf_interfase_spei=2 (problemas de registro)");
                    return false;
                }
            }
            catch (Exception lexErrorTEF_Registro)
            {
                Config.EscribirLog("ERROR|Comunes.TEF_REGISTRO|Se presenta exception: " + lexErrorTEF_Registro);
            }

            return false;
        }

        /// <summary>
        /// Ejecuta la operacion dameRFC_TEF.
        /// </summary>
        private string dameRFC_TEF(object texto)
        {
            string lsRFC;

            lsRFC = DameTexto(texto).Trim();

            if (lsRFC == string.Empty || lsRFC == "XEXX010101000")
                return "RFC NO DISPONIBLE";

            if (EsRFC(lsRFC))
                return lsRFC;

            return "RFC NO DISPONIBLE";
        }
    }
}

