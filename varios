        /// <summary>
        /// Ejecuta la operacion ReenviaCorreo.
        /// </summary>
        private async Task<bool> ReenviaCorreo(string folio, string informacionEmail)
        {
            bool result;
            int contadorReenvio = 0;
            DateTime fecEnvioCorreo = default(DateTime);
            string errorMensaje = string.Empty;

            try
            {
                List<Aplicacion.DTOs.Operaciones.TMD.CorreoErrorDto> infoREenvioCorreo = await _TMDDao.ObtenerFecEnvioCorreo(folio, tipoOperacion);
                if (infoREenvioCorreo == null || infoREenvioCorreo.Count == 0)
                {
                    Config.EscribirLog("INFO|No tiene filas el query(i.e. No hay bandera de error)");
                    return true;
                }

                if (ValidaQuerySinCoincidencias(infoREenvioCorreo))
                    return true;

                CorreoErrorDto info = infoREenvioCorreo.FirstOrDefault();

                if (!info.contador_reenvio.HasValue)
                    result = true;
                else
                {
                    contadorReenvio = info.contador_reenvio.Value + 1;
                    result = false;
                }

                if (string.IsNullOrEmpty(info.error))
                {
                    errorMensaje = "Error generico";
                    result = false;
                }
                else
                {
                    errorMensaje = info.error;
                    result = false;
                }

                if (!info.fec_envio_correo.HasValue)
                    result = true;
                else
                {
                    fecEnvioCorreo = info.fec_envio_correo.Value;
                    result = false;
                }

                if (result)
                    return true;

                if (!(contadorReenvio < 6))
                {
                    Config.EscribirLog("INFO|El contador es mayor que 5; Termino de notificaciones");
                    return false;
                }

                if (DateTime.Compare(DateTime.Now, fecEnvioCorreo.AddMinutes(5)) > 0)
                {
                    Config.EscribirLog("INFO|Tiempo de espera transcurrido;Se envía notificacion numero:" + contadorReenvio);

                    string subjectNotificacion = contadorReenvio < 5
                        ? "Notificacion de reenvio de correo: " + contadorReenvio
                        : "Notificacion de reenvio de correo(Termino de notificaciones): " + contadorReenvio;

                    Config.EscribirLog("INFO|Envia notificacion email numero: " + contadorReenvio);

                    CorreoHelper.EnviarCorreo(new MensajeCorreo()
                    {
                        CorreoOrigen = _correo[0],
                        NombreOrigen = _correo[1],
                        Para = _correo[2] + " ",
                        ConCopia = _correo[3],
                        CopiaOculta = null,
                        Asunto = _subjectCorreo + folio + " (" + contadorReenvio.ToString(CultureInfo.InvariantCulture) + ")",
                        Mensaje = "<html><body><p>" + _bodyCorreo + folio + ";</p> " +
                        informacionEmail +
                        "<br/>" +
                        "<p>Detalles de la operacion: </p>" +
                        "<ul><li>Error=" + errorMensaje + "</li></ul>" +
                        "<br/>" +
                        "<p>" + _pieDeNota + "</p>" +
                        "</body></html>"
                    });

                    Config.EscribirLog("INFO|Actualiza tabla con contador=" + contadorReenvio);

                    await ActualizaTablaDeErrores(folio, contadorReenvio);

                    result = false;
                }
                else
                {
                    Config.EscribirLog("INFO|No ha transcurrido el tiempo para el reenvio del correo");
                    result = false;
                }

                return result;
            }
            catch (Exception ex)
            {
                Config.EscribirLog("ERROR|Excepcion en ReenviaCorreo|Se presenta excepcion al intentar reenviar el error de mensaje de email: " + ex.Message);
                return false;
            }
        }

        /// <summary>
        /// Ejecuta la operacion ValidaQuerySinCoincidencias.
