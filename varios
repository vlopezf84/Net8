                    }
                }
                else
                {
                    if (funcOMetodoInvocante == FuncOMetodos.T24_REGISTRO)
                    {
                        string messageGeneralError = string.Empty;

                        if (response.Status.messages.Length > 0)
                        {
                            for (short cnt = 0; cnt <= response.Status.messages.Length - 1; cnt++)
                            {
                                messageGeneralError += response.Status.messages[cnt];

                                if (cnt != response.Status.messages.Length - 1)
                                    messageGeneralError += "|";
                            }
                        }

                        messageGeneralError = messageGeneralError.Replace("'", "''");

                        Config.EscribirLog("ERROR|autorizaLD|El servicio regresa respuesta con error al intentar autorizar. Se actualizan tablas de error. " + messageGeneralError);

                        messageAuthorization = "Respuesta no exitosa: " + messageGeneralError;

