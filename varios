        }

        /// <summary>
        /// Ejecuta la operacion GetNostro.
        /// </summary>
        private async Task<Result<string>> GetNostro(string currency, string bic)
        {
            if (string.IsNullOrWhiteSpace(bic))
                return Result<string>.Failed("No se supliÃ³ un BIC Beneficiario, posible error en registro del beneficiario.");

            if (ConversionHelper.EsNumerico(bic) && currency == _vwT24.MonedaDefaultMN)
                return Result<string>.Failed("El dato obtenido no es un BIC valido: " + bic);

            string bicToSearch = bic;

            try
            {
                if (currency != _vwT24.MonedaDefaultMN)
                {
                    Config.EscribirLog("INFO|Shared_FXI.getNostro|Moneda con corresponsal, se fuerza el corresponsal.");

                    switch (currency)
                    {
                        case "USD":
                            bicToSearch = "CHASUS33XXX";
                            break;
                        case "EUR":
                        case "GBP":
                            bicToSearch = "CHASGB2LXXX";
                            break;
                        case "JPY":
                            bicToSearch = "CHASJPJTXXX";
                            break;
                        case "CAD":
                            bicToSearch = "CHASCATTCTS";
                            break;
                    }
                }

                Config.EscribirLog("INFO|Shared_FXI.getNostro|A sanitizar el BIC: " + bicToSearch);
                bicToSearch = GetSanitizedFinancialInstitutionIdentifier(bicToSearch, IdentifierType.BIC11);
                Config.EscribirLog("INFO|Shared_FXI.getNostro|BIC sanitizado: " + bicToSearch);
                Config.EscribirLog("INFO|Shared_FXI.getNostro|A buscar la cuenta de crÃ©dito para '" + bicToSearch + "' en la moneda " + currency);

                FxiNostroDto nostro = await _fxiTomiDao.ObtenerNostro(bicToSearch, currency);

                if (nostro == null)
                {
                    Config.EscribirLog("INFO|Shared_FXI.getNostro|No se encontro ningun registro para la consulta.");
                    return Result<string>.Success(string.Empty);
                }

                string account = nostro.NostroAccountNumber;
                Config.EscribirLog("INFO|Shared_FXI.getNostro|Se encontro la cuenta: " + account);

                return string.IsNullOrWhiteSpace(account)
                    ? Result<string>.Failed(string.Empty)
                    : Result<string>.Success(account);
            }
            catch (Exception)
            {
                return Result<string>.Failed(string.Empty);
            }
        }

        /// <summary>
        /// Ejecuta la operacion SanitizeBic11.
        /// </summary>
        private string SanitizeBic11(string bic)
        {
            if (string.IsNullOrWhiteSpace(bic))
                return string.Empty;

            if (bic.Length == 8)
                return bic + "XXX";

            if (bic.Length == 11)
            {
                if (bic.Substring(0, 3) == T24SwiftPrefix)
                {
                    bic = bic.Substring(3);
                    return bic + "XXX";
                }

                return bic;
            }

            if (bic.Substring(0, 3) == T24SwiftPrefix)
            {
                bic = bic.Substring(3);
                return bic;
            }

            return string.Empty;
        }

        /// <summary>
        /// Ejecuta la operacion SanitizeBic8.
        /// </summary>
        private string SanitizeBic8(string bic)
        {
            if (string.IsNullOrWhiteSpace(bic))
                return string.Empty;

            if (bic.Length == 8)
                return bic;

            if (bic.Length == 11)
            {
                if (bic.Substring(0, 3) == T24SwiftPrefix)
                {
                    bic = bic.Substring(3);
                    return bic;
                }

                return bic.Substring(0, 8);
            }

            if (bic.Substring(0, 3) == T24SwiftPrefix)
            {
                bic = bic.Substring(3);
                return bic;
            }

            return string.Empty;
        }

        /// <summary>
        /// Ejecuta la operacion GetSanitizedFinancialInstitutionIdentifier.
        /// </summary>
        public string GetSanitizedFinancialInstitutionIdentifier(string identifier, IdentifierType identifierTypeToReturn = IdentifierType.BIC8)
        {
            if (ConversionHelper.EsNumerico(identifier))
                return identifier;

            switch (identifierTypeToReturn)
            {
                case IdentifierType.BIC8:
                    return SanitizeBic8(identifier);
                case IdentifierType.BIC11:
                    return SanitizeBic11(identifier);
            }

            return string.Empty;
        }

