                        laValoresFormato[9] = 40;
                    else if (DameTexto(operacion.nf_tipo_cuenta) == "TARJETA DE DEBITO")
                        laValoresFormato[9] = 3;
                    else if (Information.IsNumeric(DameTexto(operacion.nf_tipo_cuenta)))
