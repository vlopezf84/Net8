using MUFG_T24.Comunes;
using System;
using System.Globalization;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading.Tasks;

namespace Aplicacion.Servicios.Comunes
{
    /// <summary>
    /// Representa la funcionalidad de HSMComun.
    /// </summary>
    public class HSMComun
    {
        private const ushort BUFFER_SIZE = 2048;
        private const string gsPrefix = "PST";

        /// <summary>
        /// Desencripta los parámetros almacenados mediante HSM.
        /// Refactor 1:1 del método legacy DecryptParametersStore.
        /// </summary>
        public async Task<string> DecryptParametersStore(
            string encryptedDataNode,
            string lsPublicKey,
            string lsPort,
            string lsIPServer,
            string KCV)
        {
            string lsRequest = string.Empty;
            string lsResponse = string.Empty;
            string lsCommand = string.Empty;
            string lsPkci = string.Empty;
            string lsLengthKeyName = string.Empty;
            string lsLengthKCV = string.Empty;
            string lsKCV = string.Empty;
            string lsKeyIndicator = string.Empty;
            string lsAction = string.Empty;
            string lsAlgorithmType = string.Empty;
            string lsLengthEncryptedData;

            try
            {
                lsCommand = "0903"; // Encrypted and Deciphered with DES v3 - 0903
                lsPkci = "D"; // For claves DES externally souled
                lsLengthKeyName = Convert.ToString(lsPublicKey.Length).PadLeft(4, '0');
                lsKeyIndicator = "L07"; // Indicates that the key is encrypted with an LMK hosted on the HSM.
                lsKCV = KCV;
                lsLengthKCV = Convert.ToString(lsKCV.Length).PadLeft(2, '0');
                lsAction = "0"; // Zero indicates decrypting
                lsAlgorithmType = "1"; // OAEP
                lsLengthEncryptedData = Convert.ToString(encryptedDataNode.Length).PadLeft(6, '0');

                // Build complete command
                lsRequest =
                    lsCommand +
                    lsPkci +
                    lsLengthKeyName +
                    lsPublicKey +
                    lsKeyIndicator +
                    lsLengthKCV +
                    lsKCV +
                    lsAction +
                    lsAlgorithmType +
                    lsLengthEncryptedData +
                    encryptedDataNode;

                Config.EscribirLog("INFO|HSM.DecryptPasswordStore|Petición: " + lsRequest);

                lsResponse = await SendMessageSocket(lsIPServer, Convert.ToInt32(lsPort), GenerateShipmentHSM(lsRequest));

                Config.EscribirLog("INFO|HSM.DecryptPasswordStore|Respuesta: " + lsResponse);

                lsResponse = InterpretHSMResponse(lsResponse, lsCommand);

                Config.EscribirLog("INFO|HSM.DecryptPasswordStore|Respuesta final: " + lsResponse);
            }
            catch (Exception ex)
            {
                throw new Exception("Error al desencriptar datos HSM |" + ex.Message);
            }

            return lsResponse;
        }

        /// <summary>
        /// Consulta socket contra HSM.
        /// Refactor async del método legacy getResponse.
        /// </summary>
        public async Task<string> getResponse(string server, int port, string message)
        {
            // En VB: New Byte(BUFFER_SIZE) {} crea BUFFER_SIZE + 1 posiciones.
            byte[] bytes = new byte[BUFFER_SIZE + 1];
            string result;

            try
            {
                IPAddress ipAddress = IPAddress.Parse(server);
                IPEndPoint remoteEP = new IPEndPoint(ipAddress, port);

                using (Socket sender = new Socket(ipAddress.AddressFamily, SocketType.Stream, ProtocolType.Tcp))
                {
                    await Task.Factory.FromAsync(sender.BeginConnect, sender.EndConnect, remoteEP, null);

                    byte[] msg = Encoding.ASCII.GetBytes(message);

                    await Task.Factory.FromAsync(
                        sender.BeginSend(msg, 0, msg.Length, SocketFlags.None, null, null),
                        sender.EndSend);

                    int bytesRec = await Task.Factory.FromAsync(
                        sender.BeginReceive(bytes, 0, bytes.Length, SocketFlags.None, null, null),
                        sender.EndReceive);

                    result = Encoding.UTF8.GetString(bytes, 0, bytesRec);

                    sender.Shutdown(SocketShutdown.Both);
                    sender.Close();
                }
            }
            catch (Exception ex)
            {
                throw new Exception("Error consulta Socket |" + ex.Message);
            }

            return result;
        }

        /// <summary>
        /// Ejecuta la operacion InterpretHSMResponse.
        /// </summary>
        private string InterpretHSMResponse(string lsResponse, string lsCommand)
        {
            string responseCode = string.Empty;
            string result = string.Empty;

            try
            {
                ushort liTotalLenght = Convert.ToUInt16(lsResponse.Substring(0, 6));
                lsResponse = lsResponse.Substring(6);

                if (liTotalLenght == lsResponse.Length)
                {
                    lsResponse = lsResponse.Substring(gsPrefix.Length);
                    lsResponse = lsResponse.Substring(lsCommand.Length);

                    responseCode = lsResponse.Substring(0, 8);

                    if (responseCode == "00000000")
                    {
                        ushort length = Convert.ToUInt16(lsResponse.Substring(8, 6));
                        result = lsResponse.Substring(14);

                        if (length != result.Length)
                            throw new Exception("Error en la respuesta del HSM | HSM no devolvió cadena completa: " + result);
                    }
                    else
                        throw new Exception("Error en la respuesta del HSM | Código devuelto: " + responseCode);
                }
                else
                    throw new Exception("Error en la respuesta del HSM | Error al comparar el tamaño de la cadena devuelta");
            }
            catch (Exception ex)
            {
                throw new Exception("Error al interpretar resultado HSM |" + ex.Message);
            }

            return result;
        }

        /// <summary>
        /// Ejecuta la operacion SendMessageSocket.
        /// </summary>
        private async Task<string> SendMessageSocket(string server, int port, string message)
        {
            string lsReturn;
            lsReturn = await getResponse(server, port, message);
            return lsReturn;
        }

        /// <summary>
        /// Ejecuta la operacion GenerateShipmentHSM.
        /// </summary>
        private string GenerateShipmentHSM(string request)
        {
            string lsSendMessage;
            uint liLargo;
            string lsPeticion;

            lsSendMessage = gsPrefix + request;
            liLargo = Convert.ToUInt32(lsSendMessage.Length);
            lsPeticion = Convert.ToString(liLargo).PadLeft(6, '0') + lsSendMessage;

            Config.EscribirLog("INFO|HSM.GenerateShipmentHSM|Petición con Prefijo: " + lsPeticion);

            return lsPeticion;
        }

        /// <summary>
        /// Ejecuta la operacion Hex2Ascii.
        /// </summary>
        public string Hex2Ascii(string hextext)
        {
            long Y;
            string num;
            string value;

            value = string.Empty;

            for (Y = 1; Y <= hextext.Length; Y += 2)
            {
                num = hextext.Substring(Convert.ToInt32(Y - 1), 2);
                value = value + Convert.ToChar(Convert.ToInt32(num, 16));
            }

            return value;
        }

    }
}

