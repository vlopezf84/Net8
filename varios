            string messageAuthorization,
            string informacionEmail,
            FuncOMetodos funcOMetodoInvocante)
        {
            bool result = false;

            try
            {
                wsT24.T24WebServicesImplClient req = _t24ClientFactory();
                wsT24.callOfsRequest request = new wsT24.callOfsRequest();

                Config.EscribirLog($"INFO|{tipoOperacion}.autorizaLD|Se realiza peticion al servicio para autorizar LD {transactionId}");

                request.OfsRequest = _configuracion.ParametrosSistema["WST24_MW_MODULE_TMD"] + "," + _configuracion.ParametrosSistema["WST24_MW_VERSION_TMD"] + "/A/PROCESS," + _configuracion.ParametrosSistema["WST24_MW_USERNAME_AUT"] + "/" + _configuracion.ParametrosSistema["WST24_MW_PASSWORD_AUT"] + "," + transactionId;

                Config.EscribirLog($"INFO|{tipoOperacion}.autorizaLD|Se envia el OFS para autorizar: {request.OfsRequest}");

                wsT24.callOfsResponse response = await req.callOfsAsync(request);

                if (response.Status.successIndicator == wsT24.successIndicator.Success)
                {
                    if (response.OfsResponse.Contains(transactionId + "//1"))
