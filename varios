        /// <summary>
        /// Ejecuta la operacion _convierteTexto_a_Multivalor_SinCortar_Local.
        /// </summary>
        private List<string> _convierteTexto_a_Multivalor_SinCortar_Local(
            string texto,
            int MW_SeparadorMultivalorLength,
            ref int TotalLineas,
            bool Prefix = false)
        {
            string strCadena = string.Empty;
            List<string> retorno = new List<string>();
            string contenedor;

            texto = texto.Trim();

            while (texto.StartsWith("-", StringComparison.Ordinal))
            {
                texto = texto.Substring(1);
                texto = texto.Trim();
            }

            if (texto.Length == 0)
                return retorno;

            if (texto.Length <= MW_SeparadorMultivalorLength)
            {
                if (Prefix)
                    strCadena = "//" + texto;
                else
                    retorno.Add(texto);

                TotalLineas = 1;
                return retorno;
            }

            contenedor = string.Empty;
            bool blnAux = false;
            int intCont = 0;
            string[] arreglo = texto.Split(' ');

            foreach (string palabra in arreglo)
            {
                string palabraTemp = string.Empty;

                if (!blnAux)
                {
                    if (arreglo.Length > intCont + 1)
                    {
                        if (arreglo[intCont + 1].ToString().StartsWith("-", StringComparison.Ordinal))
                        {
                            palabraTemp = arreglo[intCont];
                            blnAux = false;
                        }
                        else
                            palabraTemp = arreglo[intCont];
                    }
                    else
                        palabraTemp = arreglo[intCont];

                    if (palabraTemp.Length >= MW_SeparadorMultivalorLength)
                    {
                        if (contenedor.Length > 0)
                        {
                            retorno.Add(contenedor);
                            contenedor = string.Empty;
                        }

                        do
                        {
                            string trozo = palabraTemp.Substring(0, MW_SeparadorMultivalorLength);
                            retorno.Add(trozo);
                            palabraTemp = palabraTemp.Remove(0, MW_SeparadorMultivalorLength);
                        }
                        while (palabraTemp.Length >= MW_SeparadorMultivalorLength);
                    }

                    if (palabraTemp.Length > 0)
                    {
                        if (contenedor.Length + palabraTemp.Length + 1 > MW_SeparadorMultivalorLength)
                        {
                            retorno.Add(contenedor);
                            contenedor = palabraTemp;
                        }
                        else
                        {
                            if (contenedor == string.Empty)
                                contenedor = palabraTemp;
                            else
                                contenedor = contenedor + " " + palabraTemp;
                        }
                    }
                }
                else
                    blnAux = false;

                intCont++;
            }

            if (contenedor.Length > 0)
                retorno.Add(contenedor);

            foreach (string elemento in retorno)
            {
                if (Prefix)
                    strCadena += "//" + elemento + "|";
                else
                    strCadena += elemento + "|";
            }

            strCadena = strCadena.Substring(0, strCadena.Length - 1);
            TotalLineas = retorno.Count;
            return retorno;
        }

