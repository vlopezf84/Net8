public async Task<string> SendReceiveAsync(string host, int port, string message, TimeSpan timeout, CancellationToken ct)
{
    using (var client = new TcpClient())
    {
        await client.ConnectAsync(host, port).WithTimeout(timeout, ct).ConfigureAwait(false);
        var stream = client.GetStream();
        var bytes = Encoding.ASCII.GetBytes(message);
        await stream.WriteAsync(bytes, 0, bytes.Length, ct).ConfigureAwait(false);
        return await ReadFramedAsync(stream, timeout, ct).ConfigureAwait(false);   // 6-digit length prefix, see CHR-FR-17
    }
}
