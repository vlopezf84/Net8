using Aplicacion.Enums;
using Aplicacion.Interfaces.Operaciones.ENT_SPEI;
using Aplicacion.Modelos;
using AplicacionT24.DTOs.Operaciones.ENT_SPEI;
using MUFG_T24.Comunes;
using MUFG_T24.Interfaces_utilidades;
using MUFG_T24.Modelos;
using MUFG_T24.Repositorios;
using System;
using System.Data;
using System.Threading.Tasks;
using static MUFG_T24.Comunes.Comunes;

namespace Aplicacion.Servicios.Operaciones
{
    /// <summary>
    /// Representa la funcionalidad de ENT_SPEI.
    /// </summary>
    public class ENT_SPEI
    {
        private readonly ConfiguracionServicio _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IEntSpeiTomiDao _entSpeiTomiDao;
        private readonly IEntSpeiVistasT24Dao _entSpeiVistasT24Dao;
        private readonly ConexionT24Mw _vwT24;

        private MW_Tipo_operacion mwTipoOperacion;

        private const string tipoOperacion = "ENT_SPEI";
        private string folioUnico = "";

        /// <summary>
        /// Constructor.
        /// </summary>
        public ENT_SPEI(
            ConfiguracionServicio configuracion,
            IControlServicio controlServicio,
            IEntSpeiTomiDao entSpeiTomiDao,
            IEntSpeiVistasT24Dao entSpeiVistasT24Dao,
            ConexionT24Mw vwT24)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _entSpeiTomiDao = entSpeiTomiDao;
            _entSpeiVistasT24Dao = entSpeiVistasT24Dao;
            _vwT24 = vwT24;
        }

        /// <summary>
        /// Procesa la operación ENT_SPEI.
        /// </summary>
        public async Task<bool> ProcesaOperacion(string folio)
        {
            string fechaEjecucion;
            decimal importeTomi;
            string moneda;
            string cuentaDebito;
            string cuentaCredito;
            string cuentaCreditoT24;
            string tipo;
            bool fechaFutura;
            bool procesado;
            string folioT24;
            bool esIgualEnT24;

            // Verificamos la última operación no realizada...
            _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

            if (string.Equals(_configuracion.AliasProceso, "", StringComparison.Ordinal))
                return false;

            Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Inicia proceso folio={folio}.");

            // Obtención de los datos de la familia de la operación...
            mwTipoOperacion = await _vwT24.ObtenerMWDatosOperacion(tipoOperacion);

            // Inicio de variables...
            fechaEjecucion = _configuracion.FechaSistema;
            moneda = _vwT24.MonedaDefaultMN;
            importeTomi = 0m;
            cuentaDebito = "";
            cuentaCredito = "";
            cuentaCreditoT24 = "";
            tipo = "";

            // Datos de la operación...
            EntSpeiDatosOperacionTomiDto datosOperacion = await _entSpeiTomiDao.ObtenerDatosOperacion(
                mwTipoOperacion.tabla_trabajo,
                folio);

            if (datosOperacion != null)
            {
                importeTomi = datosOperacion.OpMonto;
                tipo = DameTexto(datosOperacion.TpClave);

                cuentaDebito = _vwT24.T24_BanxicoAcct;

                if (string.Equals(tipo, "31", StringComparison.Ordinal))
                {
                    cuentaCredito = "0";
                }
                else
                {
                    cuentaCredito = _vwT24.DameCuentaMufg(DameTexto(datosOperacion.OpCuentaBen));
                }

                // Cuenta de 20 dígitos...
                if (cuentaCredito.Length == 20 && cuentaCredito.StartsWith("00108", StringComparison.Ordinal))
                {
                    cuentaCredito = cuentaCredito.Substring(12, 7);
                }
                else
                {
                    string cuentaCreditoNumerica = DameTexto(Convert.ToInt64(cuentaCredito));

                    switch (cuentaCreditoNumerica.Length)
                    {
                        case 7:
                            cuentaCredito = cuentaCreditoNumerica;
                            break;

                        case 12:
                            cuentaCredito = MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaCreditoNumerica, 6);
                            break;

                        case 18:
                            cuentaCredito = _vwT24.DameCuentaMufg(Mid(cuentaCreditoNumerica, cuentaCreditoNumerica.Length - 17, 18));
                            break;

                        default:
                            cuentaCredito = _vwT24.DameCuentaMufg(datosOperacion.T24CreditAcctNo);
                            break;
                    }
                }

                if (string.Equals(cuentaCredito, "0", StringComparison.Ordinal))
                    cuentaCredito = DameTexto(datosOperacion.T24CreditAcctNo);

                cuentaCreditoT24 = DameTexto(datosOperacion.T24CreditAcctNo);
                folioUnico = DameTexto(datosOperacion.NfFolioUnico);
            }

            if (string.Equals(tipo, "0", StringComparison.Ordinal))
                tipo = "D";

            // Sigo con el proceso...
            if (string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) < 0)
            {
                throw new Exception(
                    $"Se desea realizar una operación al {fechaEjecucion} cuando la fecha del sistema es {_configuracion.FechaSistema}.");
            }

            // Datos de la operación...
            await _entSpeiTomiDao.ActualizarDatosMaestroLectura(
                folio,
                fechaEjecucion,
                moneda,
                importeTomi);

            // Fecha futura?
            fechaFutura = string.CompareOrdinal(fechaEjecucion, _configuracion.FechaSistema) > 0;

            if (fechaFutura)
            {
                // Actualizo estatus general de la operación a Fecha futura...
                await _entSpeiTomiDao.ActualizarEstatusFechaFutura(folio);
            }
            else
            {
                // Lectura y actualización de los datos del maestro...
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.DatosGral, StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Actualizando los datos del plan de trabajo maestro (estatus, etc).");

                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    procesado = false;

                    // Query de actualización...
                    await _entSpeiTomiDao.ActualizarEstatusT24(folio);
                    procesado = true;

                    if (procesado)
                    {
                        // Actualizo el estatus...
                        await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                        // Verificamos la última operación no realizada.
                        // Debe ser T24_REGISTRO...
                        _configuracion.AliasProceso = await _controlServicio.ObtenerUltimoProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });
                    }
                    else
                    {
                        throw new Exception($"Error en procesamiento de registro DATOS_GRAL con folio: {folio}");
                    }
                }

                // Registro de la operación en Middleware-T24...
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.T24Registro, StringComparison.Ordinal))
                {
                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A realizar el registro de la operación en T24.");

                    // Envía la solicitud de registro a T24...
                    if (string.Equals(tipo, "31", StringComparison.Ordinal))
                        procesado = await T24_REGISTRO_ESP("SPEI_ESPECIAL", folio);
                    else
                        procesado = await T24_REGISTRO(folio, tipo);

                    if (procesado)
                        Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|Se insertó correctamente el folio en base de TOMI.");
                    else
                        throw new Exception($"Error en procesamiento de T24_REGISTRO con folio: {folio}");

                    return false;

                    // Ya no llegaría a esta sección del código de T24_REGISTRO,
                    // ya que la actualización de terminación de tarea la realiza el TRG de la operación procesada.
                }

                // Conciliación...
                if (string.Equals(_configuracion.AliasProceso, ConstantesAliasProceso.Conciliar, StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.procesaOperacion|A conciliar operaciones (por estatus) entre TOMI y T24.");

                    await _controlServicio.IniciaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    // Busco la operación en T24...
                    folioT24 = await _vwT24.ObtenerFolioAsignado(folioUnico);

                    if (folioT24 is null)
                        throw new Exception($"No existe folio asignado para el folio_unico='{folioUnico}'");

                    // Valida contra los datos de TOMI - T24...
                    esIgualEnT24 = false;

                    EntSpeiFundsTransferT24Dto datosT24 = await _entSpeiVistasT24Dao.ObtenerFundsTransferPorCurId(folioT24);

                    if (datosT24 is null)
                        throw new Exception($"No existe la transferencia en T24 para CUR_ID='{folioT24}'.");

                    if (string.Equals(tipo, "31", StringComparison.Ordinal))
                        cuentaCredito = "MXN" + cuentaCredito;

                    decimal importeT24 = datosT24.DebitAmount;

                    string validacion;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                    {
                        validacion =
                            "Los datos de conciliación entre TOMI y T24 son diferentes - " +
                            $"{folioT24}={datosT24.CurId} " +
                            $"{folioUnico}={datosT24.SatelSysRef} " +
                            $"{moneda}={datosT24.DebitCurrency} " +
                            $"{importeTomi}={datosT24.DebitAmount} " +
                            $"{_vwT24.T24_BanxicoAcct}={datosT24.DebitAcctNo} " +
                            $"{cuentaCreditoT24}={datosT24.CreditAcctNo}";

                        if (string.Equals(folioT24, datosT24.CurId, StringComparison.Ordinal) &&
                            string.Equals(folioUnico, datosT24.SatelSysRef, StringComparison.Ordinal) &&
                            importeTomi == importeT24 &&
                            string.Equals(moneda, datosT24.DebitCurrency, StringComparison.Ordinal) &&
                            string.Equals(_vwT24.T24_BanxicoAcct, datosT24.DebitAcctNo, StringComparison.Ordinal) &&
                            string.Equals(cuentaCreditoT24, datosT24.CreditAcctNo, StringComparison.Ordinal))
                        {
                            esIgualEnT24 = true;
                        }
                    }
                    else
                    {
                        validacion =
                            "Los datos de conciliación entre TOMI y T24 son diferentes - " +
                            $"{folioT24}={datosT24.CurId} " +
                            $"{folioUnico}={datosT24.SatelSysRef} " +
                            $"{moneda}={datosT24.DebitCurrency} " +
                            $"{importeTomi}={datosT24.DebitAmount} " +
                            $"{_vwT24.T24_BanxicoAcct}={datosT24.DebitAcctNo} " +
                            $"{cuentaCredito}={datosT24.CreditAcctNo}";

                        if (string.Equals(folioT24, datosT24.CurId, StringComparison.Ordinal) &&
                            string.Equals(folioUnico, datosT24.SatelSysRef, StringComparison.Ordinal) &&
                            importeTomi == importeT24 &&
                            string.Equals(moneda, datosT24.DebitCurrency, StringComparison.Ordinal) &&
                            string.Equals(_vwT24.T24_BanxicoAcct, datosT24.DebitAcctNo, StringComparison.Ordinal) &&
                            string.Equals(cuentaCredito, datosT24.CreditAcctNo, StringComparison.Ordinal))
                        {
                            esIgualEnT24 = true;
                        }
                    }

                    if (!esIgualEnT24)
                        throw new Exception(validacion);

                    // Actualización de la fecha de autorización...
                    string fechaAutorizacion =
                        _configuracion.FechaSistema.Substring(0, 4) + "/" +
                        _configuracion.FechaSistema.Substring(4, 2) + "/" +
                        _configuracion.FechaSistema.Substring(6, 2);

                    await _entSpeiTomiDao.ActualizarFechaAutorizacion(
                        mwTipoOperacion.tabla_trabajo,
                        folio,
                        fechaAutorizacion);

                    // Actualizo el estatus...
                    await _controlServicio.TerminaProceso(new ProcesoDTO { Folio = folio, TipoOperacion = tipoOperacion, Servicio = _configuracion.NombreServicio, NombreProceso = _configuracion.NombreProceso, AliasProceso = _configuracion.AliasProceso, PId = _configuracion.Pid.Value });

                    // Verificamos la última operación no realizada...
                    _configuracion.AliasProceso = "";
                }
            }

            // Termina el proceso del folio...
            return true;
        }

        /// <summary>
        /// Ejecuta la operacion T24_REGISTRO.
        /// </summary>
        private async Task<bool> T24_REGISTRO(string folio, string tipo)
        {
            try
            {
                MwT24TrxMaestro trxMaster = null;
                MwT24TrxDetalle trxDetail = null;

                bool encontradoTomi;
                string instructions;

                // Inicio variables...
                encontradoTomi = false;
                instructions = "";

                // Búsqueda de la operación...
                EntSpeiRegistroT24TomiDto datos = await _entSpeiTomiDao.ObtenerDatosRegistroT24(
                    mwTipoOperacion.tabla_trabajo,
                    folio);

                if (datos != null)
                {
                    encontradoTomi = true;

                    // Forex relacionado...
                    // forexRelacionado = DameTexto(datos.NfForexRelacionado);

                    // Descripción proporcionada por el cliente...
                    instructions = "SPEI RECIBIDO a CUENTA/CLABE: " + DameTexto(datos.OpCuentaBen);

                    if (!string.Equals(DameTexto(datos.OpNomOrd), "", StringComparison.Ordinal))
                        instructions += " ORDENANTE: " + DameTexto(datos.OpNomOrd);

                    if (!string.Equals(DameTexto(datos.NfBancoBenef), "", StringComparison.Ordinal))
                        instructions += " BANCO ORDENANTE: " + DameTexto(datos.NfBancoBenef);

                    if (!string.Equals(DameTexto(datos.OpNomBen), "", StringComparison.Ordinal))
                        instructions += " BENEFICIARIO: " + DameTexto(datos.OpNomBen);

                    if (!string.Equals(DameTexto(datos.OpCveRastreo), "", StringComparison.Ordinal))
                        instructions += " CLAVE DE RASTREO: " + DameTexto(datos.OpCveRastreo).Trim();

                    if (!string.Equals(DameTexto(datos.OpConceptoPag2), "", StringComparison.Ordinal))
                        instructions += " CONCEPTO: " + DameTexto(datos.OpConceptoPag2).Trim();

                    if (!string.Equals(DameTexto(datos.OpRefNumerica), "", StringComparison.Ordinal))
                        instructions += " NUMERO DE REFERENCIA: " + DameTexto(datos.OpRefNumerica).Trim();

                    // Preparamos los datos para el registro de la transacción...
                    trxMaster = new MwT24TrxMaestro();

                    trxMaster.STrxOperationSpecificType = tipoOperacion;
                    trxMaster.STrxOperationSubType = "COM_ENVIO";
                    trxMaster.STrxOperationFolio = folio;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                    {
                        string cuentaOrdenante = DameTexto(Convert.ToInt64(datos.OpCuentaOrd));

                        switch (cuentaOrdenante.Length)
                        {
                            case 7:
                                trxMaster.STrxOperationAcct = cuentaOrdenante;
                                break;

                            case 12:
                                trxMaster.STrxOperationAcct = MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaOrdenante, 6);
                                break;

                            case 18:
                                trxMaster.STrxOperationAcct = _vwT24.DameCuentaMufg(Mid(cuentaOrdenante, cuentaOrdenante.Length - 17, 18));
                                break;
                        }
                    }
                    else
                    {
                        string cuentaBeneficiario = DameTexto(Convert.ToInt64(datos.OpCuentaBen));

                        switch (cuentaBeneficiario.Length)
                        {
                            case 7:
                                trxMaster.STrxOperationAcct = cuentaBeneficiario;
                                break;

                            case 12:
                                trxMaster.STrxOperationAcct = MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaBeneficiario, 6);
                                break;

                            case 18:
                                trxMaster.STrxOperationAcct = _vwT24.DameCuentaMufg(Mid(cuentaBeneficiario, cuentaBeneficiario.Length - 17, 18));
                                break;
                        }
                    }

                    trxDetail = new MwT24TrxDetalle();

                    string theirRef = string.Empty;

                    if (DameTexto(datos.T24DebitTheirRef).Trim().Length <= 16)
                        theirRef = DameTexto(datos.T24DebitTheirRef).Trim();
                    else
                        theirRef = DameTexto(datos.T24DebitTheirRef).Trim().Substring(0, 16);

                    Config.EscribirLog($"INFO|{tipoOperacion}.t24_debit_their_ref={theirRef}");

                    trxDetail.SBeneficiary = TextoSPEI(DameTexto(datos.OpNomBen));

                    trxDetail.SDebit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SDebit_amount = string.Format("{0:0.##}", datos.T24DebitAmount);

                    trxDetail.SDebit_their_ref = TextoBESS(theirRef);
                    trxDetail.SCredit_their_ref = folio;
                    trxDetail.SDebit_acct_no = _vwT24.T24_BanxicoAcct;

                    if (string.Equals(tipo, "D", StringComparison.Ordinal))
                    {
                        trxDetail.SOrdering_cust =
                            string.Equals(DameTexto(datos.OpNomBen), "", StringComparison.Ordinal)
                                ? "ND"
                                : Mid(_vwT24.ConvierteTextoAMultivalor(DameTexto(TextoSPEI(DameTexto(datos.OpNomBen))).TrimEnd(), 35).ToUpper(), 1, 140);

                        string cuentaOrdenante = DameTexto(Convert.ToInt64(datos.OpCuentaOrd));

                        switch (cuentaOrdenante.Length)
                        {
                            case 7:
                                trxDetail.SCredit_acct_no = cuentaOrdenante;
                                break;

                            case 12:
                                trxDetail.SCredit_acct_no = MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaOrdenante, 6);
                                break;

                            case 18:
                                trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(Mid(cuentaOrdenante, cuentaOrdenante.Length - 17, 18));
                                break;

                            default:
                                trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(datos.T24CreditAcctNo);
                                break;
                        }
                    }
                    else
                    {
                        trxDetail.SOrdering_cust =
                            string.Equals(DameTexto(datos.OpNomOrd), "", StringComparison.Ordinal)
                                ? "ND"
                                : Mid(_vwT24.ConvierteTextoAMultivalor(DameTexto(TextoSPEI(DameTexto(datos.OpNomOrd))).TrimEnd(), 35).ToUpper(), 1, 140);

                        string cuentaBeneficiario = DameTexto(Convert.ToInt64(datos.OpCuentaBen));

                        switch (cuentaBeneficiario.Length)
                        {
                            case 7:
                                trxDetail.SCredit_acct_no = cuentaBeneficiario;
                                break;

                            case 12:
                                trxDetail.SCredit_acct_no = MUFG_T24.Comunes.Helpers.ConversionHelper.Mid(cuentaBeneficiario, 6);
                                break;

                            case 18:
                                trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(Mid(cuentaBeneficiario, cuentaBeneficiario.Length - 17, 18));
                                break;

                            default:
                                trxDetail.SCredit_acct_no = _vwT24.DameCuentaMufg(datos.T24CreditAcctNo);
                                break;
                        }
                    }

                    trxDetail.SCredit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SInstructions = DameTexto(instructions).TrimEnd();
                    trxDetail.SSatelSysRef = folioUnico;
                    trxDetail.SFolio_tomi = folioUnico;
                    trxDetail.Cust_Ref1 = DameTexto(datos.T24CustRef1);
                    trxDetail.Cust_Ref2 = DameTexto(datos.T24CustRef2);
                    trxDetail.Cust_Ref3 = DameTexto(datos.T24CustRef3);
                    trxDetail.Cust_Ref4 = DameTexto(datos.T24CustRef4);
                    trxDetail.Cust_Ref5 = DameTexto(datos.T24CustRef5);
                    trxDetail.SProfit_centre_cust = datos.T24CustomerCode;
                }

                if (!encontradoTomi)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                // Termina definición de parámetros y hace el llamado...
                return await _vwT24.RegistraTrx(
                    folioUnico,
                    MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                    mwTipoOperacion.tabla_trabajo,
                    tipoOperacion,
                    folio,
                    mwTipoOperacion.T24_Operation_ID,
                    trxDetail,
                    trxMaster
                    );
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO|Se presenta exception: {ex}");
            }

            return false;
        }

        /// <summary>
        /// Ejecuta la operacion T24_REGISTRO_ESP.
        /// </summary>
        private async Task<bool> T24_REGISTRO_ESP(string tipoOperacionRegistro, string folio)
        {
            try
            {
                MwT24TrxMaestro trxMaster = null;
                MwT24TrxDetalle trxDetail = null;

                bool encontradoTomi;
                bool validadoForex;
                string forexRelacionado;
                string instructions;
                string cuentaDebito;
                string cuentaCredito;
                string beneficiario;
                string externalRef;
                string familyDesc;
                string categoriaT24;
                string cuentaPuente;
                string nombreMufg;
                string t24OpSubtipo;
                double monto;
                bool conError;
                string errorDesc;

                // Inicio variables...
                conError = false;
                errorDesc = string.Empty;
                validadoForex = false;
                encontradoTomi = false;
                forexRelacionado = string.Empty;
                cuentaCredito = string.Empty;
                cuentaDebito = string.Empty;
                t24OpSubtipo = string.Empty;
                beneficiario = string.Empty;
                familyDesc = string.Empty;
                instructions = string.Empty;

                // Nombre MUFG...
                nombreMufg = "";

                DataTable datosCliente = await _vwT24.DatosClienteVw2(_vwT24.T24_MUFG_CDL);

                if (datosCliente.Rows.Count > 0)
                    nombreMufg = datosCliente.Rows[0]["COMPANY_NAME"].ToString();

                datosCliente.Dispose();

                // Búsqueda de la operación...
                EntSpeiRegistroEspecialTomiDto datos = await _entSpeiTomiDao.ObtenerDatosRegistroEspecial(
                    mwTipoOperacion.tabla_trabajo,
                    folio);

                if (datos != null)
                {
                    encontradoTomi = true;
                    conError = false;
                    errorDesc = "";

                    // Datos para efectuar el FT...
                    externalRef = DameTexto(datos.OpRefNumerica);
                    monto = Convert.ToDouble(datos.T24DebitAmount);

                    // Forex relacionado...
                    // forexRelacionado = DameTexto(datos.NfForexRelacionado);

                    // SInstructions...
                    familyDesc = "OPERACION DE MERCADO ESPECIAL";
                    instructions = familyDesc + " ORDEN: " + externalRef + ".";

                    // Cálculo de la cuenta puente...
                    categoriaT24 = "12495";
                    cuentaPuente = ArmaCuentaPuente(_vwT24.MonedaDefaultMN, categoriaT24);

                    // Cálculo de cuentas débito y crédito...
                    cuentaDebito = _vwT24.T24_BanxicoAcct;
                    cuentaCredito = cuentaPuente;
                    t24OpSubtipo = "SPEI_ESPECIAL";
                    beneficiario = nombreMufg;

                    // Ajuste SInstructions...
                    instructions += " ENTRADA SPEI.";

                    // Preparamos los datos para el registro de la transacción...
                    trxMaster = new MwT24TrxMaestro();

                    string theirRef = string.Empty;

                    if (DameTexto(datos.T24DebitTheirRef).Trim().Length <= 16)
                        theirRef = DameTexto(datos.T24DebitTheirRef).Trim();
                    else
                        theirRef = DameTexto(datos.T24DebitTheirRef).Trim().Substring(0, 16);

                    Config.EscribirLog($"INFO|{tipoOperacionRegistro}.T24_REGISTRO_ESP|t24_debit_their_ref={theirRef}");

                    trxMaster.STrxOperationSpecificType = "MD";
                    trxMaster.STrxOperationSubType = t24OpSubtipo;
                    trxMaster.STrxOperationFolio = folio;
                    trxMaster.STrxOperationAcct = cuentaDebito;

                    trxDetail = new MwT24TrxDetalle();

                    trxDetail.SDebit_acct_no = cuentaDebito;
                    trxDetail.SDebit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SDebit_amount = string.Format("{0:0.##}", monto);
                    trxDetail.SDebit_their_ref = TextoBESS(theirRef);
                    trxDetail.SCredit_their_ref = folio;
                    trxDetail.SCredit_acct_no = cuentaCredito;
                    trxDetail.SCredit_currency = _vwT24.MonedaDefaultMN;
                    trxDetail.SOrdering_cust = "BANCO DE MEXICO";
                    trxDetail.SBeneficiary = _vwT24.ConvierteTextoAMultivalor(beneficiario, 35);
                    trxDetail.SInstructions = instructions;
                    trxDetail.SSatelSysRef = folioUnico;
                    trxDetail.SFolio_tomi = folioUnico;
                    trxDetail.SProfit_centre_cust = _vwT24.T24_MUFG_CDL;
                }

                if (!encontradoTomi)
                    throw new Exception("El registro no fue localizado en TOMI (posiblemente cambio de estatus)");

                if (conError)
                {
                    Config.EscribirLog($"ERROR|{tipoOperacion}.T24_REGISTRO_ESP|{errorDesc}");
                    throw new Exception(errorDesc);
                }

                // Forex relacionado y/o autorizado...
                if (string.Equals(forexRelacionado, "", StringComparison.Ordinal))
                {
                    Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO_ESP|Formato sin FX.");
                    validadoForex = true;
                }

                if (validadoForex)
                {
                    // Termina definición de parámetros y hace el llamado...
                    return await _vwT24.RegistraTrx(
                        folioUnico,
                        MUFG_T24.Aplicacion.Conversiones.ConversionesComunes.ParseEnteroRequerido(_configuracion.FechaSistemaJulianaT24, "FechaSistemaJulianaT24"),
                        mwTipoOperacion.tabla_trabajo,
                        tipoOperacionRegistro,
                        folio,
                        mwTipoOperacion.T24_Operation_ID,
                        trxDetail,
                        trxMaster
                        );
                }

                Config.EscribirLog($"INFO|{tipoOperacion}.T24_REGISTRO|No se puede seguir con el proceso de registro de la operación.");

                return false;
            }
            catch (Exception ex)
            {
                Config.EscribirLog($"ERROR|ENT_SPEI.T24_REGISTRO|Se presenta exception: {ex}");
            }

            return false;
        }

        /// <summary>
        /// Ejecuta la operacion ArmaCuentaPuente.
        /// </summary>
        private string ArmaCuentaPuente(string moneda, string categoria)
        {
            return moneda + categoria + "0001";
        }

}
