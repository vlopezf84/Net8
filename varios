                    Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Inicia ejecución de procedimiento de registro de SPEI.");

                    SpeiRegistroResultadoDto resultadoRegistro;

                    switch (tipoPago)
                    {
                        case 1:
                            Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Tercero a tercero.");
                            resultadoRegistro = await speiDao.RegistrarSpeiTipo1(
                                Convert.ToInt64(laValoresFormato[1]),
                                Convert.ToDecimal(laValoresFormato[2]),
                                DameTexto(laValoresFormato[3]),
                                DameTexto(laValoresFormato[4]),
                                Convert.ToInt16(laValoresFormato[5]),
                                DameTexto(laValoresFormato[6]),
                                DameTexto(laValoresFormato[7]),
                                DameTexto(laValoresFormato[8]),
                                Convert.ToInt16(laValoresFormato[9]),
                                DameTexto(laValoresFormato[10]),
                                DameTexto(laValoresFormato[11]),
                                DameTexto(laValoresFormato[12]),
                                Convert.ToInt32(laValoresFormato[13]),
                                2,
                                DameTexto(laValoresFormato[15]));
                            break;

                        case 5:
                            Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Participante a tercero.");
                            resultadoRegistro = await speiDao.RegistrarSpeiTipo5(
                                Convert.ToInt64(laValoresFormato[1]),
                                Convert.ToDecimal(laValoresFormato[2]),
                                DameTexto(laValoresFormato[3]),
                                DameTexto(laValoresFormato[8]),
