                                DameTexto(laValoresFormato[15]));
                            break;

                        case 6:
                            Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Participante a vostro.");
                            resultadoRegistro = await speiDao.RegistrarSpeiTipo6(
                                Convert.ToInt64(laValoresFormato[1]),
                                Convert.ToDecimal(laValoresFormato[2]),
                                DameTexto(laValoresFormato[3]),
                                DameTexto(laValoresFormato[8]),
                                Convert.ToInt16(laValoresFormato[9]),
                                DameTexto(laValoresFormato[10]),
                                DameTexto(laValoresFormato[11]),
                                DameTexto(laValoresFormato[12]),
                                Convert.ToInt32(laValoresFormato[13]),
                                2,
                                DameTexto(laValoresFormato[15]));
                            break;

                        case 7:
                            Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Participante a participante.");
                            resultadoRegistro = await speiDao.RegistrarSpeiTipo7(
                                Convert.ToInt64(laValoresFormato[1]),
                                Convert.ToDecimal(laValoresFormato[2]),
                                DameTexto(laValoresFormato[3]),
                                DameTexto(laValoresFormato[12]),
                                Convert.ToInt32(laValoresFormato[13]),
                                2,
                                DameTexto(laValoresFormato[15]));
                            break;

                        default:
                            throw new Exception("No existe definición para pago SPEI del tipo de pago " + tipoPago);
                    }

                    if (resultadoRegistro == null)
                        throw new Exception("Error en registro de SPEI");

                    lsCadena_Regreso =
                        DameTexto(resultadoRegistro.Result) + "|" +
                        DameTexto(resultadoRegistro.OperationClave) + "|" +
                        DameTexto(resultadoRegistro.OperationDate) + "|" +
                        DameTexto(resultadoRegistro.OperationFolio) + "|" +
                        DameTexto(resultadoRegistro.OperationDescription);

                    Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Cadena_Regreso=" + lsCadena_Regreso);

                    if (resultadoRegistro.Result == 0)
                    {
                        lsClave_SPEI = DameTexto(resultadoRegistro.OperationClave);
                        lsFechaOper_SPEI = DameTexto(resultadoRegistro.OperationDate);
                        lsFolio_SPEI = DameTexto(resultadoRegistro.OperationFolio);

                        Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Obtención de la información del registro SPEI.");

                        await _speiComunTomiDao.ActualizarOperacionRegistroExitoso(
                            tabla,
                            folio,
                            Convert.ToInt64(lsClave_SPEI),
                            Convert.ToInt32(lsFechaOper_SPEI),
                            Convert.ToInt32(lsFolio_SPEI));
                    }
                    else if (resultadoRegistro.Result == 1)
                    {
                        await _speiComunTomiDao.MarcarOperacionRegistroError(tabla, folio);
                        throw new Exception("Error en registro de SPEI");
                    }

                    Config.EscribirLog("INFO|Comunes.SPEI_REGISTRO|Cerrando conexión a base de datos del SPEI.");

                    return true;
                }
                else
                {
                    Config.EscribirLog("ERROR|Comunes.SPEI_REGISTRO|El registro ya se intento registrar pero marco nf_interfase_spei=2 (problemas de registro)");
                    return false;
                }
            }
            catch (Exception lexErrorSPEI_Registro)
            {
                Config.EscribirLog("ERROR|Comunes.SPEI_REGISTRO|Se presenta exception: " + lexErrorSPEI_Registro);
            }

            return false;
        }

        /// <summary>
        /// Ejecuta la operacion dameRFC_SPEI.
        /// </summary>
        public string dameRFC_SPEI(object texto)
        {
            string lsRFC;

            lsRFC = DameTexto(texto).Trim();

            if (lsRFC == string.Empty || lsRFC == "XEXX010101000")
                return "ND";

            if (EsRFC(lsRFC))
                return lsRFC;

            return "ND";
        }

        /// <summary>
        /// Ejecuta la operacion ValidateSpeiIsOpen.
        /// </summary>
        public async Task<bool> ValidateSpeiIsOpen()
        {
            string dateKarpay;

            dateKarpay = string.Empty;

            ISpeiComunSpeiDao speiDao = ObtenerSpeiDao();

            SpeiValorStringDto fechaOperacion = await speiDao.ObtenerFechaOperacionSpei();

            if (fechaOperacion != null)
                dateKarpay = fechaOperacion.Valor;

            return dateKarpay == _configuracion.FechaSistema;
        }

        /// <summary>
        /// Ejecuta la operacion ValidateSpeiHasFunds.
        /// </summary>
        public async Task<bool> ValidateSpeiHasFunds()
        {
            int numberOfTransfers;

            ISpeiComunSpeiDao speiDao = ObtenerSpeiDao();

            numberOfTransfers = await speiDao.ContarTraspasos();

            if (numberOfTransfers > 0)
                return true;

            decimal fundsAvailable;

            fundsAvailable = await speiDao.ObtenerSaldoInicialSpei();

            if (fundsAvailable > 500000)
                return true;

            return false;
        }

        /// <summary>
        /// Ejecuta la operacion CheckSpeiStatus.
        /// </summary>
        public async Task CheckSpeiStatus()
        {
            Config.EscribirLog("INFO|SPEI_Comun|Aperturando conexion a base de datos del SPEI.");

            //if (gsServidorSPEI_Principal == "SPEI_1")
            //    goSPEI_Database = goSPEI1_Database;
            //else
            //    goSPEI_Database = goSPEI2_Database;

            if (!await ValidateSpeiIsOpen())
                throw new Exception("El SPEI no ha sido aperturado, la fecha del SPEI es diferente a la fecha del Middleware");

            if (!await ValidateSpeiHasFunds())
                throw new Exception("El SPEI no ha sido fondeado; no es posible enviar operaciones.");

            Config.EscribirLog("INFO|SPEI_Comun|El SPEI se encuentra activo y fondeado.");
        }
    }
}

