using AplicacionConector.Utilidades;
using MUFG_T24.Comunes;
using System;
using System.Globalization;
using System.Net.Sockets;
using System.Text;
using System.Threading;

namespace Utilidades
{
    /// <summary>
    /// Declaración de variables.
    /// </summary>
    public class StateObject
    {
        public Socket WorkSocket { get; set; }
        public const int BufferSize = 1024;
        public byte[] Buffer { get; } = new byte[BufferSize];
        public StringBuilder ResponseBuilder { get; } = new StringBuilder();
        public int LargoEsperadoTotal { get; set; } = -1;
    }
    /// <summary>
    /// Clase principal para métodos asincronos.
    /// </summary>
    public class AsynchronousClient : IDisposable
    {
        private readonly ManualResetEvent _connectDone = new ManualResetEvent(false);
        private readonly ManualResetEvent _sendDone = new ManualResetEvent(false);
        private readonly ManualResetEvent _receiveDone = new ManualResetEvent(false);

        private readonly string _clienteOrigen;
        private readonly string _servidor;
        private readonly int _puerto;
        private readonly string _mensaje;

        private string _response = string.Empty;
        private Socket _client;
        private bool _disposed;
        private Exception _lastException;


        /// <summary>
        /// Constructor principal
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="servidor"></param>
        /// <param name="puerto"></param>
        /// <param name="mensaje"></param>
        public AsynchronousClient(string clienteOrigen, string servidor, int puerto, string mensaje)
        {
            _clienteOrigen = clienteOrigen;
            _servidor = servidor;
            _puerto = puerto;
            _mensaje = mensaje;           
        }

        #region Flujo principal

        /// <summary>
        /// Método para inicializar peticiones Asincronas.
        /// </summary>
        private void Inicializar()
        {

            try
            {
                Log($"[{_clienteOrigen}]|HSM|Inicio|Servidor=[ {_servidor}]|Puerto=[{_puerto}]");

                _client = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);

                _connectDone.Reset();
                _sendDone.Reset();
                _receiveDone.Reset();

                Log($"[{_clienteOrigen}]|HSM|Conetando|Inicio de conexión|Servidor=[ {_servidor}]|Puerto=[{_puerto}]");
                _client.BeginConnect(_servidor, _puerto, ConnectCallback, _client);

                if (!_connectDone.WaitOne(TimeSpan.FromSeconds(60)))
                {
                    LogError("Timeout durante la conexión al HSM.");
                    throw new TimeoutException("Timeout durante la conexión al HSM.");
                }
                if (_lastException != null)
                {
                    throw _lastException;
                }

                Send(_client, _mensaje);

                if (!_sendDone.WaitOne(TimeSpan.FromSeconds(60)))
                {
                    LogError("Timeout durante la conexión al HSM.");
                    throw new TimeoutException("Timeout durante el envío al HSM.");
                }
                if (_lastException != null)
                {
                    throw _lastException;
                }

                Receive(_client);
                if (!_receiveDone.WaitOne(TimeSpan.FromMinutes(1)))
                {
                    LogError("Timeout durante la conexión al HSM.");
                    throw new TimeoutException("Timeout durante larecepción del HSM.");
                }
                if (_lastException != null)
                {
                    throw _lastException;
                }
            }
            catch (SocketException ex)
            {
                LogError($"[{_clienteOrigen}] SocketException: {ex.Message}| SocketErrorCode: {ex.SocketErrorCode}| ErrorCode:{ex.ErrorCode}|StackTrace: {ex.StackTrace}");
            }
            catch (TimeoutException ex)
            {
                LogError($"[{_clienteOrigen}] Timeout: {ex.Message}|StackTrace: {ex.StackTrace}");
            }
            catch (Exception ex)
            {
                LogError($"[{_clienteOrigen}] Error inesperado: {ex}");
            }
            finally
            {
                try
                {
                    if (_client != null)
                    {
                        Shutdown();
                    }
                }
                catch (Exception ex)
                {
                    LogError($"Ocurrio un error al cerrar.|Error: {ex.Message}");
                }
            }
        }

        #endregion

        #region Callbacks
        /// <summary>
        /// Métod para realizar conexión 
        /// </summary>
        /// <param name="ar"></param>
        private void ConnectCallback(IAsyncResult ar)
        {
            try
            {
                var client = (Socket)ar.AsyncState;
                client.EndConnect(ar);

                Log($"[{_clienteOrigen}] Conectado correctamente");
                _connectDone.Set();
            }
            catch (Exception ex)
            {
                _lastException = ex;
                LogError($"ConnectCallback: {ex.Message}");
                _connectDone.Set();
            }
        }
        /// <summary>
        /// Método para enviar petición de Socket.
        /// /// </summary>
        /// <param name="client"></param>
        /// <param name="data"></param>
        private void Send(Socket client, string data)
        {
            byte[] byteData = Encoding.ASCII.GetBytes(data);
            client.BeginSend(byteData, 0, byteData.Length, SocketFlags.None, SendCallback, client);
        }
        /// <summary>
        /// Método para enviar petición de Socket.
        /// </summary>
        /// <param name="ar"></param>
        private void SendCallback(IAsyncResult ar)
        {
            try
            {
                var client = (Socket)ar.AsyncState;
                int bytesSent = client.EndSend(ar);

                Log($"[{_clienteOrigen}] Bytes enviados: {bytesSent}");
                _sendDone.Set();
            }
            catch (Exception ex)
            {
                _lastException = ex;
                LogError($"SendCallback: {ex.Message}");
                _sendDone.Set();
            }
        }
        /// <summary>
        /// Método para recibir petición de Socket.
        /// </summary>
        /// <param name="client"></param>
        private void Receive(Socket client)
        {
            var state = new StateObject { WorkSocket = client };

            client.BeginReceive(state.Buffer, 0, StateObject.BufferSize, SocketFlags.None, ReceiveCallback, state);
        }
        /// <summary>
        /// Recupera información solicitada por medio de Socket.
        /// </summary>
        /// <param name="ar"></param>
        private void ReceiveCallback(IAsyncResult ar)
        {
            try
            {
                var state = (StateObject)ar.AsyncState;
                var client = state.WorkSocket;

                int bytesRead = client.EndReceive(ar);
                Log($"Bytes recibidos: {bytesRead}");

                if (bytesRead > 0)
                {
                    string chunk = Encoding.ASCII.GetString(state.Buffer, 0, bytesRead);
                    Log($"Respuesta Chunk recibida: {chunk}");
                    state.ResponseBuilder.Append(chunk);

                    if (state.LargoEsperadoTotal < 0 && state.ResponseBuilder.Length >= 6)
                    {
                        string largoTexto = state.ResponseBuilder.ToString(0, 6);
                        if (int.TryParse(largoTexto, NumberStyles.Integer, CultureInfo.InvariantCulture, out int largoBody) && largoBody >= 0)
                        {
                            state.LargoEsperadoTotal = 6 + largoBody;
                        }
                    }

                    if (state.LargoEsperadoTotal > 0 && state.ResponseBuilder.Length >= state.LargoEsperadoTotal)
                    {
                        _response = state.ResponseBuilder.ToString(0, state.LargoEsperadoTotal);
                        _receiveDone.Set();
                        Log($"[{_clienteOrigen}] Respuesta recibida: {_response}");
                        return;
                    }

                    client.BeginReceive(state.Buffer, 0, StateObject.BufferSize, SocketFlags.None, ReceiveCallback, state);
                    return;
                }
                _response = state.ResponseBuilder.ToString();
                _receiveDone.Set();

                Log($"[{_clienteOrigen}] Respuesta recibida: {_response}");
            }
            catch (Exception ex)
            {
                _lastException = ex;
                LogError($"ReceiveCallback: {ex.Message}");
                _receiveDone.Set();
            }
        }

        #endregion

        #region Público
        /// <summary>
        /// Método para obtener respuesta.
        /// </summary>
        /// <returns></returns>
        public string Execute()
        {
            Inicializar();
            return _response;
        }

        #endregion

        #region Limpieza
        /// <summary>
        /// Método para apagar el cliente.
        /// </summary>
        private void Shutdown()
        {
            try
            {
                if (_client != null && _client.Connected)
                {
                    _client.Shutdown(SocketShutdown.Both);
                    _client.Close();
                }
            }
            catch (Exception ex)
            {
                LogError($"Error al cerrar socket: {ex.Message}");
            }
        }
        /// <summary>
        /// Método para liberar recursos.
        /// </summary>
        public void Dispose()
        {
            if (_disposed) return;

            Shutdown();

            _connectDone.Dispose();
            _sendDone.Dispose();
            _receiveDone.Dispose();

            _disposed = true;
            GC.SuppressFinalize(this);
        }
        /// <summary>
        /// Método para liberar recursos.
        /// </summary>
        ~AsynchronousClient()
        {
            Dispose();
        }

        #endregion

        #region Logging
        /// <summary>
        /// Lo para registro de Información.
        /// </summary>
        /// <param name="mensaje"></param>
        private static void Log(string mensaje)
        {
            LoggingConector.EscribirLog($"[INFO] {mensaje}");
        }
        /// <summary>
        /// Log para registro de errores.
        /// </summary>
        /// <param name="mensaje"></param>
        private static void LogError(string mensaje)
        {
            LoggingConector.EscribirLog($"[ERROR] {mensaje}");
        }
        #endregion
    }
}


using AplicacionConector.Enums;
