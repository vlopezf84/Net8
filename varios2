namespace InfraestructuraConector.SOAP
{
    /// <summary>
    /// Clase para implementar métodos Token.
    /// </summary>
    public class RSATokenService : IRSATokenService
    {
        private readonly IRSASoapClient _rsaClient;
        private readonly IRSAEncrypt _rsaEncript;
        /// <summary>
        /// Constructor Token
        /// </summary>
        /// <param name="rsaClient"></param>
        /// <param name="rsaEncript"></param>
        public RSATokenService(IRSASoapClient rsaClient, IRSAEncrypt rsaEncript)
        {
            _rsaClient = rsaClient;
            _rsaEncript = rsaEncript;
        }
        /// <summary>
        /// Método para obtener Información Token.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="tokenSn"></param>
        /// <returns></returns>
        public async Task<TokenUserInfo> ObtenerInformacionTokenAsync(string clienteOrigen, string tokenSn)
        {
            string lsEntrada = string.Empty;
            string lsRegreso = string.Empty;
            string lsTrnResCode = string.Empty;
            string lsTrnResMsg = string.Empty;
            string valorMSG = string.Empty;
            var tokenInfo = new TokenUserInfo();

            try
            {
                string tokenSnEncript = _rsaEncript.Encrypt(tokenSn);
                lsEntrada = GenerarXmlTokenAdmin(string.Empty, tokenSnEncript, string.Empty, string.Empty);
                lsRegreso = _rsaClient.TokenInfo(lsEntrada);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.obtener_info_tokenUser|Al buscar propiedades del token='{tokenSn}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso));
                if (!EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    tokenInfo.Estatus = lsTrnResCode == ConstantesServicio.TokenInexistenteCode ? EstatusRegreso.TokenInexistente : EstatusRegreso.ErrorGeneral;
                    return tokenInfo;
                }

                string[] datos = valorMSG.Split('/');

                tokenInfo.Estatus = EstatusRegreso.OK;
                tokenInfo.TokenSerialNumber = tokenSn;
                tokenInfo.Active = true;

                if (datos.Length > 0)
                    tokenInfo.Enabled = datos[0] == "1";

                if (datos.Length > 1)
                    tokenInfo.PinMode = datos[1] == "1";

                if (datos.Length > 2)
                    tokenInfo.NextTokenCode = datos[2] == "1";

                if (datos.Length > 3)
                    tokenInfo.UserId = datos[3];

                if (string.IsNullOrWhiteSpace(tokenInfo.UserId))
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.obtener_info_tokenUser|El token='{tokenSn}' no está asociado a ningún usuario.");
                    return tokenInfo;
                }

                string UsuarioIDEncript = _rsaEncript.Encrypt(tokenInfo.UserId);
                lsEntrada = GenerarXmlTokenAdmin(UsuarioIDEncript, string.Empty, string.Empty, string.Empty);
                lsRegreso = _rsaClient.GetUserInfo(lsEntrada);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.obtener_info_tokenUser|Al buscar propiedades del ususario='{tokenInfo.UserId}'. Se reciberespuesta WS={XMLToTexto(lsRegreso)}");

                lsTrnResCode = string.Empty;
                lsTrnResMsg = string.Empty;
                valorMSG = string.Empty;

                if (EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    datos = valorMSG.Split('/');
                    if (datos.Length > 0)
                        tokenInfo.UserName = datos[0];

                    if (datos.Length > 1)
                        tokenInfo.UserEnabled = datos[1] == "1";

                    if (datos.Length > 2)
                        tokenInfo.UserLocked = datos[2] == "1";
                }
                else {
                    LoggingConector.EscribirLog($"WARN|{clienteOrigen}|RSA.obtener_info_tokenUser|No fue posible obtener la información del usuario. Código={lsTrnResCode}");
                    tokenInfo.Estatus = EstatusRegreso.ErrorGeneral;
                }

                return tokenInfo;
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.obtener_info_tokenUser|{ex}");
                tokenInfo.Estatus = EstatusRegreso.ErrorGeneral;

                return tokenInfo;
            }
        }

        #region ValidacionXml
        /// <summary>
        /// Método para validar XML.
        /// </summary>
        /// <param name="textXML"></param>
        /// <param name="trnResCode"></param>
        /// <param name="trnResMsg"></param>
        /// <param name="valorMSG"></param>
        /// <returns></returns>
        private bool EsValidoAnalisXml(ref string textXML, ref string trnResCode, ref string trnResMsg, ref string valorMSG)
        {
            XmlElement loXMLElement;
            XmlElement loXMLSubElement;

            XmlDocument loXMLDoc;
            string error;

            if (!XmlHelper.TryParseXmlSeguro(textXML, out loXMLDoc, out error))
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                LoggingConector.EscribirLog($"ERROR|RSATokenService|XML inválido: {error}");
                return false;
            }

            loXMLElement = loXMLDoc["SERVICE_RESPONSE"];

            if (loXMLElement == null)
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            loXMLElement = loXMLElement["TRANSACTION_RESPONSE"];

            if (loXMLElement == null)
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            trnResCode = loXMLElement.Attributes?["trnResCode"]?.Value;
            trnResMsg = loXMLElement.Attributes?["trnResMsg"]?.Value;

            if (string.IsNullOrWhiteSpace(trnResCode) || string.IsNullOrWhiteSpace(trnResMsg))
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            if (trnResCode == "0" && trnResMsg == "Success")
            {
                loXMLElement = loXMLElement["TOKEN_ADMIN_RESPONSE"];

                if (loXMLElement == null)
                    return false;

                loXMLSubElement = loXMLElement["STATUS"];

                if (loXMLSubElement == null)
                    return false;

                if (loXMLSubElement.InnerText == "0")
                {
                    loXMLSubElement = loXMLElement["MSG"];

                    if (loXMLSubElement != null)
                    {
                        valorMSG = loXMLSubElement.InnerText;
                    }
                    return true;
                }
                return false;
            }
            return false;
        }
        /// <summary>
        /// Validación de XML a Texto.
        /// </summary>
        /// <param name="textoXML"></param>
        /// <returns></returns>
        private string XMLToTexto(string textoXML)
        {
            return Regex.Replace(
                textoXML
                .Replace("\r\n", "")
                .Replace("\r", "")
                .Replace("\n", "")
                .Replace("\t", ""),
                " {2,}",
                " ");
        }

        #endregion

        /// <summary>
        /// Método para estructura general de XML Token.
        /// </summary>
        /// <param name="usuarioId"></param>
        /// <param name="serialNumber"></param>
        /// <param name="firstToken"></param>
        /// <param name="secondToken"></param>
        /// <returns></returns>
        private string GenerarXmlTokenAdmin(string usuarioId, string serialNumber, string firstToken, string secondToken)
        {
            return $@"<SERVICE>
                    <TRANSACTION>
                    <TOKEN_ADMIN>
                    <CUST_USER_ID>{usuarioId}</CUST_USER_ID>
                    <SERIAL_NUMBER>{serialNumber}</SERIAL_NUMBER>
                    <FIRST_TOKEN>{firstToken}</FIRST_TOKEN>
                    <SECOND_TOKEN>{secondToken}</SECOND_TOKEN>
                    </TOKEN_ADMIN>
                    </TRANSACTION>
                    </SERVICE>";
        }

    }
}


using AplicacionConector.Enums;
using AplicacionConector.Interfaces;
using AplicacionConector.Utilidades;
using MUFG_T24.Comunes;
using System;
using System.Text.RegularExpressions;
using System.Threading.Tasks;
using System.Xml;

namespace InfraestructuraConector.SOAP
{
    /// <summary>
    /// Clase para implementar métodos admistrativos de RSA.
    /// </summary>
    public class RSAAdminService : IRSAAdminService
    {
        private readonly IRSASoapClient _rsaClient;
        private readonly IRSAAuthenticationService _authService;
        private readonly IRSATokenService _tokenService;
        private readonly IRSAEncrypt _rsaEncript;

        /// <summary>
        /// Constructor principal
        /// </summary>
        /// <param name="rsaClient"></param>
        /// <param name="authService"></param>
        /// <param name="tokenService"></param>
        /// <param name="rsaEncript"></param>
        public RSAAdminService(IRSASoapClient rsaClient, IRSAAuthenticationService authService, IRSATokenService tokenService, IRSAEncrypt rsaEncript)
        {
            _rsaClient = rsaClient;
            _authService = authService;
            _tokenService = tokenService;
            _rsaEncript = rsaEncript;
        }
        /// <summary>
        /// Método para obtener información de Token.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="tokenSn"></param>
        /// <returns></returns>
        public async Task<string> InformacionTokenAsync(string clienteOrigen, string tokenSn)
        {

            var token = await _tokenService.ObtenerInformacionTokenAsync(clienteOrigen, tokenSn);

            if (token == null)
                return "-1";

            if (token.Estatus != EstatusRegreso.OK)
                return ((int)token.Estatus).ToString();

            return string.Join("|",
                "0",
                $"Activo={(token.Active ? 1 : 0)}",
                $"Estado={(token.Enabled ? 1 : 0)}",
                $"PinMode={(token.PinMode ? 1 : 0)}",
                $"NextTokenCode={(token.NextTokenCode ? 1 : 0)}",
                $"UsuarioID={token.UserId}",
                $"UsuarioNombre={token.UserName}",
                $"UsuarioEnabled={(token.UserEnabled ? 1 : 0)}",
                $"UsuarioLocked={(token.UserLocked ? 1 : 0)}");
        }
        /// <summary>
        /// Método para habilitar Token 
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="operadorUsuario"></param>
        /// <param name="operadorTokenSn"></param>
        /// <param name="operadorTokenCode"></param>
        /// <param name="tokenSn"></param>
        /// <returns></returns>
        public async Task<EstatusRegreso> HabilitaTokenAsync(string clienteOrigen, string operadorUsuario, string operadorTokenSn, string operadorTokenCode, string tokenSn)
        {
            try
            {
                var auth = await _authService.AutenticarAsync(clienteOrigen, operadorUsuario, operadorTokenSn, operadorTokenCode);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.habilitaToken_WS|Por validar las credenciales del Operador.");
                if (auth != EstatusRegreso.OK)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.habilitaToken_WS|Falló la validación de las credenciales del Operador.");
                    return auth == EstatusRegreso.TokenRequiereSincronizar ? EstatusRegreso.TokenRequiereSincronizar : EstatusRegreso.CredencialesOperadorInvalidas;
                }
                string token = _rsaEncript.Encrypt(tokenSn);
                string lsEntrada = GenerarXmlTokenAdmin(string.Empty, token, string.Empty, string.Empty);

                string lsRegreso = _rsaClient.EnableToken(lsEntrada);
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.habilitaToken_WS|Al habilitar token='{tokenSn}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso ?? string.Empty));

                string lsTrnResCode = string.Empty;
                string lsTrnResMsg = string.Empty;
                string valorMSG = string.Empty;
                bool respuestaValida = EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG);

                if (!respuestaValida)
                {
                    if (lsTrnResCode == ConstantesServicio.TokenInexistenteCode)
                    {
                        LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.habilitaToken_WS|Token inexistente='{tokenSn}'");
                        return EstatusRegreso.TokenInexistente;
                    }
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.habilitaToken_WS|Error al habilitar token. Código='{lsTrnResCode}' Mensaje='{lsTrnResMsg}'.");
                    return EstatusRegreso.ErrorGeneral;
                }
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.habilitaToken_WS|Token='{tokenSn}' habilitado correctamente.");
                return EstatusRegreso.OK;

            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.habilitaToken_WS|{ex}");
                return EstatusRegreso.ErrorGeneral;
            }
        }

        #region AltaUsuarioTokenAsync
        /// <summary>
        /// Método para obtener alta de usuario Token.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="operadorUsuario"></param>
        /// <param name="operadorTokenSn"></param>
        /// <param name="operadorTokenCode"></param>
        /// <param name="usuarioId"></param>
        /// <param name="nombre"></param>
        /// <param name="apellido"></param>
        /// <param name="tokenSn"></param>
        /// <returns></returns>
        public async Task<EstatusRegreso> AltaUsuarioTokenAsync(string clienteOrigen, string operadorUsuario, string operadorTokenSn, string operadorTokenCode,
            string usuarioId, string nombre, string apellido, string tokenSn)
        {
            string lsEntrada = string.Empty;
            string lsRegreso = string.Empty;
            string lsTrnResCode = string.Empty;
            string lsTrnResMsg = string.Empty;
            string valorMSG = string.Empty;

            try
            {
                var auth = await _authService.AutenticarAsync(clienteOrigen, operadorUsuario, operadorTokenSn, operadorTokenCode);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Por validar las credenciales del Operador.");
                if (auth != EstatusRegreso.OK)
                {
                    LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Falló la validación de las credenciales del Operador.");
                    return auth == EstatusRegreso.TokenRequiereSincronizar ? EstatusRegreso.TokenRequiereSincronizar : EstatusRegreso.CredencialesOperadorInvalidas;
                }
                string UsuarioIdEncript = _rsaEncript.Encrypt(usuarioId.ToUpper());
                string tokenSnEncript = _rsaEncript.Encrypt(tokenSn);
                #region Crear Usuario
                lsEntrada = GenerarXmlTokenAdmin(UsuarioIdEncript, string.Empty, nombre, apellido);
                lsRegreso = _rsaClient.AddUser(lsEntrada);
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|A crear el usuario, id='{usuarioId}', nombre='{nombre}', apellido='{apellido}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso ?? string.Empty));

                if (!EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.altaUsuario_token|Error crear el usuario, Codigo='{lsTrnResCode}', Mensaje='{lsTrnResMsg}'");
                    return EstatusRegreso.ErrorGeneral;
                }
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Usuario creado correctamente.");

                #endregion

                #region Asociar Token
                lsTrnResCode = string.Empty;
                lsTrnResMsg = string.Empty;
                valorMSG = string.Empty;

                lsEntrada = GenerarXmlTokenAdmin(UsuarioIdEncript, tokenSnEncript, string.Empty, string.Empty);

                lsRegreso = _rsaClient.LinkTokenToUser(lsEntrada);
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|A asociar, id='{usuarioId}' al token='{tokenSn}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso ?? string.Empty));

                if (!EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    if (lsTrnResCode == ConstantesServicio.TokenInexistenteCode)
                    {
                        return EstatusRegreso.TokenInexistente;
                    }
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.altaUsuario_token|Error al asociar token. Codigo='{lsTrnResCode}', Mensaje='{lsTrnResMsg}'");
                    return EstatusRegreso.ErrorGeneral;
                }
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Token asociado correctamente.");
                #endregion

                #region Deshabilitar Token

                lsTrnResCode = string.Empty;
                lsTrnResMsg = string.Empty;
                valorMSG = string.Empty;

                lsEntrada = GenerarXmlTokenAdmin(string.Empty, tokenSnEncript, string.Empty, string.Empty);
                lsRegreso = _rsaClient.DisableToken(lsEntrada);
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|A deshabiliar el token='{tokenSn}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso ?? string.Empty));

                if (!EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    if (lsTrnResCode == ConstantesServicio.TokenInexistenteCode)
                    {
                        return EstatusRegreso.TokenInexistente;
                    }
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.altaUsuario_token|Error al deshabilitar token. Codigo='{lsTrnResCode}', Mensaje='{lsTrnResMsg}'");
                    return EstatusRegreso.ErrorGeneral;
                }
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Proceso exitoso.");
                #endregion

                return EstatusRegreso.OK;
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.altaUsuario_token|{ex}");
                return EstatusRegreso.ErrorGeneral;
            }
        }
        #endregion

        #region ReposicionTokenAsync
        /// <summary>
        /// Método para obtener reposición Token.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="operadorUsuario"></param>
        /// <param name="operadorTokenSn"></param>
        /// <param name="operadorTokenCode"></param>
        /// <param name="usuarioId"></param>
        /// <param name="tokenAnterior"></param>
        /// <param name="tokenNuevo"></param>
        /// <returns></returns>
        public async Task<EstatusRegreso> ReposicionTokenAsync(string clienteOrigen, string operadorUsuario, string operadorTokenSn, string operadorTokenCode,
            string usuarioId, string tokenAnterior, string tokenNuevo)
        {
            string lsEntrada = string.Empty;
            string lsRegreso = string.Empty;
            string lsTrnResCode = string.Empty;
            string lsTrnResMsg = string.Empty;
            string valorMSG = string.Empty;

            try
            {
                var auth = await _authService.AutenticarAsync(clienteOrigen, operadorUsuario, operadorTokenSn, operadorTokenCode);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.altaUsuario_token|Por validar las credenciales del Operador.");
                if (auth != EstatusRegreso.OK)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.altaUsuario_token|Falló la validación de las credenciales del Operador.");
                    return auth == EstatusRegreso.TokenRequiereSincronizar ? EstatusRegreso.TokenRequiereSincronizar : EstatusRegreso.CredencialesOperadorInvalidas;
                }

                string UsuarioIdEncript = _rsaEncript.Encrypt(usuarioId);
                string tokenAnteriorEncript = _rsaEncript.Encrypt(tokenAnterior);
                string tokenNuevoEncript = _rsaEncript.Encrypt(tokenNuevo);
                string operadorTokenSnEncript = _rsaEncript.Encrypt(operadorTokenSn);                

                #region Desasociar Token Anterior

                lsEntrada = GenerarXmlTokenAdmin(UsuarioIdEncript, tokenAnteriorEncript, string.Empty, string.Empty);

                lsRegreso = _rsaClient.UnAssignToken(lsEntrada);
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.reposicion_token|Al desasociar el usuario '{usuarioId}' del token='{tokenAnterior}'. Se recibe respuesta del WS=" + XMLToTexto(lsRegreso ?? string.Empty));

                if (!EsValidoAnalisXml(ref lsRegreso, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG))
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSA.reposicion_token|Error al desasociar token. Código='{lsTrnResCode}' Mensaje='{lsTrnResMsg}'.");
                    if (lsTrnResCode == ConstantesServicio.TokenInexistenteCode)
                        return EstatusRegreso.TokenInexistente;

                    return EstatusRegreso.ErrorGeneral;
                }
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.reposicion_token|Token anterior desasociado correctamente.");

                #endregion

                #region Deshabilitar Token Anterior

                lsTrnResCode = string.Empty;
                lsTrnResMsg = string.Empty;
                valorMSG = string.Empty;

                lsEntrada = GenerarXmlTokenAdmin(string.Empty, tokenAnteriorEncript, string.Empty, string.Empty);

                lsRegreso = _rsaClient.DisableToken(lsEntrada);
