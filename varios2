Code block (sql)
CREATE OR ALTER PROCEDURE dbo.usp_RegistrarRespuestaCalypso_Conector
  @external_ref VARCHAR(30), @estatus_calypso VARCHAR(30), @calypso_id VARCHAR(20), @msg_out NVARCHAR(MAX), @tipo VARCHAR(10), @msg_id VARCHAR(100)
AS BEGIN SET NOCOUNT ON; SET XACT_ABORT ON;
  IF NULLIF(@external_ref, '') IS NULL THROW 50010, 'Respuesta sin ExternalRef: enviar a cuarentena', 1;
  BEGIN TRY BEGIN TRAN;
    IF EXISTS (SELECT 1 FROM dbo.tbl_calypso_intercambio WITH (UPDLOCK, HOLDLOCK) WHERE msg_id_out = @msg_id) BEGIN COMMIT; RETURN; END   -- already processed
    UPDATE dbo.tbl_calypso_intercambio SET estatus='RECV', estatus_calypso=@estatus_calypso, date_out=GETDATE(), calypso_id=@calypso_id, msg_out=@msg_out, msg_id_out=@msg_id
