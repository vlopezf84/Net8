        /// <summary>
        /// Realiza la obtención de la configuración del servicio 
        /// y la inyección de dependencias.
        /// </summary>
        protected void Inicializacion(string[] args, CancellationToken ct)
        {
            ct.ThrowIfCancellationRequested();
            string proceso = (args != null && args.Length > 0 && !string.IsNullOrWhiteSpace(args[0]))
                ? args[0]
                : "Default";

            string NombreServicioConector = ObtenerNombreServicioConector(proceso);
            string TipoServicio = NombreServicioConector.Replace("Conector_", "");

            //Objeto que almacena la configuración necesaria para el funcionamiento del servicio...
            _configuracionBase = new Configuracion();

            //Inicializa la obtención de la configuración general y las rutas del log...
            {
                ConfiguracionEncriptadaHelper.Inicializar();
                ServicioConfiguracionSettings servicioMainConfiguracion = ConfiguracionEncriptadaHelper.ObtenerServicio(NombreServicioConector);
                _configuracionBase.NombreServicio = servicioMainConfiguracion.NombreServicio;
                _configuracionBase.RutaArchivoConfiguracion = $@"{EnumRutasGenerales.Path_Log_CMS}\{NombreServicioConector}\";
                _configuracionBase.PathLog = servicioMainConfiguracion.Log + servicioMainConfiguracion.NombreServicio;
                _configuracionBase.configuracion = servicioMainConfiguracion.configuracion;
                _configuracionBase.TamanoMaximoArchivoLogKB = servicioMainConfiguracion.TamanoMaximoArchivoLogKB.ToString();
                _configuracionBase.ForzaEjecucionServicios = servicioMainConfiguracion.ForzaEjecucionServicios;
                _configuracionBase.LimiteConcurrencia = servicioMainConfiguracion.LimiteConcurrencia;
                _configuracionBase.AceptaDiferenciaEnFechas = servicioMainConfiguracion.AceptaDiferenciaEnFechas;
                _configuracionBase.SwiftStandardReleaseSanitized = servicioMainConfiguracion.SwiftStandardReleaseSanitized;

                Logging.Init(_configuracionBase.PathLog, servicioMainConfiguracion.NombreServicio, servicioMainConfiguracion.TamanoMaximoArchivoLogKB);
                LoggingConector.EscribirLog($"{ConstantesServicio.INFO}|El servicio atendera solicitudes '{TipoServicio}'.");

            }

            //Realiza la configuracion del contenedor DI...
            _containerDI = new SimpleInjector.Container();
            _containerDI.Options.DefaultScopedLifestyle = new AsyncScopedLifestyle();
            _containerDI.Register<IAlertas>(() => new Alertas(BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null), Lifestyle.Singleton);
            _containerDI.Register<IControlServicio, ControlServicio>();
            _containerDI.Register<MUFG_T24.Interfaces_utilidades.IParametrizacion, MUFG_T24.Inicializacion_utilidades.Parametrizacion>();

            //Registra la configuracion...
            _containerDI.Register<Configuracion>(() => _configuracionBase.Clone(), Lifestyle.Scoped);
            //Registra los componentes del servicio...
            _containerDI.Register<IRequestProcessor, RequestProcessor>(Lifestyle.Scoped);

            _containerDI.Register<IHSMService, HSMService>(Lifestyle.Scoped);
            _containerDI.Register<Func<IHSMService>>(() => () => _containerDI.GetInstance<IHSMService>(), Lifestyle.Scoped);
            _containerDI.Register<IHsmClient, HsmTcpClient>(Lifestyle.Scoped);
            _containerDI.Register<IHsmConfig, HsmConfig>(Lifestyle.Singleton);

            _containerDI.Register<IRSASoapClient, RSASoapClient>(Lifestyle.Scoped);
            _containerDI.Register<IRSAAdminService, RSAAdminService>(Lifestyle.Scoped);

            _containerDI.Register<IRSATokenService, RSATokenService>(Lifestyle.Scoped);
            _containerDI.Register<IRSAAuthenticationService, RSAAuthenticationService>(Lifestyle.Scoped);
            _containerDI.Register<IRSASynchronizationService, RSASynchronizationService>(Lifestyle.Scoped);

            _containerDI.Register<IRSAEncrypt, RSAUtilEncrypt>(Lifestyle.Scoped);
            _containerDI.Register<IEncryptionService, TripleDesEncryptionService>(Lifestyle.Scoped);
            _containerDI.Register<IRSAService, RSAService>(Lifestyle.Scoped);
            _containerDI.Register<Func<IRSAService>>(() => () => _containerDI.GetInstance<IRSAService>(), Lifestyle.Scoped);

            _containerDI.Verify();
        }

        /// <summary>
        /// Realiza la obtención inicial de parámetros (una sola vez).
        /// PENDIENTE: Poner parametrizaciones
        /// </summary>
        private async Task ParametrizacionesAsync(CancellationToken ct)
        {
            try
            {
                ct.ThrowIfCancellationRequested();

                //Marca el servicio en uso...
                IParametrizacion _parametrizacion = _containerDI.GetInstance<IParametrizacion>();
                _configuracionBase = await _parametrizacion.ObtenerProcesoActualAsync(_configuracionBase);
                _configuracionBase.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema);

                int limiteConcurrencia = _configuracionBase.LimiteConcurrencia ?? 5;
                _limiteConcurrencia = new SemaphoreSlim(limiteConcurrencia, limiteConcurrencia);

                IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();
                await _controlServicio.MarcarPuertoEnUsoAsync(_configuracionBase.Pid.Value, _configuracionBase.NombreProceso, _configuracionBase.NombreDisplay, _configuracionBase.NombreServicio);

                _configuracionBase.PuertoTCP = await _parametrizacion.ObtenerPuertos(_configuracionBase.NombreServicio, _configuracionBase.Pid.Value);

                //Comienza el escuchador TCP...
                _listenerTask = TcpListenerStartAsync(int.Parse(_configuracionBase.PuertoTCP), ct);

                _ = _listenerTask.ContinueWith(t =>
                {
                    LoggingConector.EscribirLog($"ERROR|TcpListenerStartAsync|{t.Exception}");
                    ExitCode = 1;
                    Stop();
                },
                TaskContinuationOptions.OnlyOnFaulted);
            }
            catch (OperationCanceledException exc)
            {
                LoggingConector.EscribirLog($"{ConstantesServicio.MensajeParametrizaciones}|{exc}");
                throw;
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"{ConstantesServicio.MensajeParametrizaciones}|{ex}");
                throw;
            }
        }

        /// <summary>
        /// Establece el TCP listener.
        /// </summary>
        /// 
        private async Task TcpListenerStartAsync(int puerto, CancellationToken token)
        {
            _tcpListener = new TcpListener(IPAddress.Any, puerto);
            _tcpListener.Start();

            Log($"Listener TCP activo en {IPAddress.Any}:{puerto}");

            try
            {
                using (token.Register(() => { try { _tcpListener.Stop(); } catch { } }))
                {
                    while (!token.IsCancellationRequested)
                    {
                        TcpClient client = null;
                        try
                        {
                            client = await _tcpListener.AcceptTcpClientAsync().ConfigureAwait(false);
                        }
                        catch (SocketException ex) when (token.IsCancellationRequested)
                        {
                            Log($"ERROR|TcpListenerStartAsync|SocketException|{ex}");
                        }
                        catch (ObjectDisposedException) when (token.IsCancellationRequested) { break; }
                        catch (Exception ex)
                        {
                            Log($"ERROR|TcpListenerStartAsync|{ex}");
                            throw;
                        }

                        if (client == null)
                        {
                            continue;
                        }

                        var dispatcherTask = DispatcherAsync(client, token);
                        await dispatcherTask.ContinueWith(t =>
                        {
                            if (t.IsFaulted)
                            {
                                Log($"ERROR|DispatcherAsync|{t.Exception}");
                            }
                        }, TaskScheduler.Default);
                    }
                }
            }
            finally
            {
                Log($"INFO|Termina Solicitud.");
            }
        }

        /// <summary>
        /// Manejador que controla la concurrencia para determinr si puede procesar una petición o agregarla a la cola.
        /// </summary>
        private async Task DispatcherAsync(TcpClient cliente, CancellationToken token)
        {

            await _limiteConcurrencia.WaitAsync(token);
            try
            {
                await ProcesarClienteAsync(cliente, token);
            }
            finally
            {
                _limiteConcurrencia.Release();
            }
        }

        /// <summary>
        /// Interpreta la petición.
        /// </summary>
        private async Task ProcesarClienteAsync(TcpClient cliente, CancellationToken token)
        {
            using (cliente)
            using (var stream = cliente.GetStream())
            {
                var remoteIp = ((IPEndPoint)cliente.Client.RemoteEndPoint).Address;
                string clienteOrigen = remoteIp.ToString();

                string contextoConector = null;

                if (!ClientePermitido(clienteOrigen))
                {
                    Log($"INFO|{clienteOrigen}|ProcesarClienteAsync|La IP '{clienteOrigen}' no es valida para establecer conexión, será rechazada por la petición.");

                    cliente.Close();
                    return;
                }

                try
                {
                    string request = await LeerSolicitudTextoAsync(stream, token).ConfigureAwait(false);
                    contextoConector = CrearContextoConector(clienteOrigen, request);

                    using (LoggingConector.BeginContexto(contextoConector))
                    {
                        Log($"INFO|REQUEST|{clienteOrigen}|{request}");

                        string response;

                        using (AsyncScopedLifestyle.BeginScope(_containerDI))
                        {
                            var processor = _containerDI.GetInstance<IRequestProcessor>();

                            response = await processor.ProcesarPeticionAsync(clienteOrigen, request);

                        }

                        Log($"INFO|RESPONSE|{clienteOrigen}|{response}");

                        await EnviarRespuestaPlanoAsync(stream, response, token);
                    }
                }
                catch (Exception ex)
                {
                    using (LoggingConector.BeginContexto(contextoConector))
                    {
                        Log($"ERROR|ProcesarCliente|{clienteOrigen}|{ex}");
                    }

                    await EnviarRespuestaPlanoAsync(stream, "9", token);
                }
            }
        }

