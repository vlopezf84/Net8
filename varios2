        /// <summary>
        /// OnStart de contrato, usado para correr la Inicializacion y ParametrizacionesAsync.
        /// Sin bloquear OnStart (no puede ser async por contrato).
        /// </summary>
        protected override void OnStart(string[] args)
        {
            //Ejecuta la inicialización...
            _cts = new CancellationTokenSource();

            string[] effectiveArgs = (args != null && args.Length > 0) ? args : _startupArgs;

            Inicializacion(effectiveArgs, _cts.Token);
            _startupTask = ParametrizacionesAsync(_cts.Token);



            _startupTask.ContinueWith(t =>
            {
                if (t.IsFaulted)
                {
                    var ex = t.Exception;

                    Log($"ERROR|OnStart|{ex}");

                    this.ExitCode = 1;
                    this.Stop();
                    return;
                }
            }, TaskScheduler.Default);
        }

