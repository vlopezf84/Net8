namespace InfraestructuraConector.HSM
{
    /// <summary>
    /// Clase para conexión HSM Client
    /// </summary>
    public class HsmTcpClient : IHsmClient
    {
        private readonly IHsmConfig _config;
        private readonly Configuracion _configuracion;
        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="config"></param>
        public HsmTcpClient(IHsmConfig config, IParametrizacion parametrizacion, Configuracion configuracion)
        {
            _config = config;
            _configuracion = configuracion;
        }
        /// <summary>
        /// Método para enviar mensaje.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="mensaje"></param>
        /// <returns></returns>
        public string Enviar(string clienteOrigen, string mensaje)
        {
            
            try
            {
                string Host = ObtenerValor(ConstantesServicio.HSMSERVIDOR, x => x);
                int Puerto = Convert.ToInt16(ObtenerValor(ConstantesServicio.HSMPUERTO, y => y));
                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|Enviar|Iniciando envio de mensaje, servidor='{Host}', puerto={Puerto}, mensaje='{mensaje}'.");

                string respuesta = string.Empty;               

                using (var envio = new AsynchronousClient(clienteOrigen, Host, Puerto, mensaje))                
                {
                    respuesta = envio.Execute();
                }

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|Enviar|Mensaje enviado correctamente|Regreso='{respuesta}'.");

                return respuesta;
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog(
                    $"ERROR|{clienteOrigen}|Enviar|{ex}"
                );

                return string.Empty;
            }
        }

        /// <summary>
        /// Método para recuperar valor.
        /// </summary>
        /// <typeparam name="T"></typeparam>
        /// <param name="clave"></param>
        /// <param name="parser"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        T ObtenerValor<T>(string clave, Func<string, T> parser, T defaultValue = default)
        {
            if (_configuracion.ParametrosSistema.TryGetValue(clave, out var valor))
                return parser(valor);

            LoggingConector.EscribirLog($"INFO|ObtenerValor|Clave no encontrada en BD: {clave}");
            return defaultValue;
        }
    }
}


using AplicacionConector.Enums;
using AplicacionConector.Interfaces;
using AplicacionConector.Utilidades;
using MUFG_T24.Comunes;
using MUFG_T24.Configuracion_utilidades;
using MUFG_T24.Interfaces_utilidades;
using System;
using System.Threading.Tasks;

namespace AplicacionConector
{
    /// <summary>
    /// Método principal del servicio
    /// </summary>
    public class RequestProcessor : IRequestProcessor
    {
        private readonly Func<IRSAService> _rsaServiceFactory;
        private readonly Func<IHSMService> _hsmServiceFactory;
        private readonly IControlServicio _controlServicio;
        private readonly Configuracion _configuracion;
        private readonly IParametrizacion _parametrizacion;

        /// <summary>
        /// Constructor principal del servicio
        /// </summary>
        /// <param name="rsaServiceFactory"></param>
        /// <param name="hsmServiceFactory"></param>
        /// <param name="configuracion"></param>
        /// <param name="controlServicio"></param>
        /// <param name="parametrizacion"></param>
        public RequestProcessor(Func<IRSAService> rsaServiceFactory, Func<IHSMService> hsmServiceFactory, Configuracion configuracion, IControlServicio controlServicio,
            IParametrizacion parametrizacion)
        {
            _rsaServiceFactory = rsaServiceFactory;
            _hsmServiceFactory = hsmServiceFactory;
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _parametrizacion = parametrizacion;
        }
        /// <summary>
        /// Método principal para distiguir la opción 
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="solicitud"></param>
        /// <returns></returns>
        /// <exception cref="ArgumentNullException"></exception>
        /// <exception cref="ArgumentException"></exception>
        public async Task<string> ProcesarPeticionAsync(string clienteOrigen, string solicitud)
        {

            if (string.IsNullOrWhiteSpace(solicitud))
                throw new ArgumentNullException(nameof(solicitud));

            if (solicitud.Length < 4)
                throw new ArgumentException("Solicitud inválida.");

            string tipoSolicitud = solicitud.Substring(0, 3);
            string payload = solicitud.Substring(4);


            try
            {
                switch (tipoSolicitud)
                {
                    case ConstantesServicio.TIPO_SOLICITUD_RSA:
                        return await _rsaServiceFactory().ProcesarPeticionAsync(clienteOrigen,payload);

                    case ConstantesServicio.TIPO_SOLICITUD_HSM:
                        return await _hsmServiceFactory().ProcesarPeticionAsync(clienteOrigen,payload);

                    default:
                        throw new InvalidOperationException($"Tipo de solicitud no soportada: {tipoSolicitud}");
                }
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"Error|ProcesarPeticionAsync|mensaje: {ex}");
                throw;
            }
            finally
            {
                await TerminaContextoAsync();
            }
            
        }

        /// <summary>
        /// Método para marcar la terminación del servicio.
        /// </summary>
        /// <returns></returns>
        private async Task TerminaContextoAsync()
        {
            await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
        }

    }
}


using AplicacionConector.Enums;
using AplicacionConector.Interfaces;
using AplicacionConector.Utilidades;
using MUFG_T24.Comunes;
using MUFG_T24.Configuracion_utilidades;
using System;
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;

namespace AplicacionConector
{
    /// <summary>
    /// Clase principal para el servicio HSM.
    /// </summary>
    public class HSMService : IHSMService
    {
        private const string Prefijo = ConstantesServicio.Prefijo;
        private const string CodigoOk = ConstantesServicio.CodigoOk;

        private readonly Configuracion _configuracion;
        private readonly IHsmClient _hsmClient;
        private readonly IHsmConfig _hsmConfig;
        private IHsmConfig _hcConfig;

        public HSMService(Configuracion configuracion, IHsmClient hsmClient, IHsmConfig hsmConfig)
        {
            _configuracion = configuracion;
            _hsmClient = hsmClient;
            _hsmConfig = hsmConfig;
        }
        /// <summary>
        /// Método para procesar petición HSM.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="solicitud"></param>
        /// <returns></returns>
        public async Task<string> ProcesarPeticionAsync(string clienteOrigen, string solicitud)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(solicitud))
                    throw new Exception("Solicitud vacía.");

                var parametros = solicitud.Split('|').Select(p => p?.Trim()).ToArray();

                if (parametros.Length == 0)
                    throw new Exception("Formato inválido.");

                ValidarCantidadParametros(parametros, 1);
                switch (parametros[0].ToLower())
                {
                    case ConstantesServicio.VALIDA:

                        ValidarCantidadParametros(parametros, 3);
                        if (_hsmConfig.Eco)
                        {
                            LogInfo("Modo ECO habilitado.", clienteOrigen);
                            return ConstantesServicio.Cero;
                        }

                        return ValidaPase(clienteOrigen, parametros[1], parametros[2]);

                    case ConstantesServicio.GENERA:
                        ValidarCantidadParametros(parametros, 2);
                        return GeneraClave(clienteOrigen, parametros[1]);

                    default:
                        LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|HSM|Operacion no soportada:{parametros[0]}");
                        return ConstantesServicio.Nueve;
                }
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|HSM|ProcesarPeticion|{ex}");
                return ConstantesServicio.Nueve;
            }
        }

        #region Operaciones HSM
        /// <summary>
        /// Método para validar pase Validar Pase
        /// </summary>
        /// <param name="origen"></param>
        /// <param name="hash"></param>
        /// <param name="clave"></param>
        /// <returns></returns>
        private string ValidaPase(string origen, string hash, string clave)
        {
            if (string.IsNullOrEmpty(origen))
                throw new ArgumentNullException("Origen requerido.", nameof(origen));

            if (string.IsNullOrEmpty(hash))
                throw new ArgumentNullException("Hash requerido.", nameof(hash));

            if (string.IsNullOrEmpty(clave))
                throw new ArgumentNullException("Clave requerido.", nameof(clave));

            const string comando = ConstantesServicio.comando0905;

            string peticion = comando + GeneraLMK17() + ConstantesServicio.H + hash.Length.ToString().PadLeft(4, '0') +
                hash + ConstantesServicio.CeroUno + clave.Length.ToString().PadLeft(4, '0') + clave;


            LogInfo($"ValidaPase request:{peticion}", origen);

            string response = _hsmClient.Enviar(origen, ConstruirMensaje(peticion));

            if (string.IsNullOrEmpty(response))
                throw new ArgumentNullException("El HSM no devolvio una respuesta valida");

            string data = InterpretarRespuesta(response, comando);

            LoggingConector.EscribirLog($"data:{data}");

            return data == ConstantesServicio.Uno ? ConstantesServicio.Cero : ConstantesServicio.Uno;
        }

        private string GeneraClave(string origen, string hash)
        {
            LoggingConector.EscribirLog($"INFO|HSM|GeneraClave|origen:{origen}|hash: {hash}");
            if (string.IsNullOrEmpty(origen))
            {
                LoggingConector.EscribirLog($"ERROR|HSM|El origen es vacio o nulo.");
                throw new ArgumentNullException("El origen es requerido.", nameof(origen));
            }

            if (string.IsNullOrEmpty(hash))
            {
                LoggingConector.EscribirLog($"ERROR|HSM|Hash es vacio o nulo.");
                throw new ArgumentNullException("El Hash es requerido.", nameof(hash));
            }

            const string comando = ConstantesServicio.comando0904;

            string peticion = comando + GeneraLMK17() + ConstantesServicio.H + hash.Length.ToString().PadLeft(4, '0') + hash;
            LoggingConector.EscribirLog($"INFO|{origen}|HSM|GeneraClave|Enviando petición|Peticion=[{peticion}]");

            string response;
            try
            {
                response = _hsmClient.Enviar(origen, ConstruirMensaje(peticion));
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|Error al enviar petición al HSM|Error=[{ex.Message}]");
                return string.Empty;
            }
            
            LoggingConector.EscribirLog($"INFO|{origen}|HSM|GeneraClave|Respuesta recibida={response}");

            if (string.IsNullOrWhiteSpace(response))
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|Respuesta vacía del HSM|Comando=[{comando}]");
                return string.Empty;
            }

            string data = InterpretarRespuesta(response, comando);

            LoggingConector.EscribirLog($"INFO|{origen}|HSM|GeneraClave|Resultado InterpretarRespuesta|DataLength={(data == null ? 0 : data.Length)}");

            if (string.IsNullOrEmpty(data))
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|InterpretarRespuesta devolvio vacío|Response.Lenght=[{response.Length}]|Comando=[{comando}]");
                return string.Empty;
            }

            if (data.Length < 4)
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|Respuesta menor a 4 caracteres|Formato de respuesta inválido.|DataLength=[{data.Length}]");
                return string.Empty;
            }

            if (!int.TryParse(data.Substring(0, 4), out int largo))
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|Formato de respuesta inválido|Longitud de clave no numerica|Largo recibido=[{largo}]|DataLength=[{data.Length}]");
                return string.Empty;
            }

            string clave = data.Substring(4);

            if (largo != clave.Length)
            {
                LoggingConector.EscribirLog($"ERROR|{origen}|HSM|GeneraClave|Longitud inválida.");
                return string.Empty;
            }

            LogInfo($"Clave generada correctamente:{clave}", origen);
            return ConstantesServicio.Cero + clave;
        }

        #endregion

        #region Construcción Mensajes
        /// <summary>
        /// Método para genera clave LMK17
        /// </summary>
        /// <returns></returns>
        /// <exception cref="InvalidOperationException"></exception>
        private string GeneraLMK17()
        {
            if (_hcConfig == null)
            {
                _hcConfig = ObtenerConfiguracionHsm();
            }

            if (string.IsNullOrWhiteSpace(_hcConfig.LMK17))
                throw new InvalidOperationException("LMK17 no configurado.");

            if (string.IsNullOrWhiteSpace(_hcConfig.LMK17Check))
                throw new InvalidOperationException("LMK17Check no configurado.");

            return ConstantesServicio.D + _hcConfig.LMK17.Length.ToString().PadLeft(4, '0') + _hcConfig.LMK17 +
                ConstantesServicio.L17 + _hcConfig.LMK17Check.Length.ToString().PadLeft(2, '0') + _hcConfig.LMK17Check;
        }
        /// <summary>
        /// Método para armar mensaje completo de servicio HSM.
        /// </summary>
        /// <param name="body"></param>
        /// <returns></returns>
        private string ConstruirMensaje(string body)
        {
            string mensajeCompleto = Prefijo + body;
            LoggingConector.EscribirLog(mensajeCompleto.Length.ToString().PadLeft(6, '0') + mensajeCompleto);
            return mensajeCompleto.Length.ToString().PadLeft(6, '0') + mensajeCompleto;


        }

        /// <summary>
        /// Método para interpretar respuesta de servicio HSM.
        /// </summary>
        /// <param name="respuesta"></param>
        /// <param name="comando"></param>
        /// <returns></returns>
        private string InterpretarRespuesta(string respuesta, string comando)
        {
            if (string.IsNullOrWhiteSpace(respuesta))
                return string.Empty;

            LoggingConector.EscribirLog($"respuesta:[{respuesta}]|respuesta.Lenght={respuesta.Length}|comando:{comando}");

            int largo = ParseEnteroRequerido(respuesta.Substring(0, 6), "LargoRespuestaHSM");

            string body = respuesta.Substring(6);

            LoggingConector.EscribirLog($"largo declarado:[{largo.ToString()}]|body:[{body}]|body.Lenght=[{body.Length}]");

            if (largo != body.Length)
            {
                LoggingConector.EscribirLog($"ERROR|HSM|InterpretarRespuesta|Longitud inválida.|Esperado={largo}|Real={body.Length}");
                return string.Empty;
            }

            string encabezado = Prefijo + comando + CodigoOk;

            LoggingConector.EscribirLog($"Prefijo=[{Prefijo}]|Prefijo.Length=[{Prefijo.Length}]|comando=[{comando}]|comando.Lenght=[{comando.Length}]|CodigoOK=[{ConstantesServicio.CodigoOk}]|CodigoOK.Lenght=[{ConstantesServicio.CodigoOk.Length}]");
            bool coincide = body.StartsWith(encabezado);
            LoggingConector.EscribirLog($"Prefijo=[{Prefijo}]|body.Lenght=[{body.Length}]|encabezado=[{encabezado}]|encabezado.Lenght=[{encabezado.Length}]|StartsWith=[{coincide}]");

            if (!coincide)
            {
                LoggingConector.EscribirLog($"ERROR|HSM|InterpretarRespuesta|Código de respuesta inválido.");

                return string.Empty;
            }

            string resultado = body.Substring(encabezado.Length);

            LoggingConector.EscribirLog($"Resultado=[{resultado}]|resultado.Length=[{resultado.Length}]");
            return resultado;
        }

        #endregion

        #region Logging
        /// <summary>
        /// Método para imprimir Log Informativo de HSM.
        /// </summary>
        /// <param name="mensaje"></param>
        /// <param name="clienteOrigen"></param>
        private void LogInfo(string mensaje, string clienteOrigen)
        {
            LoggingConector.EscribirLog($"INFO|{clienteOrigen}|HSM|{mensaje}");
        }
        #endregion

        /// <summary>
        /// Método para obtener valor de parametros de configuracion de MQ.
        /// </summary>
        /// <typeparam name="T"></typeparam>
        /// <param name="clave"></param>
        /// <param name="parser"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        T ObtenerValor<T>(string clave, Func<string, T> parser, T defaultValue = default)
        {
            if (_configuracion.ParametrosSistema.TryGetValue(clave, out var valor))
                return parser(valor);

            LoggingConector.EscribirLog($"INFO|ObtenerValor|Clave no encontrada en BD: {clave}");
            return defaultValue;
        }

        /// <summary>
        /// Método para obtener configuracion HSM.
        /// </summary>
        /// <returns></returns>
        public HsmConfig ObtenerConfiguracionHsm()
        {
            return new HsmConfig
            {
                Host = ObtenerValor(ConstantesServicio.HSMSERVIDOR, x => x),
                Puerto = ParseEnteroRequerido(ObtenerValor(ConstantesServicio.HSMPUERTO, x => x), ConstantesServicio.HSMPUERTO),
                LMK17 = ObtenerValor(ConstantesServicio.HSMLMK17, x => x),
                LMK17Check = ObtenerValor(ConstantesServicio.HSMCSLMK17, x => x),
                Eco = ParseBooleanoRequerido(ObtenerValor(ConstantesServicio.RSA_ECO, x => x), ConstantesServicio.RSA_ECO)
            };
        }

        /// <summary>
        /// 
        /// </summary>
        /// <param name="valor"></param>
        /// <param name="nombreCampo"></param>
        /// <returns></returns>
        /// <exception cref="Exception"></exception>
        public static int ParseEnteroRequerido(string valor, string nombreCampo)
        {
            if (string.IsNullOrWhiteSpace(valor))
            {
                throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' porque viene vacío.");
            }

            if (int.TryParse(valor, NumberStyles.Integer, CultureInfo.InvariantCulture, out var result))
            {
                return result;
            }

            throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' con valor '" + valor + "' a Int32.");
        }

        /// <summary>
        /// Método pra validar cantidad de parametros
        /// </summary>
        /// <param name="parametros"></param>
        /// <param name="cantidadEsperada"></param>
        /// <exception cref="ArgumentException"></exception>
        private static void ValidarCantidadParametros(string[] parametros, int cantidadEsperada)
        {
            if (parametros.Length < cantidadEsperada)
            {
                throw new ArgumentException(
                    "Cantidad de parámetros inválida.");
            }
        }
        public static bool ParseBooleanoRequerido(string valor, string nombreCampo)
        {
            if (string.IsNullOrWhiteSpace(valor))
            {
                throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' porque viene vacío.");
            }

            if (bool.TryParse(valor, out var result))
            {
                return result;
            }

            if (int.TryParse(valor, NumberStyles.Integer, CultureInfo.InvariantCulture, out var result2) && (result2 == 0 || result2 == 1))
            {
                return result2 == 1;
            }

            throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' con valor '" + valor + "' a Boolean.");
        }
    }
}


