@external_ref VARCHAR(10), @estatus_calypso VARCHAR(10), @calypso_id VARCHAR(15), @msg_out VARCHAR(MAX), @tipo VARCHAR(10)
IF (SELECT COUNT(1) FROM dbo.tbl_calypso_intercambio WHERE external_ref=@external_ref AND estatus='SENT' AND tipo=@tipo) > 0
