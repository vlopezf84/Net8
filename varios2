        /// <summary>
        /// Crea un contexto único por petición del conector (logging especial del conector).
        /// </summary>
        private static string CrearContextoConector(string clienteOrigen, string solicitud)
        {
            int workerId = Interlocked.Increment(ref _workerSequence);
            int peticionId = Interlocked.Increment(ref _peticionSequence);
            string tipo = ObtenerTipoSolicitud(solicitud);
            string origen = string.IsNullOrWhiteSpace(clienteOrigen) ? "N/A" : clienteOrigen.Trim();

            return string.Format(
                CultureInfo.InvariantCulture,
                "[W:CNT-W{0:0000}][Peticion:CNT-P{1:0000}][Tipo:{2}][Cliente:{3}]",
                workerId,
                peticionId,
                tipo,
                origen);
        }
        /// <summary>
        /// Método para obtener tipo de Solicitud.
        /// </summary>
        /// <param name="solicitud"></param>
        /// <returns></returns>
        private static string ObtenerTipoSolicitud(string solicitud)
        {
            if (string.IsNullOrWhiteSpace(solicitud) || solicitud.Length < 3)
                return "N/A";

            string tipo = solicitud.Substring(0, 3).Trim().ToUpperInvariant();
            return tipo == ConstantesServicio.TIPO_SOLICITUD_RSA ||
                   tipo == ConstantesServicio.TIPO_SOLICITUD_HSM ||
                   tipo == ConstantesServicio.TIPO_SOLICITUD_SSO
                ? tipo
                : "N/A";
        }
        /// <summary>
        /// Método para enviar respuesta
        /// </summary>
        /// <param name="stream"></param>
        /// <param name="respuesta"></param>
        /// <param name="ct"></param>
        /// <returns></returns>
        private async Task EnviarRespuestaPlanoAsync(NetworkStream stream, string respuesta, CancellationToken ct)
        {
            try
            {
                byte[] data = Encoding.ASCII.GetBytes(respuesta);
                string length = data.Length.ToString().PadLeft(6, '0');

                byte[] lengthBytes = Encoding.ASCII.GetBytes(length);

                await stream.WriteAsync(lengthBytes, 0, lengthBytes.Length, ct).ConfigureAwait(false);
                await stream.WriteAsync(data, 0, data.Length, ct).ConfigureAwait(false);
                await stream.FlushAsync(ct).ConfigureAwait(false);
            }
            catch (Exception ex)
            {
                Log($"ERROR|EnviarRespuestaPlanoAsync|{ex}");
            }
        }

        /// <summary>
        /// Realiza ciertas operaciones antes de finalizar el servicio.
        /// </summary>
        private async Task TerminacionAsync(CancellationToken ct)
        {
            Log(ConstantesServicio.MensajeTerminacion);

            try
            {
                //Espera los tasks que se esten ejecutando...
                int max = _configuracionBase.LimiteConcurrencia ?? 5;
                for (int i = 0; i < max; i++)
                {
                    bool obtenido = await _limiteConcurrencia.WaitAsync(TimeSpan.FromSeconds(20), ct);

                    if (!obtenido)
                    {
                        Log("WAR|Timeout esperando peticiones activas.");
                        break;
                    }
                }

                using (AsyncScopedLifestyle.BeginScope(_containerDI))
                {
                    Configuracion _configuracion = _containerDI.GetInstance<Configuracion>();
                    IControlServicio _controlServicio = _containerDI.GetInstance<IControlServicio>();

                    await _controlServicio.MarcarPuertoEnUsoAsync(null, null, null, _configuracion.NombreServicio);
                    await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
                }

                LoggingConector.EscribirLog(ConstantesServicio.MensajeTerminacionExitosa);
            }
            catch (OperationCanceledException exc)
            {
                LoggingConector.EscribirLog($"{ConstantesServicio.MensajeOperationCanceledException}|{exc}");
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"{ConstantesServicio.MensajeException}|{ex}");
            }
        }




        /// <summary>
        /// Método para obtener el nombre del servicio conector
        /// </summary>
        /// <param name="proceso"></param>
        /// <returns></returns>
        /// <exception cref="ArgumentException"></exception>
        private static string ObtenerNombreServicioConector(string proceso)
        {
            if (string.IsNullOrWhiteSpace(proceso))
            {
                throw new ArgumentException(nameof(proceso));
            }

            switch (proceso.Trim().ToUpperInvariant())
            {
                case ConstantesServicio.PROCESO_HSM:
                    return ConstantesServicio.NOMBRE_SERVICIO_CONECTOR_HSM;
                case ConstantesServicio.PROCESO_RSA_ADMIN:
                    return ConstantesServicio.NOMBRE_SERVICIO_CONECTOR_RSA_ADMIN;
                case ConstantesServicio.PROCESO_RSA_AUTH:
                    return ConstantesServicio.NOMBRE_SERVICIO_CONECTOR_RSA_AUTH;
                case ConstantesServicio.PROCESO_RSA_SYNC:
                    return ConstantesServicio.NOMBRE_SERVICIO_CONECTOR_RSA_SYNC;

                default:
                    throw new ArgumentException($"Proceso no soportado: {proceso}", nameof(proceso));
            }
        }

        /// <summary>
        /// Método para validar cliente permitido
        /// </summary>
        /// <param name="direccionCliente"></param>
        /// <param name="clienteOrigen"></param>
        /// <returns></returns>
        private bool ClientePermitido(string direccionCliente)
        {
            string ListaDirecciones = ObtenerValor(ConstantesServicio.CONECTORCLIENTES, x => x);
            if (string.IsNullOrWhiteSpace(direccionCliente))
            {
                return false;
            }
            if (!IPAddress.TryParse(direccionCliente, out _))
            {
                return false;
            }
            return ($",{ListaDirecciones},").Contains($",{direccionCliente},");
        }

        /// <summary>
        /// Metodo para obtener valor de parametros de configuracion de MQ.
        /// </summary>
        /// <typeparam name="T"></typeparam>
        /// <param name="clave"></param>
        /// <param name="parser"></param>
        /// <param name="defaultValue"></param>
        /// <returns></returns>
        T ObtenerValor<T>(string clave, Func<string, T> parser, T defaultValue = default)
        {
            if (_configuracionBase.ParametrosSistema.TryGetValue(clave, out var valor))
                return parser(valor);

            LoggingConector.EscribirLog($"INFO|ObtenerValor|Clave no encontrada en BD: {clave}");
            return defaultValue;
        }

        protected async Task<byte[]> ReadExactAsync(NetworkStream stream, int length, CancellationToken ct)
        {
            try
            {
                byte[] buffer = new byte[length];
                int read;
                for (int offset = 0; offset < length; offset += read)
                {
                    read = await stream.ReadAsync(buffer, offset, length - offset, ct).ConfigureAwait(continueOnCapturedContext: false);
                    if (read == 0)
                    {
                        throw new IOException("Cliente cerró la conexión");
                    }
                }

                return buffer;
            }
            catch (Exception ex)
            {
                throw new IOException("Error durante la recepción de datos desde el socket.", ex);
            }

        }

        /// <summary>
        /// OnStop de contrato, usado para correr TerminacionAsync en async.
        /// Sin bloquear OnStop (no puede ser async por contrato).
        /// </summary>
        protected override void OnStop()
        {
            try
            {
                //Señaliza cancelación...
                _tcpListener?.Stop();
                _cts?.Cancel();

                if (_listenerTask != null)
                {
                    Task.WaitAny(_listenerTask, Task.Delay(5000));
                }

                //Ejecuta la terminacíón...
                CancellationToken token = _cts?.Token ?? CancellationToken.None;
                Task.WaitAny(TerminacionAsync(token), Task.Delay(TimeSpan.FromSeconds(25)));
            }
            catch (Exception ex)
            {
                Log($"ERROR|OnStop|{ex}");
            }
            finally
            {
                _limiteConcurrencia?.Dispose();
                _cts?.Dispose();
            }

        }

        public static int ParseEnteroRequerido(string valor, string nombreCampo)
        {
            if (string.IsNullOrWhiteSpace(valor))
            {
                throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' porque viene vacío.");
            }

            if (int.TryParse(valor, NumberStyles.Integer, CultureInfo.InvariantCulture, out var result))
            {
                return result;
            }

            throw new Exception("No fue posible convertir el campo '" + nombreCampo + "' con valor '" + valor + "' a Int32.");
        }

        private async Task<string> LeerSolicitudTextoAsync(NetworkStream stream, CancellationToken ct)
        {
            byte[] buffer = new byte[4096];

            using (var ms = new MemoryStream())
            {
                while (true)
                {
                    int read = await stream.ReadAsync(buffer, 0, buffer.Length, ct).ConfigureAwait(false);

                    if (read == 0)
                    {
                        if (ms.Length == 0)
                        {
                            throw new IOException("Cliente cerró la conexión");
                        }

                        break;
                    }

                    ms.Write(buffer, 0, read);

                    if (!stream.DataAvailable)
                    {
                        await Task.Delay(10, ct).ConfigureAwait(false);

                        if (!stream.DataAvailable)
                        {
                            break;
                        }
                    }
                }

                string solicitud = Encoding.ASCII.GetString(ms.ToArray());
                return solicitud.TrimEnd('\0', '\r', '\n');
            }
        }
