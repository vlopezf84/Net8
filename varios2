    /// <summary>
    /// Clase para sincronización de servicio RSA.
    /// </summary>
    public class RSASynchronizationService
        : IRSASynchronizationService
    {
        private readonly IRSASoapClient _rsaClient;
        private readonly IRSATokenService _tokenService;
        /// <summary>
        /// Constructor
        /// </summary>
        /// <param name="rsaClient"></param>
        /// <param name="tokenService"></param>
        public RSASynchronizationService(IRSASoapClient rsaClient,IRSATokenService tokenService)
        {
            _rsaClient = rsaClient;
            _tokenService = tokenService;
        }
        /// <summary>
        /// Método para sincronizar token RSA.
        /// </summary>
        /// <param name="clienteOrigen"></param>
        /// <param name="tokenSn"></param>
        /// <param name="tokenCode1"></param>
        /// <param name="tokenCode2"></param>
        /// <returns></returns>
        public async Task<EstatusRegreso> SincronizarAsync(string clienteOrigen,string tokenSn,string tokenCode1,string tokenCode2)
        {
            try
            {
                TokenUserInfo tokenInfo = await _tokenService.ObtenerInformacionTokenAsync(clienteOrigen, tokenSn);

                if (tokenInfo == null)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSASynchronizationService|El TokenUserInfo es nullo .");
                    return EstatusRegreso.ErrorGeneral;
                }

                if (tokenInfo.Estatus != EstatusRegreso.OK)
                    return tokenInfo.Estatus;

                if (string.IsNullOrWhiteSpace(tokenInfo.UserId))
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSASynchronizationService|El token[{tokenSn}] no está asociado a ningun usuario.");
                    return EstatusRegreso.ErrorGeneral;
                }

                if (!tokenInfo.Enabled)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSAAuthenticationService|Token deshabilitado.");
                    return EstatusRegreso.AccesoDenegado;
                }

                if (!tokenInfo.UserEnabled)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSAAuthenticationService|Usuario deshabilitado.");
                    return EstatusRegreso.AccesoDenegado;
                }

                if (tokenInfo.UserLocked)
                {
                    LoggingConector.EscribirLog($"ERROR|{clienteOrigen}|RSAAuthenticationService|Usuario bloqueado.");
                    return EstatusRegreso.AccesoDenegado;
                }

                if (tokenCode2 == "0") 
                    return EstatusRegreso.OK;                

                string xml = RSAXmlBuilder.BuildResync(tokenSn,tokenCode1,tokenCode2);

                string response = _rsaClient.Resync(xml);

                LoggingConector.EscribirLog($"INFO|{clienteOrigen}|RSA.RSASynchronizationService|Token='{tokenCode1}'. Se recibe respuesta del WS=" + XMLToTexto(response ?? string.Empty));

                string lsTrnResCode = string.Empty;
                string lsTrnResMsg = string.Empty;
                string valorMSG = string.Empty;

                return EsValidoAnalisXml(ref response, ref lsTrnResCode, ref lsTrnResMsg, ref valorMSG) ? EstatusRegreso.OK : EstatusRegreso.ErrorGeneral;
                
            }
            catch (TimeoutException ex)
            {
                LoggingConector.EscribirLog($"ERROR|TIMEOUT_ERROR|{clienteOrigen}|RSASynchronizationService|{ex}");

                return EstatusRegreso.ErrorGeneral;
            }
            catch (XmlException ex)
            {
                LoggingConector.EscribirLog($"ERROR|PROTOCOL_ERROR|{clienteOrigen}|RSASynchronizationService|{ex}");

                return EstatusRegreso.ErrorGeneral;
            }
            catch (SocketException ex)
            {
                LoggingConector.EscribirLog($"ERROR|DEPENDENCY_ERROR|{clienteOrigen}|RSASynchronizationService|{ex}");

                return EstatusRegreso.ErrorGeneral;
            }
            catch (Exception ex)
            {
                LoggingConector.EscribirLog($"ERROR|UNEXPECTED_ERROR|{clienteOrigen}|RSASynchronizationService|{ex}");

                return EstatusRegreso.ErrorGeneral;
            }
        }

        /// <summary>
        /// 
        /// </summary>
        /// <param name="textoXML"></param>
        /// <returns></returns>
        private string XMLToTexto(string textoXML)
        {
            return Regex.Replace(
                textoXML
                .Replace("\r\n", "")
                .Replace("\r", "")
                .Replace("\n", "")
                .Replace("\t", ""),
                " {2,}",
                " ");
        }

        /// <summary>
        /// Método para validación de formato XML.
        /// </summary>
        /// <param name="textXML"></param>
        /// <param name="trnResCode"></param>
        /// <param name="trnResMsg"></param>
        /// <param name="valorMSG"></param>
        /// <returns></returns>
        private bool EsValidoAnalisXml(ref string textXML, ref string trnResCode, ref string trnResMsg, ref string valorMSG)
        {
            XmlElement loXMLElement;
            XmlElement loXMLSubElement;

            XmlDocument loXMLDoc;
            string error;

            if (!XmlHelper.TryParseXmlSeguro(textXML, out loXMLDoc, out error))
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                LoggingConector.EscribirLog($"ERROR|RSASynchronizationService|XML inválido: {error}");
                return false;
            }

            loXMLElement = loXMLDoc["SERVICE_RESPONSE"];

            if (loXMLElement == null)
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            loXMLElement = loXMLElement["TRANSACTION_RESPONSE"];

            if (loXMLElement == null)
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            trnResCode = loXMLElement.Attributes?["trnResCode"]?.Value;
            trnResMsg = loXMLElement.Attributes?["trnResMsg"]?.Value;

            if (string.IsNullOrWhiteSpace(trnResCode) || string.IsNullOrWhiteSpace(trnResMsg))
            {
                trnResCode = "9";
                trnResMsg = "XML invalido";
                return false;
            }

            if (trnResCode == "0" && trnResMsg == "Success")
            {
                loXMLElement = loXMLElement["TOKEN_ADMIN_RESPONSE"];

                if (loXMLElement == null)
                    return false;

                loXMLSubElement = loXMLElement["STATUS"];

                if (loXMLSubElement == null)
                    return false;

                if (loXMLSubElement.InnerText == "0")
                {
                    loXMLSubElement = loXMLElement["MSG"];

                    if (loXMLSubElement != null)
                    {
                        valorMSG = loXMLSubElement.InnerText;
                    }
                    return true;
                }
                return false;
            }
            return false;
        }
    }
}

using AplicacionConector.DTOs;
