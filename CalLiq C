    public class OperacionesTomiDao : RepositorioMaestro, IOperacionesTomi
    {
        private readonly Configuracion _configuracion;
        private readonly IAppLogger _appLogger;

        public OperacionesTomiDao(Configuracion configuracion, IAppLogger appLogger) : base (BasedatosProveedor.SqlServer, NombreBasedatos.TOMI, null, null)
        {
            _configuracion = configuracion;
            _appLogger = appLogger;
        }

        /// <summary>
        /// Permite obtener un listado de solicitudes de liquidación para ser tratadas
        /// </summary>
        public async Task<IEnumerable<SolicitudLiquidacionDTO>> ObtenerSolicitudesLiquidacion()
        {
            try
            {
                var resultado = await EjecutarStoredProcedureQuery<SolicitudLiquidacionDTO>(ConstantesServicio.uspObtenerSolicitudesLiquidacion, cmd => { });
                return resultado.Data;
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Ocurrió un error al Obtener lista solicitudes liquidacion: {ex}");
                throw;
            }
        }

        /// <summary>
        /// Permite insertar un registro de una liquidacion
        /// </summary>
        public async Task<FolioLiquidacionDTO> InsertarLiquidacionAsync(LiquidacionDTO dto)
        {
            try
            {
                var result = await EjecutarStoredProcedureQuery<FolioLiquidacionDTO>(
                    ConstantesServicio.uspInsertarLiquidacionCompleto,
                    cmd =>
                    {
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@id_envio", dto.IdEnvio));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@tipo_liquidacion", dto.TipoLiquidacion));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@calypso_id", dto.CalypsoId));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@external_ref", dto.ExternalRef));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@family", dto.Family));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@message_id", dto.MessageId));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@sentido", dto.Sentido));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@moneda", dto.Moneda));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@monto", dto.Monto));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cuenta", dto.Cuenta));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@cdl", dto.Cdl));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@nom_cliente", dto.NombreCliente));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@mensaje", dto.Mensaje));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@xml", dto.Xml));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@fecha_sistema", _configuracion.FechaSistema));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@razon_rechazo", dto.RazonRechazo));
                        cmd.Parameters.Add(basedatosConexion.CrearParametro("@operacion_valida", dto.OperacionValida));
                    },
                    false
                );

                var row = result.Data.FirstOrDefault();

                return row;
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Error InsertarLiquidacion: {ex}");
                throw;
            }
        }

    }
