    /// <summary>
    /// Clase principal del servicio, contiene validaciones principales, y ejecuta las operciones propias del negocio del servicio
    /// </summary>
    public class OperacionServicio : Interfaces.IOperacionServicio
    {
        private readonly Configuracion _configuracion;
        private readonly IControlServicio _controlServicio;
        private readonly IParametrizacion _parametrizacion;
        private readonly IAppLogger _appLogger;
        private readonly IOperacionesTomi _operacionesTomi;
        private readonly IOperacionesT24 _operacionesT24;
        private readonly IValidadorEjecucion _validadorEjecucion;
         
        public OperacionServicio(Configuracion configuracion, IControlServicio controlServicio, IParametrizacion parametrizacion, IAppLogger appLogger, IOperacionesTomi operacionesTomi, 
            IOperacionesT24 operacionesT24, IValidadorEjecucion validadorEjecucion)
        {
            _configuracion = configuracion;
            _controlServicio = controlServicio;
            _parametrizacion = parametrizacion;
            _appLogger = appLogger;
            _operacionesTomi = operacionesTomi;
            _operacionesT24 = operacionesT24;
            _validadorEjecucion = validadorEjecucion;
        }

        /// <summary>
        /// Control del flujo principal del procesamiento...
        /// </summary>
        public async Task<bool> EjecutarProcedimientosAsync(CancellationToken ct)
        {
            try
            {
                await _controlServicio.ActualizaEJecucion(_configuracion.NombreServicio);

                await CargarConfiguracionAsync();

                var resultado = await DebeEjecutarOperacionesAsync();

                if (resultado.Ejecutar)
                    await RealizaOperaciones(ct);
                else
                {
                    _appLogger.Log(TipoLog.WARNING, $"Ejecución detenida: {resultado.Mensaje}");
                    return false;
                }

                return true;
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error en ejecución");
                return false;
            }
            finally
            {
                await _controlServicio.ActualizaTerminacion(_configuracion.NombreServicio);
            }
        }

        /// <summary>
        /// Se cargan las principales configuraciones del sistema.
        /// </summary>
        private async Task CargarConfiguracionAsync()
        {
            _configuracion.FechaSistema = await _parametrizacion.ObtenerFechaSistemaAsync();
            _configuracion.ParametrosSistema = await _parametrizacion.ObtenerParametrosSistemaAsync(ConstantesServicio.ParametrosSistema);
        }

        /// <summary>
        /// Se evalua si se ejecutan las operaciones.
        /// </summary>
        private async Task<ResultadoEjecucionModel> DebeEjecutarOperacionesAsync()
        {
            var parametros = _configuracion.ParametrosSistema;

            string horaInicio = parametros[ConstantesGenerales.HoraOPInicio];
            string horaFin = parametros[ConstantesGenerales.HoraOPCepFin];

            // validación general
            var validacion = await _validadorEjecucion.ValidarEjecucionAsync(
                _configuracion.NombreServicio,
                horaInicio,
                horaFin);

            if (!validacion.EsValido)
                return ResultadoEjecucionModel.Detener(validacion.Mensaje);

            return ResultadoEjecucionModel.EjecutarNormal();
        }

        /// <summary>
        /// Se obtienen las solicitudes de liquidacion a procesar 
        /// </summary>
        public async Task RealizaOperaciones(CancellationToken ct)
        {
            try
            {
                _appLogger.Log(TipoLog.INFO, "Registra_Solicitudes|Buscando solicitudes de liquidación.");

                var solicitudes = await _operacionesTomi.ObtenerSolicitudesLiquidacion();

                if (solicitudes == null || !solicitudes.Any())
                {
                    _appLogger.Log(TipoLog.INFO, "Registra_Solicitudes|No se encontraron solicitudes.");
                    return;
                }

                foreach (var solicitud in solicitudes)
                {
                    if (ct.IsCancellationRequested)
                        break;

                    await ProcesarSolicitudAsync(solicitud, ct);
                }
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, "Error al Realizar operaciones");
            }
        }

        /// <summary>
        /// Se procesan las liquidaciones, interpretación de mensaje, validación de operación y conversión a XML
        /// </summary>
        private async Task ProcesarSolicitudAsync(SolicitudLiquidacionDTO solicitud, CancellationToken ct)
         {
            var model = new LiquidacionModel
            {
                IdEnvio = solicitud.id_envio
            };

            var mensaje = solicitud.msg_out;

            string razonRechazo = string.Empty;

            try
            {
                _appLogger.Log(TipoLog.INFO, $"Procesando id_envio:{model.IdEnvio}");
                // 1. Interpretar
                var interpretaValido = InterpretaMensaje(model.IdEnvio, mensaje, model);

                if (!interpretaValido.EsValido)
                {
                    razonRechazo = interpretaValido.Razon;
                    await PersistirOperacionAsync(model, mensaje, "<row/>", razonRechazo);
                    return;
                }

                // 2. Validar
                var operacionValida = await ValidaOperacion(
                    model,
                    ct);

                model.OperacionValida = operacionValida.EsValido;
                razonRechazo = operacionValida.Razon;

                // 3. Generar XML
                var xml = VariablesProcessor.ConvertirXml(model);

                _appLogger.Log(TipoLog.INFO, $"registra_operaciones|OperacionValida='{model.OperacionValida}', razonRechazo='{razonRechazo}', xml='{xml?.Length}'.");

                // 4. Persistir
                await PersistirOperacionAsync(model, mensaje, xml, razonRechazo);
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"Error id_envio:{model.IdEnvio} | {ex}");

                await PersistirOperacionAsync(model, mensaje, "<row />", $"ERROR: {ex.Message}");
            }
        }

        /// <summary>
        /// Interpreta el mensaje recibido pendiente cadenas Regex.
        /// </summary>
        private ResultadoOperacionModel InterpretaMensaje(
            string idEnvio,
            string mensaje,
            LiquidacionModel liquidacionModel)
        {
            try
            {
                _appLogger.Log(TipoLog.INFO, "interpreta_mensaje|Buscando el tipo de mensaje de liquidación.");

                foreach (var kvp in ConstantesServicio.PatronesLiquidacion)
                {
                    var match = kvp.Value.Match(mensaje);

                    if (match.Success)
                    {
                        _appLogger.Log(TipoLog.INFO, $"Se encontró una liquidación: {liquidacionModel.TipoLiquidacion}");
                        liquidacionModel.TipoLiquidacion = kvp.Key;

                        foreach (var g in kvp.Value.GetGroupNames())
                        {
                            if (int.TryParse(g, out _))
                                continue;

                            var value = match.Groups[g].Value.Trim();

                            if (string.IsNullOrEmpty(value))
                                continue;

                            VariablesProcessor.MapearValor(liquidacionModel, g, value);
                        }

                        return ResultadoOperacionModel.Ok();
                    }
                }

                return ResultadoOperacionModel.Fallo("Mensaje no reconocido");
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"interpreta_mensaje|Error: {ex}");
                return ResultadoOperacionModel.Fallo(ex.ToString());
            }
        }

        /// <summary>
        /// Valida la operación, obtiene datos de cuenta y cliente para agregar al XML.
        /// </summary>
        private async Task<ResultadoOperacionModel> ValidaOperacion(
            LiquidacionModel liquidacionModel,
            CancellationToken ct)
        {
            try
            {
                ct.ThrowIfCancellationRequested();

                var tipoLiquidacion = liquidacionModel.TipoLiquidacion;
                var tipoLiquidacionEnum = tipoLiquidacion.ToEnum();

                if (string.IsNullOrEmpty(tipoLiquidacion))
                    return ResultadoOperacionModel.Fallo("No se pudo identificar el tipo de liquidación");

                string sentido;

                if (tipoLiquidacionEnum == TipoLiquidacion.MT103 || tipoLiquidacionEnum == TipoLiquidacion.MT202 || tipoLiquidacionEnum == TipoLiquidacion.MT300 
                    || tipoLiquidacionEnum == TipoLiquidacion.MT210)
                {
                    sentido = "S";
                }
                else
                {
                    switch (liquidacionModel.Sentido)
                    {
                        case ConstantesServicio.SentidoReceive: 
                            sentido = "E"; 
                            break;
                        case ConstantesServicio.SentidoPay:
                            sentido = "S"; 
                            break;
                        default: 
                            return ResultadoOperacionModel.Fallo("No se pudo identificar el sentido (receive|pay)");
                    }
                }

                liquidacionModel.SentidoMUFG = sentido;

                if (tipoLiquidacionEnum == TipoLiquidacion.MT300)
                {
                    liquidacionModel.OperacionValida = true;
                    return ResultadoOperacionModel.Ok();
                }

                if (string.IsNullOrEmpty(liquidacionModel.TradeId))
                    return ResultadoOperacionModel.Fallo("No se pudo identificar el trade_id");

                if (string.IsNullOrEmpty(liquidacionModel.Moneda))
                    return ResultadoOperacionModel.Fallo("No se pudo identificar la moneda");

                if (tipoLiquidacionEnum == TipoLiquidacion.T24)
                {
                    var cuenta = liquidacionModel.Cuenta;

                    var datosCuenta = await _operacionesT24.ObtenerCuenta(cuenta);

                    if (datosCuenta == null)
                        return ResultadoOperacionModel.Fallo("No existe la cuenta en T24");

                    if (datosCuenta.CURRENCY != liquidacionModel.Moneda)
                        return ResultadoOperacionModel.Fallo("Moneda distinta en T24");

                    if (datosCuenta.CUSTOMER != liquidacionModel.Cdl)
                        return ResultadoOperacionModel.Fallo("CDL no coincide");

                    var cliente = await _operacionesT24.ObtenerCliente(liquidacionModel.Cdl);

                    liquidacionModel.CuentaMUFG = cuenta;
                    liquidacionModel.CdlMUFG = liquidacionModel.Cdl;
                    liquidacionModel.NombreCliente = cliente?.COMPANY_NAME;

                    liquidacionModel.OperacionValida = true;

                    return ResultadoOperacionModel.Ok();
                }
                else
                {
                    var cliente2 = await _operacionesT24.ObtenerCliente(liquidacionModel.Cdl);

                    if (cliente2 == null) 
                        return ResultadoOperacionModel.Fallo("CDL no existe");

                    liquidacionModel.CdlMUFG = liquidacionModel.Cdl;
                    liquidacionModel.NombreCliente = cliente2?.COMPANY_NAME;

                    liquidacionModel.OperacionValida = true;

                    return ResultadoOperacionModel.Ok();
                }
            }
            catch (Exception ex)
            {
                _appLogger.Log(TipoLog.ERROR, $"valida_operacion|Error: {ex}");
                return ResultadoOperacionModel.Fallo(ex.ToString());
            }
        }

        /// <summary>
        /// Realiza la inserción de los registros a BD.
        /// </summary>
        private async Task PersistirOperacionAsync(
            LiquidacionModel liquidacionModel,
            string mensaje,
            string xml,
            string razonRechazo)
        {

            try
            {
                var dto = new LiquidacionDTO
                {
                    IdEnvio = long.TryParse(liquidacionModel.IdEnvio, out var id) ? id : 0,
                    TipoLiquidacion = liquidacionModel.TipoLiquidacion,
                    CalypsoId = liquidacionModel.TradeId,
                    ExternalRef = liquidacionModel.ExternalRef,
                    Family = liquidacionModel.Family,
                    MessageId = long.TryParse(liquidacionModel.MessageId, out var msgId) ? msgId : (long?)null,
                    Sentido = liquidacionModel.SentidoMUFG,
                    Moneda = liquidacionModel.Moneda,
                    Monto = liquidacionModel.Monto,
                    Cuenta = liquidacionModel.CuentaMUFG,
                    Cdl = liquidacionModel.CdlMUFG,
                    NombreCliente = liquidacionModel.NombreCliente,
                    Mensaje = mensaje,
                    Xml = xml,
                    RazonRechazo = razonRechazo,
                    OperacionValida = liquidacionModel.OperacionValida
                };

                var resultado = await _operacionesTomi.InsertarLiquidacionAsync(dto);
                if (resultado == null)
                {
                    await _appLogger.LogAsync(TipoLog.ERROR, "No fue posible persistir la liquidación.", generarAlerta: true);
                    return;
                }
            }
            catch (Exception ex)
            {
                await _appLogger.ManejarErrorAsync(ex, $"Error el insertar la liquidación: {ex}");
            }
        }

    }
}
