using Aplicacion_C_Liquidacion.Modelos;
using System.Xml;

namespace Aplicacion_C_Liquidacion.Helpers
{
    /// <summary>
    /// Clase auxiliar para manejo de XML
    /// </summary>
    public static class VariablesProcessor
    {
        public static void MapearValor(LiquidacionModel model, string key, string value)
        {
            switch (key)
            {
                case "trade_id": model.TradeId = value; break;
                case "external_ref": model.ExternalRef = value; break;
                case "family": model.Family = value; break;
                case "message_id": model.MessageId = value; break;
                case "moneda": model.Moneda = value; break;
                case "monto": model.Monto = value; break;
                case "cuenta": model.Cuenta = value; break;
                case "cdl": model.Cdl = value; break;
                case "sentido": model.Sentido = value; break;
                case "nombre_cliente": model.NombreCliente = value; break;
                case "tipo_liquidacion": model.TipoLiquidacion = value; break;
            }
        }

        public static string ConvertirXml(LiquidacionModel model)
        {
            if (model == null)
                return "<row />";

            var doc = new XmlDocument();

            // raíz
            var root = doc.CreateElement("row");

            // atributos legacy
            var attrId = doc.CreateAttribute("id");
            attrId.Value = model.IdEnvio;
            root.Attributes.Append(attrId);

            var attrSpace = doc.CreateAttribute("xml", "space", null);
            attrSpace.Value = "preserve";
            root.Attributes.Append(attrSpace);

            doc.AppendChild(root);

            // 🔥 mapping directo del modelo
            AgregarNodo(doc, root, "tipo_liquidacion", model.TipoLiquidacion);
            AgregarNodo(doc, root, "trade_id", model.TradeId);
            AgregarNodo(doc, root, "external_ref", model.ExternalRef);
            AgregarNodo(doc, root, "family", model.Family);
            AgregarNodo(doc, root, "message_id", model.MessageId);
            AgregarNodo(doc, root, "moneda", model.Moneda);
            AgregarNodo(doc, root, "monto", model.Monto);

            AgregarNodo(doc, root, "sentido_MUFG", model.SentidoMUFG);
            AgregarNodo(doc, root, "cuenta_MUFG", model.CuentaMUFG);
            AgregarNodo(doc, root, "cdl_MUFG", model.CdlMUFG);
            AgregarNodo(doc, root, "nombre_MUFG", model.NombreCliente);

            AgregarNodo(doc, root, "operacionValida", model.OperacionValida ? "1" : "0");

            return doc.DocumentElement?.OuterXml;
        }

        private static void AgregarNodo(XmlDocument doc, XmlElement parent, string key, object value)
        {
            if (value == null)
                return;

            var stringValue = value.ToString()?.Trim();

            if (string.IsNullOrEmpty(stringValue))
                return;

            var safeKey = LimpiarNombreXml(key);

            var element = doc.CreateElement(safeKey);

            var text = doc.CreateTextNode(
                stringValue.Replace("\r", "").Replace("\n", "")
            );

            element.AppendChild(text);
            parent.AppendChild(element);
        }

        private static string LimpiarNombreXml(string nombre)
        {
            if (string.IsNullOrWhiteSpace(nombre))
                return "campo";

            return nombre
                .Replace(" ", "_")
                .Replace(".", "_");
        }

    }
}

